<UserControl x:Class="Karobar.Desktop.Views.ToastOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">

    <ItemsControl ItemsSource="{Binding ActiveToasts}"
                  Width="360">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="ToastCard"
                        Opacity="{Binding Opacity}"
                        Background="#FFFFFF"
                        BorderBrush="{Binding CardBorderHex}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,0,0,10"
                        ClipToBounds="True"
                        RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A"
                                          BlurRadius="22"
                                          ShadowDepth="5"
                                          Opacity="0.16" />
                    </Border.Effect>
                    <Border.Triggers>
                        <!-- Smooth Slide-In from Right Side of Top Corner -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="95"
                                                     To="0"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3.5" />
                        </Grid.RowDefinitions>

                        <!-- Main Toast Body -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <!-- Left Semantic Color Accent Bar -->
                                <ColumnDefinition Width="5" />
                                <!-- Icon Badge -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Title + Message -->
                                <ColumnDefinition Width="*" />
                                <!-- Dismiss Button -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Semantic Color Strip -->
                            <Border Grid.Column="0"
                                    Background="{Binding AccentColorHex}"
                                    CornerRadius="14,0,0,0" />

                            <!-- Semantic Icon Badge -->
                            <Border Grid.Column="1"
                                    Width="34" Height="34"
                                    CornerRadius="10"
                                    Background="{Binding IconBadgeBgHex}"
                                    BorderBrush="{Binding IconBadgeBorderHex}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Margin="12,12,10,12">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{Binding IconFgHex}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Title + Message -->
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Margin="0,11,8,11">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{Binding TitleFgHex}" />
                                <TextBlock Text="{Binding Message}"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="#1E293B"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Close (X) Button -->
                            <Button Grid.Column="3"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Dismiss"
                                    Cursor="Hand"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Width="24" Height="24"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBtnBorder"
                                                Background="Transparent"
                                                CornerRadius="6">
                                            <TextBlock Text="✕"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#94A3B8"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBtnBorder" Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Bottom Countdown Progress Track -->
                        <Border Grid.Row="1"
                                Background="#F1F5F9">
                            <Border HorizontalAlignment="Left"
                                    Width="{Binding ProgressWidth}"
                                    Background="{Binding AccentColorHex}" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
