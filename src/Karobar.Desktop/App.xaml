<Application x:Class="Karobar.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="GlassCardBackgroundBrush" Color="#CC1E293B" />
            <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#3394A3B8" />
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#10B981" />
            <SolidColorBrush x:Key="WarningBadgeBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="DangerBadgeBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
