<Window x:Class="Karobar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karobar App"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid>
        <!-- ================================================================ -->
        <!-- 1. LOGIN PAGE                                                    -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVis}}"
              Background="#F8FAFC">
            <Border Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="36,32">
                <Border.Effect>
                    <DropShadowEffect Color="#1E293B" BlurRadius="24" ShadowDepth="4" Opacity="0.08" />
                </Border.Effect>

                <StackPanel>
                    <!-- Brand Header -->
                    <TextBlock Text="Karobar"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in with your username and password"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,24" />

                    <!-- Error Message Banner (shown on unsuccessful login) -->
                    <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                            Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,18">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Username Input -->
                    <TextBlock Text="Username"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameTextBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="12,10"
                             Background="#FFFFFF"
                             Foreground="#0F172A"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Margin="0,0,0,16" />

                    <!-- Password Input -->
                    <TextBlock Text="Password"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput"
                                 PasswordChanged="PasswordInput_OnPasswordChanged"
                                 FontSize="14"
                                 Padding="12,10"
                                 Background="#FFFFFF"
                                 Foreground="#0F172A"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Margin="0,0,0,24" />

                    <!-- Sign In Button -->
                    <Button Content="Sign In"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            Height="42"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#3B82F6"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- 2. DASHBOARD PAGE (Blank page with "Dashboard" written)          -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
              Background="#FFFFFF">
            <TextBlock Text="Dashboard"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
