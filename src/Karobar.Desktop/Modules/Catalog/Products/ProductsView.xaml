                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Set Category" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FormCategories}"
                                  SelectedItem="{Binding BulkEditCategory}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Set Brand" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FormBrands}"
                                  SelectedItem="{Binding BulkEditBrand}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Set Primary Supplier" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FormSuppliers}"
                                  SelectedItem="{Binding BulkEditSupplier}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding CloseBulkEditModalCommand}" Content="Cancel" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding ConfirmBulkEditCommand}" Content="Apply Bulk Changes" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 5: DELETE / BULK DELETE PASSWORD CONFIRMATION MODAL           -->
        <!-- =================================================================== -->
        <Grid Background="#7F0F172A" Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteTargetTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Products with on-hand stock, batch records, or invoice/return history cannot be deleted. Enter your password to confirm."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Confirm User Password *" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding DeletePasswordInput, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Text="{Binding DeleteErrorMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding BulkDeleteFailedItems}" MaxHeight="160" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock FontSize="11.5" Foreground="#991B1B" TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Reason, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding CloseDeleteModalCommand}" Content="Cancel" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding ConfirmDeleteWithPasswordCommand}" Content="Confirm Delete" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 6: 2-STEP CSV IMPORT MODAL                                    -->
        <!-- =================================================================== -->
        <Grid Background="#7F0F172A" Visibility="{Binding IsCsvImportModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="860" MaxHeight="740" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource CardBorder}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Import Products (CSV)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Required headers: product_code, name, pack_size (aliases supported; prices &amp; relations auto-resolved)" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryBtn}" Padding="8,4" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CloseCsvImportModalCommand}" />
                    </Grid>

                    <!-- File Picker & Options -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding CsvFileName}" IsReadOnly="True" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Command="{Binding BrowseCsvFileCommand}" Content="Choose CSV File..." Margin="8,0,0,0" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Command="{Binding DownloadCsvTemplateCommand}" Content="⬇ Download Template" Margin="8,0,0,0" />
                            </Grid>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Delimiter:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="140" Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding CsvDelimiterOptions}"
                                          SelectedItem="{Binding SelectedCsvDelimiter}"
                                          DisplayMemberPath="Label" Margin="0,0,18,0" />
                                <CheckBox IsChecked="{Binding CsvCreateMissingRefs}" Content="Create missing Category / Brand / Supplier automatically" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Validation Results Preview -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasCsvValidationResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#334155">
                                        <Run Text="Total Rows: " />
                                        <Run Text="{Binding CsvValidationResult.TotalRows, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#DCFCE7" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#15803D">
                                        <Run Text="Valid Rows: " />
                                        <Run Text="{Binding CsvValidationResult.ValidRows, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#FEE2E2" CornerRadius="8" Padding="10,4">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#B91C1C">
                                        <Run Text="Invalid Rows: " />
                                        <Run Text="{Binding CsvValidationResult.InvalidRows, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <StackPanel Visibility="{Binding HasCsvInvalidRows, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="Invalid Sample Rows:" FontSize="12.5" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding CsvInvalidSampleRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                                <TextBlock FontSize="11.5" Foreground="#991B1B" TextWrapping="Wrap">
                                                    <Run Text="Row #" />
                                                    <Run Text="{Binding RowNumber, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text=" (" />
                                                    <Run Text="{Binding ProductCode, Mode=OneWay}" />
                                                    <Run Text=" - " />
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="): " />
                                                    <Run Text="{Binding ErrorsSummary, Mode=OneWay}" FontWeight="Bold" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="Valid Sample Rows Preview:" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding CsvValidSampleRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <TextBlock FontSize="11.5" Foreground="#334155">
                                                <Run Text="Row #" />
                                                <Run Text="{Binding RowNumber, Mode=OneWay}" FontWeight="Bold" />
                                                <Run Text=" · Code: " />
                                                <Run Text="{Binding ProductCode, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" />
                                                <Run Text=" · Name: " />
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · Pack: " />
                                                <Run Text="{Binding PackSize, Mode=OneWay}" />
                                                <Run Text=" · Category: " />
                                                <Run Text="{Binding Category, Mode=OneWay}" />
                                                <Run Text=" · Brand: " />
                                                <Run Text="{Binding Brand, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding ResetCsvImportCommand}" Content="Start Over" HorizontalAlignment="Left"
                                Visibility="{Binding HasCsvValidationResult, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryBtn}" Command="{Binding CloseCsvImportModalCommand}" Content="Cancel" Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryBtn}" Command="{Binding ValidateCsvCommand}" IsEnabled="{Binding CanValidateCsv}" Content="1. Validate CSV" Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryBtn}" Command="{Binding CommitCsvValidOnlyCommand}" Content="2. Import Valid Rows"
                                    Visibility="{Binding HasCsvValidationResult, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
