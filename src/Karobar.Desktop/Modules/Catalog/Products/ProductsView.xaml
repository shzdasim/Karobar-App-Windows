<UserControl x:Class="Karobar.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1360" d:DesignHeight="900"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- =================================================================== -->
        <!-- 1. DIRECTORY VIEW MODE                                              -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Card -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="11" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Products" FontSize="19" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock FontSize="12" Foreground="#64748B">
                                <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" products in this view" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding OpenBulkEditModalCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✎ Bulk Edit" />
                                <Border Background="#DBEAFE" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedCount}" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerBtn}" Command="{Binding OpenBulkDeleteModalCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑 Bulk Delete" />
                                <Border Background="#FEE2E2" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedCount}" FontSize="10.5" FontWeight="Bold" Foreground="#B91C1C" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding OpenManageLocationsModalCommand}" Content="🏪 Locations" Margin="0,0,8,0" ToolTip="Manage Shop, Godown &amp; Fridge Storage Locations" />
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding OpenCsvImportModalCommand}" Content="⬆ Import CSV" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding ExportCsvCommand}" Content="⬇ Export CSV" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding OpenCreateProductCommand}" Content="+ Add Product" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Search & Filter Panel -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="16,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by product name, code, barcode, generic/salt formulation, rack, brand, or supplier">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}" Command="{Binding SearchCommand}" Content="Search" Margin="8,0,0,0" />

                        <Button Grid.Column="2" Command="{Binding ToggleLowStockCommand}" Margin="8,0,0,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LowBd" CornerRadius="9" Padding="12,6" BorderThickness="1" Background="White" BorderBrush="#CBD5E1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="LowDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" />
                                            <TextBlock x:Name="LowTxt" Text="Low stock only" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LowStockOnly}" Value="True">
                                            <Setter TargetName="LowBd" Property="Background" Value="#FEF3C7" />
                                            <Setter TargetName="LowBd" Property="BorderBrush" Value="#F59E0B" />
                                            <Setter TargetName="LowDot" Property="Fill" Value="#D97706" />
                                            <Setter TargetName="LowTxt" Property="Foreground" Value="#92400E" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource SecondaryBtn}" Command="{Binding ClearFiltersCommand}" Content="Reset Filters" Margin="8,0,0,0" />
                    </Grid>

                    <!-- 4-Column Relational Filter Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FilterCategoryOptions}"
                                  SelectedItem="{Binding SelectedFilterCategory}"
                                  DisplayMemberPath="Name" />

                        <ComboBox Grid.Column="2" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FilterBrandOptions}"
                                  SelectedItem="{Binding SelectedFilterBrand}"
                                  DisplayMemberPath="Name" />

                        <ComboBox Grid.Column="4" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FilterSupplierOptions}"
                                  SelectedItem="{Binding SelectedFilterSupplier}"
                                  DisplayMemberPath="Name" />

                        <ComboBox Grid.Column="6" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FilterLocationOptions}"
                                  SelectedItem="{Binding SelectedFilterLocation}"
                                  DisplayMemberPath="DisplayLabel" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Inventory Table Card -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Table Sub-Header -->
                    <Border Grid.Row="0" Padding="18,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC" CornerRadius="14,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Inventory" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0" />
                                <TextBlock FontSize="12" Foreground="#64748B" VerticalAlignment="Center">
                                    <Run Text="Showing " />
                                    <Run Text="{Binding FromItem, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E293B" />
                                    <Run Text="–" />
                                    <Run Text="{Binding ToItem, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E293B" />
                                    <Run Text=" of " />
                                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E293B" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#2563EB" />
                                    <Run Text=" selected" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Rows:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Width="72" Height="30" FontSize="12"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding SelectedPageSize}"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column Headers -->
                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="195" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding AllPageSelected}" Command="{Binding ToggleSelectAllPageCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="PRODUCT / FORMULATION / CODE" Style="{StaticResource TableHeaderLabel}" />
                            <TextBlock Grid.Column="2" Text="CATEGORY" Style="{StaticResource TableHeaderLabel}" />
                            <TextBlock Grid.Column="3" Text="BRAND" Style="{StaticResource TableHeaderLabel}" />
                            <TextBlock Grid.Column="4" Text="SUPPLIER" Style="{StaticResource TableHeaderLabel}" />
                            <TextBlock Grid.Column="5" Text="PACK / UNIT PRICING" Style="{StaticResource TableHeaderLabel}" />
                            <TextBlock Grid.Column="6" Text="STOCK" Style="{StaticResource TableHeaderLabel}" />
                            <TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Rows ScrollViewer -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProductRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="2.6*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="115" />
                                                <ColumnDefinition Width="195" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Product Identity -->
                                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36" Height="36" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Item.Initials}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Item.Name}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,6,0" />
                                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="5,1" Margin="0,0,4,0"
                                                                Visibility="{Binding Item.IsNarcotic, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Narcotic" FontSize="10" FontWeight="Bold" Foreground="#B91C1C" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="#EFF6FF" CornerRadius="5" Padding="6,1" Margin="0,0,5,2">
                                                            <TextBlock Text="{Binding Item.Formulation, TargetNullValue='No Formulation'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                        </Border>
                                                        <Border Background="#F1F5F9" CornerRadius="5" Padding="6,1" Margin="0,0,5,2">
                                                            <TextBlock FontSize="10.5" FontFamily="Consolas" Foreground="#475569">
                                                                <Run Text="{Binding Item.ProductCode, Mode=OneWay}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding Item.Barcode, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Background="#FEF3C7" CornerRadius="5" Padding="6,1" Margin="0,0,5,2">
                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#92400E">
                                                                <Run Text="{Binding Item.StorageLocationCode, Mode=OneWay}" />
                                                                <Run Text=" · Rack: " />
                                                                <Run Text="{Binding Item.Rack, TargetNullValue='—', Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Category -->
                                            <TextBlock Grid.Column="2" Text="{Binding Item.CategoryName}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                            <!-- Brand -->
                                            <TextBlock Grid.Column="3" Text="{Binding Item.BrandName}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                            <!-- Supplier -->
                                            <TextBlock Grid.Column="4" Text="{Binding Item.SupplierName}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                            <!-- Pricing -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0F172A">
                                                    <Run Text="MRP: Rs. " />
                                                    <Run Text="{Binding Item.UnitSalePrice, StringFormat=N2, Mode=OneWay}" />
                                                    <Run Text=" / unit" FontWeight="Normal" Foreground="#64748B" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#64748B" Margin="0,2,0,0">
                                                    <Run Text="Cost: " />
                                                    <Run Text="{Binding Item.UnitPurchasePrice, StringFormat=N2, Mode=OneWay}" />
                                                    <Run Text=" · Pack: " />
                                                    <Run Text="{Binding Item.PackSize, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Stock -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.HasStock}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#B45309" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Item.HasStock}" Value="True">
                                                                        <Setter Property="Foreground" Value="#15803D" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Item.Quantity, Mode=OneWay}" />
                                                        <Run Text=" units" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock FontSize="10.5" Foreground="#64748B" Margin="4,2,0,0">
                                                    <Run Text="{Binding Item.BatchesCount, Mode=OneWay}" />
                                                    <Run Text=" batch(es)" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SecondaryBtn}" Padding="8,5" Margin="0,0,5,0"
                                                        Command="{Binding DataContext.OpenSubstituteModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="View Generic / Salt Formulation Substitutes">
                                                    <TextBlock Text="⇄ Salt" FontSize="11" Foreground="#059669" FontWeight="Bold" />
                                                </Button>

                                                <Button Style="{StaticResource SecondaryBtn}" Padding="8,5" Margin="0,0,5,0"
                                                        Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Edit product, batches &amp; suppliers">
                                                    <TextBlock Text="✎ Edit" FontSize="11" Foreground="#2563EB" FontWeight="Bold" />
                                                </Button>

                                                <Button Style="{StaticResource SecondaryBtn}" Padding="8,5"
                                                        Command="{Binding DataContext.OpenDeleteSingleModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding Item.CanDelete}"
                                                        ToolTip="{Binding Item.DeleteTooltip}">
                                                    <TextBlock Text="🗑" FontSize="11" Foreground="#DC2626" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="3" Padding="18,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC" CornerRadius="0,0,14,14">
                        <Grid>
                            <TextBlock FontSize="12" Foreground="#64748B" VerticalAlignment="Center">
                                <Run Text="Page " />
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                                <Run Text=" of " />
                                <Run Text="{Binding LastPage, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrevPage}" Content="← Prev" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNextPage}" Content="Next →" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 2. CREATE / EDIT PRODUCT FORM VIEW MODE                             -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Form Top Header Bar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding BackToDirectoryCommand}" Content="← Back" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormHeadingTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding FormHeadingSubtitle}" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding SaveAndCloseProductCommand}" Content="Save &amp; Return" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding SaveProductCommand}" Content="{Binding SaveButtonLabel}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scrollable Form Sections -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- SECTION 1: CORE PRODUCT DETAILS & PRICING -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Row 1: Image + Code / Barcode / Location / Rack / Narcotic -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Product Image Box -->
                                <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Background="#F8FAFC" Padding="10">
                                    <StackPanel>
                                        <Border Height="82" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="No Image" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding FormImagePreviewPath}" Stretch="Uniform" Visibility="{Binding HasFormImage, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SecondaryBtn}" Padding="6,4" FontSize="11" Command="{Binding BrowseProductImageCommand}" Content="Browse" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Padding="6,4" FontSize="11" Margin="4,0,0,0" Command="{Binding ClearProductImageCommand}" Content="✕" Visibility="{Binding HasFormImage, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Code, Barcode, Location, Rack, Narcotic Grid -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Product Code *" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormProductCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F1F5F9" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Barcode *" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                                            <Button Content="Auto-generate" Command="{Binding AutoGenerateBarcodeCommand}" HorizontalAlignment="Right"
                                                    Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="11" FontWeight="Bold" Cursor="Hand" />
                                        </Grid>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Default Location" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                                            <Button Content="+ Locations" Command="{Binding OpenManageLocationsModalCommand}" HorizontalAlignment="Right"
                                                    Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="11" FontWeight="Bold" Cursor="Hand" />
                                        </Grid>
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  ItemsSource="{Binding FormStorageLocations}"
                                                  SelectedItem="{Binding FormSelectedLocation}"
                                                  DisplayMemberPath="DisplayLabel" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Rack / Shelf Code" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormRack, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. R-12 / Shelf 2" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Visibility="{Binding IsPharmacyShop, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Narcotic / Controlled Schedule" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  ItemsSource="{Binding NarcoticOptions}"
                                                  SelectedItem="{Binding FormSelectedNarcotic}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Row 2: Product Name, Formulation, Pack Size -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Product Name *" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding IsPharmacyShop, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Formulation (Generic / Salt)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              IsEditable="True"
                                              ItemsSource="{Binding FormFormulations}"
                                              Text="{Binding FormFormulation, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name"
                                              ToolTip="Select an existing formulation or type a new salt/formula name" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Pack Size (Units/Pack) *" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormPackSize, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Category, Brand, Supplier -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Category *" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              ItemsSource="{Binding FormCategories}"
                                              SelectedItem="{Binding FormSelectedCategory}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Brand *" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              ItemsSource="{Binding FormBrands}"
                                              SelectedItem="{Binding FormSelectedBrand}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Primary Supplier *" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              ItemsSource="{Binding FormSuppliers}"
                                              SelectedItem="{Binding FormSelectedSupplier}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Description -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Description / Optional Notes" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource InputTextBox}" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Row 5: Pricing, Margins & Expiry Thresholds Grid -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="PRICING, MARGINS &amp; EXPIRY THRESHOLDS" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" />
                                        <TextBlock Text="Default product-level rates and alert thresholds (individual batches can override Unit MRP and Unit Cost below)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="On-Hand Stock (Qty)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Pack Purchase Price" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormPackPurchasePrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="4">
                                            <TextBlock Text="Pack Sale Price" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormPackSalePrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="6">
                                            <TextBlock Text="Unit Purchase Cost" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormUnitPurchasePrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="8">
                                            <TextBlock Text="Unit Sale MRP" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormUnitSalePrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="10">
                                            <TextBlock Text="Retail Margin (%)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormMargin, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Wholesale Pack Price" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormWholeSalePackPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Wholesale Unit Price" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormWholeSaleUnitPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="4">
                                            <TextBlock Text="Wholesale Margin (%)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormWholeSaleMargin, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="6">
                                            <TextBlock Text="Average Unit Cost" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormAvgPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="8">
                                            <TextBlock Text="Max Discount (%)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormMaxDiscount, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="10">
                                            <TextBlock Text="Expiry Alert (Days)" Style="{StaticResource FieldLabel}" ToolTip="Custom Expiry Warning Days (leave blank for store default)" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FormExpiryWarningDays, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: BATCHES & EXPIRY MANAGEMENT (FEFO) (Visible in Edit Mode) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Batch Header & Stock Breakdown KPIs -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Batches &amp; Expiry Management (FEFO)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryBtn}" Padding="10,4" FontSize="11" Command="{Binding OpenManageLocationsModalCommand}" Content="🏪 Manage Locations" />
                                    </WrapPanel>
                                    <TextBlock Text="First-Expired, First-Out (FEFO) queue for POS and sales. Assign storage locations (Shop, Godown, Fridge) and move stock in 1 click." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />

                                    <ItemsControl ItemsSource="{Binding LocationBreakdownPills}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,4">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#3730A3">
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                        <Run Text=": " />
                                                        <Run Text="{Binding Quantity, Mode=OneWay}" FontWeight="Bold" />
                                                        <Run Text=" units" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3 Stock Pills -->
                                <Grid Grid.Column="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL STOCK" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding BatchTotalStock}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="BATCHED" FontSize="10" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding BatchAllocatedStock}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="UNASSIGNED" FontSize="10" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding BatchUnassignedStock}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Foreground="#047857" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Add / Edit Batch Form Box -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="290" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BatchFormHeading}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" />
                                            <TextBlock Text="{Binding BatchAllocationHint}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Quick Select Batch (Mode)" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Style="{StaticResource InputComboBox}"
                                                      ItemsSource="{Binding BatchPickerOptions}"
                                                      SelectedItem="{Binding SelectedBatchPickerOption}"
                                                      DisplayMemberPath="Label" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 7-Column Batch Input Grid -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Batch Number *" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchNumberInput, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Expiry Date *" Style="{StaticResource FieldLabel}" />
                                            <DatePicker Height="34" SelectedDate="{Binding BatchExpiryDateInput}" VerticalContentAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}">
                                                <Run Text="Qty (Max: " />
                                                <Run Text="{Binding MaxBatchAssignable, Mode=OneWay}" Foreground="#059669" />
                                                <Run Text=")" />
                                            </TextBlock>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchQuantityInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Storage Location" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Style="{StaticResource InputComboBox}"
                                                      ItemsSource="{Binding FormStorageLocations}"
                                                      SelectedItem="{Binding SelectedBatchLocation}"
                                                      DisplayMemberPath="DisplayLabel" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="Rack / Shelf" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchRackInput, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="10">
                                            <TextBlock Text="Batch Unit MRP" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchUnitSalePriceInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="12">
                                            <TextBlock Text="Batch Unit Cost" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchUnitPurchasePriceInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding CancelEditBatchCommand}" Content="Cancel Edit" Margin="0,0,8,0"
                                                Visibility="{Binding IsEditingBatch, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding SaveBatchCommand}" Content="{Binding BatchSaveButtonLabel}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Batch Filter Toolbar -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Search Batches" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchSearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by batch #, rack, or expiry" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Filter Location" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              ItemsSource="{Binding BatchFilterLocations}"
                                              SelectedItem="{Binding SelectedBatchFilterLocation}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Filter Status" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              ItemsSource="{Binding BatchStatusOptions}"
                                              SelectedItem="{Binding SelectedBatchStatusOption}"
                                              DisplayMemberPath="Label" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Sort Batches" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputComboBox}"
                                              ItemsSource="{Binding BatchSortOptions}"
                                              SelectedItem="{Binding SelectedBatchSortOption}"
                                              DisplayMemberPath="Label" />
                                </StackPanel>
                            </Grid>

                            <!-- Batch Table -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Border Background="#F1F5F9" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="195" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="BATCH #" Style="{StaticResource TableHeaderLabel}" />
                                            <TextBlock Grid.Column="1" Text="EXPIRY DATE" Style="{StaticResource TableHeaderLabel}" />
                                            <TextBlock Grid.Column="2" Text="LOCATION &amp; RACK" Style="{StaticResource TableHeaderLabel}" />
                                            <TextBlock Grid.Column="3" Text="UNIT COST" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="UNIT MRP" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="BATCH QTY" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="ACTIONS" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding FilteredBatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,9" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="White">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                            <ColumnDefinition Width="195" />
                                                        </Grid.ColumnDefinitions>

                                                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BatchNumber}" FontFamily="Consolas" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,6,0" />
                                                            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="5,1" Margin="0,0,4,0"
                                                                    Visibility="{Binding IsFefoRecommended, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="FEFO Pick" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                                            </Border>
                                                            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="5,1"
                                                                    Visibility="{Binding IsExpired, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Expired" FontSize="9.5" FontWeight="Bold" Foreground="#B91C1C" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding ExpiryDateFormatted}" FontFamily="Consolas" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />

