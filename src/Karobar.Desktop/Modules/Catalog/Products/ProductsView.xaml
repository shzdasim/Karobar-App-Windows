                                            <TextBlock Grid.Column="3" Text="LEAD TIME (DAYS)" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource TableHeaderLabel}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding ProductSupplierLinks}">
