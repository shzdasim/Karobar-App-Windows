<UserControl x:Class="Karobar.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="SuppliersView_OnPreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="SupBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SupPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource SupBtnStyle}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SupSuccessBtnStyle" TargetType="Button" BasedOn="{StaticResource SupBtnStyle}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="BorderBrush" Value="#059669" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SupDangerOutlineBtnStyle" TargetType="Button" BasedOn="{StaticResource SupBtnStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================================ -->
        <!-- 1. DIRECTORY MODE (Suppliers/Index.jsx)                          -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1A. Page Header Bar -->
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="11"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="🚚"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Suppliers &amp; Expiry Return Policies"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="{Binding DirectorySubtitleText}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenCreateModeCommand}"
                                Style="{StaticResource SupPrimaryBtnStyle}"
                                ToolTip="Add Supplier (Alt+N)"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋ Add Supplier" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="#1D4ED8"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Alt+N" FontSize="10" Foreground="#DBEAFE" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Visibility="{Binding CanImport, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenImportModalCommand}"
                                Style="{StaticResource SupBtnStyle}"
                                Content="↑ Import"
                                Margin="0,0,8,0" />

                        <Button Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ExportCsvCommand}"
                                IsEnabled="{Binding CanExportNow}"
                                Style="{StaticResource SupBtnStyle}"
                                Content="↓ Export"
                                Margin="0,0,8,0" />

                        <Button Command="{Binding LoadSuppliersCommand}"
                                Style="{StaticResource SupBtnStyle}"
                                Content="↻ Refresh" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1B. Search + Expiry Return Policy Filter + Page Size Bar -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SupplierSearchTextBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="#0F172A" />
                                <TextBlock Text="Search suppliers by name, phone or address…"
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SupplierSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Expiry Return Policy Filter -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding PolicyFilterOptions}"
                              SelectedItem="{Binding SelectedPolicyFilter}"
                              DisplayMemberPath="Label"
                              FontSize="12.5"
                              Padding="10,6"
                              VerticalContentAlignment="Center" />

                    <!-- Right: Page Size Selector -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Show"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                  SelectedItem="{Binding PageSize}"
                                  Width="72"
                                  FontSize="12.5"
                                  Padding="8,5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1C. Suppliers Table Card -->
            <Border Grid.Row="4"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="18,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SUPPLIER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />
                            <TextBlock Grid.Column="1"
                                       Text="CONTACT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />
                            <TextBlock Grid.Column="2"
                                       Text="EXPIRY RETURN POLICY"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />
                            <TextBlock Grid.Column="3"
                                       Text="INTIMATION STATUS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />
                            <TextBlock Grid.Column="4"
                                       Text="CREDIT SUMMARY"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />
                            <TextBlock Grid.Column="5"
                                       Visibility="{Binding HasRowActions, Converter={StaticResource BoolToVis}}"
                                       Text="ACTIONS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Rows ScrollViewer -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding PagedSuppliers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9"
                                                BorderThickness="0,0,0,1"
                                                Padding="18,12"
                                                Background="#FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Supplier Name + Address -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Visibility="{Binding HasAddress, Converter={StaticResource BoolToVis}}"
                                                               Text="{Binding Address}"
                                                               FontSize="11.5"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Col 1: Contact (Phone + Email) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding PhoneDisplay}"
                                                               FontSize="12.5"
                                                               Foreground="#334155" />
                                                    <TextBlock Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}"
                                                               Text="{Binding Email}"
                                                               FontSize="11.5"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Col 2: Expiry Return Policy Badge + Notes -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Border Background="{Binding PolicyBadgeBg}"
                                                            BorderBrush="{Binding PolicyBadgeBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="9,4"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding PolicyBadgeDisplay}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding PolicyBadgeFg}" />
                                                    </Border>
                                                    <TextBlock Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                                               Text="{Binding ExpiryReturnNotes}"
                                                               ToolTip="{Binding ExpiryReturnNotes}"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="220"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>

                                                <!-- Col 3: Intimation Status -->
                                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Button Visibility="{Binding HasIntimationsDue, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Click to view and edit supplier intimation batches"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#FFFBEB"
                                                                        BorderBrush="#FCD34D"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7"
                                                                        Padding="9,4">
                                                                    <TextBlock Text="{Binding IntimationDueText}"
                                                                               FontSize="11.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#B45309" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <TextBlock Visibility="{Binding NoIntimationsDue, Converter={StaticResource BoolToVis}}"
                                                               Text="✓ No return intimations due"
                                                               FontSize="12"
                                                               Foreground="#059669" />
                                                </Grid>

                                                <!-- Col 4: Credit Summary (Clickable) -->
                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.OpenCreditSummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Click to view full credit summary"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding PayableDisplay}"
                                                                           FontSize="12.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding PayableFg}" />
                                                                <TextBlock FontSize="11" Foreground="#64748B" Margin="0,2,0,0">
                                                                    <Run Text="{Binding CreditLimitDisplay, Mode=OneWay}" />
                                                                    <Run Text=" • " />
                                                                    <Run Text="{Binding CreditDaysDisplay, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Col 5: Actions -->
                                                <StackPanel Grid.Column="5"
                                                            Visibility="{Binding DataContext.HasRowActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.OpenCreditSummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SupBtnStyle}"
                                                            ToolTip="Credit Summary"
                                                            Padding="9,5"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="💵 Credit" FontSize="12" Foreground="#D97706" />
                                                    </Button>

                                                    <Button Visibility="{Binding DataContext.CanUpdate, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SupBtnStyle}"
                                                            Padding="10,5"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="✎ Edit" FontSize="12" />
                                                    </Button>

                                                    <Button Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanDelete}"
                                                            ToolTip="{Binding DeleteTooltip}"
                                                            Style="{StaticResource SupDangerOutlineBtnStyle}"
                                                            Padding="10,5">
                                                        <TextBlock Text="🗑 Delete" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <StackPanel Visibility="{Binding IsEmptyList, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,48">
                                <TextBlock Text="🚚"
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="No suppliers found."
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="18,10">
                        <Grid>
                            <TextBlock Text="{Binding PageStatusText}"
                                       FontSize="12.5"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding PrevPageCommand}"
                                        IsEnabled="{Binding CanGoPrevPage}"
                                        Style="{StaticResource SupBtnStyle}"
                                        Content="← Prev"
                                        Padding="12,5"
                                        Margin="0,0,8,0" />
                                <Button Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoNextPage}"
                                        Style="{StaticResource SupBtnStyle}"
                                        Content="Next →"
                                        Padding="12,5" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- 2. CREATE / EDIT SUPPLIER FORM MODE (SupplierForm.jsx)           -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 2A. Form Header Bar -->
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="11"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="🚚"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormPageTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="{Binding FormPageSubtitle}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackToDirectoryCommand}"
                                Style="{StaticResource SupBtnStyle}"
                                Content="← Back to Suppliers"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding SaveSupplierCommand}"
                                Style="{StaticResource SupPrimaryBtnStyle}"
                                ToolTip="Save Supplier (Alt+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " FontWeight="Bold" />
                                <TextBlock Text="{Binding SaveButtonText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2B. Scrollable Form Content -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22,20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Section 1: Supplier Profile, Tax & Credit Limits -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Supplier Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Supplier Name *"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="SupplierFormNameTextBox"
                                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                </StackPanel>

                                <!-- Phone Number -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phone Number"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Email (Optional)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Address -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Address"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                </StackPanel>

                                <!-- Tax Status -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tax Status"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding TaxStatusOptions}"
                                              SelectedItem="{Binding SelectedTaxStatus}"
                                              DisplayMemberPath="Label"
                                              FontSize="13"
                                              Padding="10,7" />
                                </StackPanel>

                                <!-- NTN / STRN / Tax ID -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="NTN / STRN / Tax ID"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormTaxNumber, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Credit Limit (Rs.) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Credit Limit (Rs.)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormCreditLimitText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                    <TextBlock Text="Leave blank or 0 for unlimited credit"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Credit Days -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Credit Days"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormCreditDaysText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                    <TextBlock Text="Default credit days for purchase invoices"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Opening Balance Payable (Create Mode Only) -->
                                <StackPanel Grid.Column="4"
                                            Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Opening Balance Payable (Rs.)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding FormOpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13.5"
                                             Padding="11,8"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1" />
                                    <TextBlock Text="If you owe this supplier prior to setup, enter the amount"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Section 2: Expiry Return Policy (Product Intimation) Card -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="9"
                                                Background="#DBEAFE"
                                                VerticalAlignment="Top"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="📅"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Expiry Return Policy (Product Intimation)"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A" />
                                            <TextBlock Text="Configure how many months or days before expiry products must be intimated/returned to this supplier."
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{Binding FormPolicyBadgeBg}"
                                                BorderBrush="{Binding FormPolicyBadgeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="99"
                                                Padding="12,5"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding FormPolicyBadgeDisplay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding FormPolicyBadgeFg}" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Return Intimation Period"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"
                                                       Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding PolicyPresets}"
                                                      SelectedItem="{Binding SelectedPolicyPreset}"
                                                      DisplayMemberPath="Label"
                                                      FontSize="13"
                                                      Padding="10,7" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Policy Notes / Special Terms (Optional)"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"
                                                       Margin="0,0,0,6" />
                                            <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13"
                                                     Padding="10,7"
                                                     BorderBrush="#CBD5E1"
                                                     BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom Period Row -->
                                    <Border Visibility="{Binding IsCustomPolicySelected, Converter={StaticResource BoolToVis}}"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="14,12"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Custom Time Unit"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"
                                                           Margin="0,0,0,5" />
                                                <ComboBox ItemsSource="{Binding CustomTimeUnitOptions}"
                                                          SelectedItem="{Binding SelectedCustomTimeUnit}"
                                                          DisplayMemberPath="Label"
                                                          FontSize="12.5"
                                                          Padding="9,6" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding CustomDurationFieldLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"
                                                           Margin="0,0,0,5" />
                                                <TextBox Text="{Binding CustomDurationText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13"
                                                         Padding="9,6"
                                                         BorderBrush="#CBD5E1"
                                                         BorderThickness="1" />
                                                <TextBlock Text="{Binding CustomDurationComputedHint}"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Live Policy Explanation Banner -->
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9">
                                        <TextBlock Text="{Binding FormPolicyExplanationText}"
                                                   FontSize="12"
                                                   Foreground="#475569"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Form Bottom Actions -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,18,0,0">
                                <Button Command="{Binding BackToDirectoryCommand}"
                                        Style="{StaticResource SupBtnStyle}"
                                        Content="← Back to Suppliers"
                                        Margin="0,0,10,0" />
                                <Button Command="{Binding SaveSupplierCommand}"
                                        Style="{StaticResource SupPrimaryBtnStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓ " FontWeight="Bold" />
                                        <TextBlock Text="{Binding SaveButtonText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2C. Live Product Expiry Return Intimation Status Table (Edit Mode Only) -->
                    <Border Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <StackPanel>
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1"
                                    Padding="18,12">
                                <StackPanel>
                                    <TextBlock Text="Product Expiry Return Intimation Status (Under This Supplier)"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#0F172A" />
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0">
                                        <Run Text="Active batches for products linked to " />
                                        <Run Text="{Binding EditingSupplierOriginalName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" evaluated against its " />
                                        <Run Text="{Binding FormPolicyFormattedLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2563EB" />
                                        <Run Text=" policy." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding HasEditingBatches, Converter={StaticResource BoolToVis}}"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1"
                                    Padding="18,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PRODUCT" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="BATCH #" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Grid.Column="2" Text="STOCK QTY" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="EXPIRY DATE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="14,0,0,0" />
                                    <TextBlock Grid.Column="4" Text="RETURN INTIMATION CUTOFF" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Grid.Column="5" Text="INTIMATION STATUS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                </Grid>
                            </Border>

                            <ItemsControl Visibility="{Binding HasEditingBatches, Converter={StaticResource BoolToVis}}"
                                          ItemsSource="{Binding EditingSupplierBatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9"
                                                BorderThickness="0,0,0,1"
                                                Padding="18,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding ProductMetaText}" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BatchNumber}"
                                                           FontFamily="Consolas"
                                                           FontSize="12.5"
                                                           Foreground="#334155"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Quantity}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding ExpiryDate}" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B" />
                                                    <TextBlock Text="{Binding ExpirySubText}" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReturnDeadlineDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                    <TextBlock Text="{Binding ReturnDeadlineSubText}" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>

                                                <Border Grid.Column="5"
                                                        Background="{Binding StatusBadgeBg}"
                                                        BorderBrush="{Binding StatusBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="9,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadgeText}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBadgeFg}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Visibility="{Binding HasNoEditingBatches, Converter={StaticResource BoolToVis}}"
                                       Text="No active batches with expiry dates found for products of this supplier."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,28" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================ -->
        <!-- 3. SUPPLIER CREDIT SUMMARY MODAL                                 -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsCreditModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#7F0F172A"
              Panel.ZIndex="100">
            <Border Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True">
                <StackPanel>
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💵" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Supplier Credit Summary"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Command="{Binding CloseCreditModalCommand}"
                                    Style="{StaticResource SupBtnStyle}"
                                    Content="✕"
                                    Padding="8,3"
                                    HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Padding="20,18">
                        <StackPanel>
                            <TextBlock Visibility="{Binding IsLoadingCreditSummary, Converter={StaticResource BoolToVis}}"
                                       Text="Loading credit summary..."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,24" />

                            <StackPanel Visibility="{Binding HasCreditSummary, Converter={StaticResource BoolToVis}}"
                                        DataContext="{Binding CreditSummary}">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,12" />

                                <!-- Credit Limit Exceeded Alert -->
                                <Border Visibility="{Binding IsLimitExceeded, Converter={StaticResource BoolToVis}}"
                                        Background="#FFF1F2"
                                        BorderBrush="#FECDD3"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="⚠ Credit Limit Exceeded"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#BE123C" />
                                        <TextBlock Text="Current payable balance exceeds the configured supplier credit limit."
                                                   FontSize="11.5"
                                                   Foreground="#E11D48"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT PAYABLE" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding CurrentBalanceDisplay}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="CREDIT LIMIT" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding CreditLimitDisplay}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="AVAILABLE CREDIT" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding AvailableCreditDisplay}" FontSize="17" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="CREDIT TERMS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding CreditTermsDisplay}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Overdue Payable Box -->
                                <Border Background="#FFFBEB"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="OVERDUE PAYABLE AMOUNT" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" />
                                            <TextBlock Text="{Binding TotalOverdueDisplay}" FontSize="16" FontWeight="Bold" Foreground="#92400E" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OverdueInvoicesLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#B45309" HorizontalAlignment="Right" />
                                            <TextBlock Visibility="{Binding HasOldestDueDate, Converter={StaticResource BoolToVis}}"
                                                       Text="{Binding OldestDueDateDisplay}"
                                                       FontSize="11"
                                                       Foreground="#92400E"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <Button Command="{Binding CloseCreditModalCommand}"
                                Style="{StaticResource SupBtnStyle}"
                                Content="Close"
                                HorizontalAlignment="Right" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- 4. SUPPLIER CSV IMPORT MODAL                                     -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsImportModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#7F0F172A"
              Panel.ZIndex="100">
            <Border Width="760"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <Grid>
                            <TextBlock Text="Import Suppliers (CSV)"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center" />
                            <Button Command="{Binding CloseImportModalCommand}"
                                    Style="{StaticResource SupBtnStyle}"
                                    Content="✕"
                                    Padding="8,3"
                                    HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="20,18">
                        <StackPanel>
                            <!-- Step 1: Select File & Validate -->
                            <StackPanel Visibility="{Binding IsImportStep1Visible, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14">
                                    <Run Text="Upload a CSV file with headers " />
                                    <Run Text="name,address,phone,opening_balance" FontFamily="Consolas" FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text=". We'll validate the file before importing any records." />
                                </TextBlock>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding ChooseImportCsvFileCommand}"
                                            Style="{StaticResource SupBtnStyle}"
                                            Content="Choose CSV File…" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ImportFileNameDisplay}"
                                               FontSize="12.5"
                                               Foreground="#334155"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0" />

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DelimiterOptions}"
                                              SelectedItem="{Binding SelectedDelimiter}"
                                              DisplayMemberPath="Label"
                                              FontSize="12.5"
                                              Padding="8,6"
                                              Margin="0,0,10,0" />

                                    <Button Grid.Column="3"
                                            Command="{Binding DownloadTemplateCommand}"
                                            Style="{StaticResource SupBtnStyle}"
                                            Content="↓ Download Template" />
                                </Grid>

                                <Button Command="{Binding ValidateImportCommand}"
                                        IsEnabled="{Binding CanValidateImport}"
                                        Style="{StaticResource SupPrimaryBtnStyle}"
                                        Content="Validate CSV"
                                        HorizontalAlignment="Right" />
                            </StackPanel>

                            <!-- Step 2: Validation Summary & Commit -->
                            <StackPanel Visibility="{Binding IsImportStep2Visible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Background="#F1F5F9" CornerRadius="7" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TotalBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                    </Border>
                                    <Border Background="#DCFCE7" CornerRadius="7" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ValidBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" />
                                    </Border>
                                    <Border Background="{Binding InvalidBadgeBg}" CornerRadius="7" Padding="10,4" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding InvalidBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding InvalidBadgeFg}" />
                                    </Border>
                                    <Button Command="{Binding ResetImportStepCommand}"
                                            Style="{StaticResource SupBtnStyle}"
                                            Content="← Choose another file"
                                            Padding="10,4" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasInvalidSamples, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="Invalid Rows (Sample)"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#DC2626"
                                               Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding InvalidSamples}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FEF2F2"
                                                        BorderBrush="#FECACA"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10,6"
                                                        Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Row, StringFormat='Row #{0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#991B1B" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ErrorsDisplay}" FontSize="11.5" Foreground="#DC2626" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasValidSamples, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Valid Rows Preview"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding ValidSamples}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10,6"
                                                        Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Row, StringFormat='Row #{0}'}" FontSize="11.5" Foreground="#64748B" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Phone}" FontSize="11.5" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding OpeningBalanceDisplay}" FontSize="11.5" Foreground="#059669" />
                                                        <TextBlock Grid.Column="4" Text="{Binding WarningsDisplay}" FontSize="11" Foreground="#D97706" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseImportModalCommand}"
                                    Style="{StaticResource SupBtnStyle}"
                                    Content="Cancel"
                                    Margin="0,0,8,0" />
                            <Button Visibility="{Binding IsImportStep2Visible, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding CommitImportValidOnlyCommand}"
                                    Style="{StaticResource SupSuccessBtnStyle}"
                                    Content="{Binding CommitPrimaryButtonText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
