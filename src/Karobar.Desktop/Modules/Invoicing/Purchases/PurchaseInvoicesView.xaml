<UserControl x:Class="Karobar.Desktop.Views.PurchaseInvoicesView"
             x:Name="PurchaseInvoicesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Karobar.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1480"
             Focusable="True"
             PreviewKeyDown="PurchaseInvoicesView_OnPreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Web App Button Styles -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="BorderBrush" Value="#6D28D9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row Action Icon Button (26x26 matching .products-row-action) -->
        <Style x:Key="RowIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Web App Editable Input (.purchase-entry input:not([readonly])) -->
        <Style x:Key="WebInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Web App Repeater Cell Editable Input -->
        <Style x:Key="GridCellInputStyle" TargetType="TextBox" BasedOn="{StaticResource WebInputStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
        </Style>

        <!-- Web App Read-Only Recessed Box (.purchase-readonly-field) -->
        <Style x:Key="ReadOnlyBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- Web App SubTotal Computed Badge (.purchase-subtotal-field) -->
        <Style x:Key="SubTotalBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <!-- Repeater Header Cell Styles (.purchase-th-editable / .purchase-th-readonly) -->
        <Style x:Key="ThEditableStyle" TargetType="Border">
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="2,3" />
        </Style>

        <Style x:Key="ThReadOnlyStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="2,3" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">

        <!-- =================================================================== -->
        <!-- MODE 1: DIRECTORY VIEW (Matching PurchaseInvoice/index.jsx 1:1)     -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}"
              Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hero Panel (.products-panel) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Top Heading Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="M9,2H15A2,2 0 0,1 17,4V6H19A2,2 0 0,1 21,8V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V8A2,2 0 0,1 5,6H7V4A2,2 0 0,1 9,2M9,4V6H15V4H9M7,10V12H17V10H7M7,14V16H14V14H7Z"
                                      Fill="#059669" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Purchase Invoices" FontSize="19" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{Binding DirectoryTotalSubtitleText}" FontSize="11.5" Foreground="#64748B" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Padding="12,7"
                                    Command="{Binding RefreshDirectoryCommand}" ToolTip="Refresh (F5)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="12.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Padding="12,7"
                                    Command="{Binding OpenHeldDraftsModalCommand}"
                                    ToolTip="View Held Invoices &amp; Drafts (Alt+H / Alt+D)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Held Drafts" VerticalAlignment="Center" />
                                    <Border Background="#FBBF24" CornerRadius="9" Padding="5,1" Margin="6,0,0,0"
                                            Visibility="{Binding HasHeldDrafts, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding HeldDraftsCount}" FontSize="10" FontWeight="Bold" Foreground="#0F172A" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryBtnStyle}" Padding="14,7"
                                    Command="{Binding GoToCreateFormCommand}"
                                    ToolTip="Create Purchase Invoice (Alt+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Add Invoice" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Integrated 2-Column Filter Grid (.purchase-invoice-filter-grid) -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <!-- Posted Number Search -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Posted number" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <Grid>
                                <TextBox x:Name="DirectorySearchTextBox"
                                         Style="{StaticResource WebInputStyle}"
                                         Height="32"
                                         Padding="28,4,8,4"
                                         BorderBrush="#CBD5E1"
                                         Text="{Binding DirectorySearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Search by Posted No or Bill No..." FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DirectorySearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Supplier Search -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Supplier" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <Grid>
                                <TextBox x:Name="DirectorySupplierSearchTextBox"
                                         Style="{StaticResource WebInputStyle}"
                                         Height="32"
                                         Padding="28,4,8,4"
                                         BorderBrush="#CBD5E1"
                                         Text="{Binding DirectorySupplierSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Search by Supplier..." FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DirectorySupplierSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Type Filter -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Invoice Type" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <local:SearchableSelect ItemsSource="{Binding DirectoryTypeOptions}"
                                                    SelectedItem="{Binding SelectedDirectoryTypeOption, Mode=TwoWay}"
                                                    DisplayMemberPath="Label"
                                                    Placeholder="All Types" />
                        </StackPanel>

                        <!-- Status Filter -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <local:SearchableSelect ItemsSource="{Binding DirectoryStatusOptions}"
                                                    SelectedItem="{Binding SelectedDirectoryStatusOption, Mode=TwoWay}"
                                                    DisplayMemberPath="Label"
                                                    Placeholder="All Statuses" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Table Panel (.purchase-invoice-catalog) -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Catalog Heading (.products-catalog-heading) -->
                    <Border Grid.Row="0" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#EDE9FE" Margin="0,0,10,0">
                                    <Path Data="M9,2H15A2,2 0 0,1 17,4V6H19A2,2 0 0,1 21,8V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V8A2,2 0 0,1 5,6H7V4A2,2 0 0,1 9,2M9,4V6H15V4H9Z"
                                          Fill="#7C3AED" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Invoice List" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155" />
                                    <TextBlock Text="{Binding DirectoryRangeSubtitleText}" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show" FontSize="11.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <local:SearchableSelect Width="72"
                                                            ItemsSource="{Binding PageSizeOptions}"
                                                            SelectedItem="{Binding SelectedPageSizeOption, Mode=TwoWay}"
                                                            DisplayMemberPath="Label"
                                                            Placeholder="10" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Full-Width Table Header -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2.0*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="168" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            <TextBlock Grid.Column="1" Text="TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            <TextBlock Grid.Column="2" Text="POSTED NO" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            <TextBlock Grid.Column="3" Text="INVOICE NO" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            <TextBlock Grid.Column="4" Text="SUPPLIER" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            <TextBlock Grid.Column="5" Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            <TextBlock Grid.Column="6" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#475569" TextAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Full-Width Rows List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding DirectoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,9" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="#FFFFFF">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="2.0*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="168" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding RowIndex}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" />

                                                <!-- Type + Reversed Badge -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#D1FAE5" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding InvoiceTypeBadge}" FontSize="11" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#065F46" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                            <Setter Property="Foreground" Value="#92400E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="#FFE4E6" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Left"
                                                            Visibility="{Binding IsReversed, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Reversed" FontSize="9.5" FontWeight="Bold" Foreground="#BE123C" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding PostedNumber}" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding InvoiceNumber}" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                                <Border Grid.Column="4" Background="#ECFDF5" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SupplierName}" FontSize="11.5" Foreground="#047857" TextTrimming="CharacterEllipsis" />
                                                </Border>

                                                <TextBlock Grid.Column="5" Text="{Binding FormattedDisplayDate}" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="6" Text="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}"
                                                           FontSize="12.5" FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 6 Action Icons matching PurchaseInvoice/index.jsx -->
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource RowIconBtnStyle}" ToolTip="View Invoice"
                                                            Command="{Binding DataContext.ViewInvoiceCommand, ElementName=PurchaseInvoicesRoot}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="👁" FontSize="12" Foreground="#334155" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtnStyle}" ToolTip="Print A4 Voucher" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.PrintInvoiceA4FromRowCommand, ElementName=PurchaseInvoicesRoot}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="🖨" FontSize="12" Foreground="#059669" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtnStyle}" ToolTip="Edit Invoice" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.EditInvoiceFromRowCommand, ElementName=PurchaseInvoicesRoot}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="✎" FontSize="12.5" FontWeight="Bold" Foreground="#334155" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtnStyle}" ToolTip="Audit History" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.OpenHistoryFromRowCommand, ElementName=PurchaseInvoicesRoot}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="🕒" FontSize="11.5" Foreground="#2563EB" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtnStyle}" ToolTip="Void / Reverse Invoice" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.OpenReverseFromRowCommand, ElementName=PurchaseInvoicesRoot}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="↩" FontSize="12.5" FontWeight="Bold" Foreground="#D97706" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtnStyle}" ToolTip="Delete Invoice" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.OpenDeleteFromRowCommand, ElementName=PurchaseInvoicesRoot}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="🗑" FontSize="12" Foreground="#DC2626" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <StackPanel Visibility="{Binding ShowEmptyDirectoryState, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                                <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" Opacity="0.45" />
                                <TextBlock Text="No invoices found" FontSize="13.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Compact Pagination (.products-pagination) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,9">
                        <Grid>
                            <TextBlock Text="{Binding PaginationSummaryText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,3" Margin="0,0,4,0"
                                        Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPrevPage}" Content="«" ToolTip="First page" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,3" Margin="0,0,6,0"
                                        Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrevPage}" Content="‹" ToolTip="Previous page" />
                                <Border Background="#2563EB" CornerRadius="5" Width="26" Height="26" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding CurrentPage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,3" Margin="0,0,4,0"
                                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" Content="›" ToolTip="Next page" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,3"
                                        Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextPage}" Content="»" ToolTip="Last page" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODE 2: CREATE / EDIT FORM (Matching PurchaseInvoiceForm.jsx 1:1)   -->
        <!-- Viewport-fitted 3-Row Grid:                                         -->
        <!--   Row 0 (Auto) = Compact Header Banner + Single-Row Fields + Sort   -->
        <!--   Row 1 (*)    = Full-Screen-Width Repeater (Zero Left/Right Scroll)-->
        <!--   Row 2 (Auto) = Ultra-Compact 2-Row Sticky Footer at Bottom        -->
        <!-- =================================================================== -->
        <Border Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}"
                Margin="8,6,8,6"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================= ROW 0: COMPACT HEADER SECTION ================= -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <!-- Validation Errors Banner -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="12,5"
                                Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- PO Receipt Banner (when linked to PO) -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="0,0,0,1" Padding="12,4"
                                Visibility="{Binding IsLinkedToPurchaseOrder, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Generated from PO " FontSize="11" Foreground="#065F46" />
                                    <TextBlock Text="{Binding LinkedPurchaseOrderNumber}" FontSize="11" FontWeight="Bold" Foreground="#047857" TextDecorations="Underline" />
                                    <TextBlock Text=". Review quantities, prices, batches and expiry before saving." FontSize="11" Foreground="#065F46" />
                                </StackPanel>
                                <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right" Padding="7,1" FontSize="10"
                                        Command="{Binding DetachPurchaseOrderCommand}" Content="Detach PO" />
                            </Grid>
                        </Border>

                        <!-- 1. Compact Branded Title Banner (.purchase-entry-banner) -->
                        <Border Padding="12,5" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#EFF6FF" Offset="0.0" />
                                    <GradientStop Color="#F5F3FF" Offset="0.55" />
                                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Icon + Title + Shortcut Subtitle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,3" Margin="0,0,8,0"
                                            Command="{Binding BackToDirectoryCommand}" ToolTip="Back to Purchase Invoices (Esc)">
                                        <TextBlock Text="←" FontSize="12" FontWeight="Bold" />
                                    </Button>
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0">
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13M8,13H16V15H8V13M8,17H13V19H8V17Z"
                                              Fill="#2563EB" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding FormHeaderTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Enter to navigate · Alt+S save · Alt+T toggle" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="10,1,0,0" />

                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="10,0,0,0"
                                            Visibility="{Binding HasActiveDraftBanner, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ActiveDraftNumber, StringFormat='Draft: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                    </Border>
                                </StackPanel>

                                <!-- Right: Draft Indicator + Debit/Credit Segmented Control + Add Product -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,3" Margin="0,0,5,0" FontSize="10.5"
                                            Command="{Binding HoldCurrentDraftCommand}" ToolTip="Hold Current Draft (Alt+H)"
                                            Content="Hold Draft" />
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,3" Margin="0,0,8,0" FontSize="10.5"
                                            Command="{Binding OpenHeldDraftsModalCommand}" ToolTip="Open Held Drafts (Alt+D)"
                                            Content="{Binding HeldDraftsBadgeText}" />

                                    <!-- Debit / Credit Segmented Control (.purchase-entry-type) -->
                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Cursor="Hand" Padding="9,2" BorderThickness="0"
                                                    Command="{Binding SetInvoiceTypeCommand}" CommandParameter="debit"
                                                    ToolTip="Debit — Pay Now (Alt+T)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="SegBd" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock x:Name="Chk" Text="✓ " FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" Visibility="Collapsed" />
                                                                <TextBlock x:Name="Lbl" Text="Debit" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsDebitInvoice}" Value="True">
                                                                <Setter TargetName="SegBd" Property="Background" Value="#2563EB" />
                                                                <Setter TargetName="Chk" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="Lbl" Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Cursor="Hand" Padding="9,2" BorderThickness="0" Margin="2,0,0,0"
                                                    Command="{Binding SetInvoiceTypeCommand}" CommandParameter="credit"
                                                    ToolTip="Credit — Pay Later / Supplier Ledger (Alt+T)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="SegBd" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock x:Name="Chk" Text="✓ " FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" Visibility="Collapsed" />
                                                                <TextBlock x:Name="Lbl" Text="Credit" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsCreditInvoice}" Value="True">
                                                                <Setter TargetName="SegBd" Property="Background" Value="#2563EB" />
                                                                <Setter TargetName="Chk" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="Lbl" Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- "+ Add Product" Button (.purchase-entry-add-product) -->
                                    <Button Style="{StaticResource SecondaryBtnStyle}" Padding="10,4" FontSize="11"
                                            Command="{Binding OpenQuickAddProductModalCommand}"
                                            ToolTip="Create a new product in the catalog">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⊕" FontSize="11.5" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Add Product" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. Compact Single-Row Fields Card (.purchase-entry-details) -->
                        <Border Padding="12,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="1.45*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="3.1*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="0.95*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="2.9*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: Posted # (Read-only) -->
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="POSTED #" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" />
                                            <TextBlock Text="auto" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="28">
                                            <TextBlock Text="{Binding PostedNumber}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Col 2: Date (dd-MM-yyyy) -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DATE" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                                        <DatePicker SelectedDate="{Binding PostedDate, Mode=TwoWay}"
                                                    Height="28" FontSize="11" VerticalContentAlignment="Center"
                                                    Loaded="AnyDatePicker_OnLoaded" />
                                    </StackPanel>

                                    <!-- Col 4: Supplier * (Exact Web App Trigger Button -> Opens SupplierSearch Modal!) -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="SUPPLIER *" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                                        <Button x:Name="SupplierTriggerButton"
                                                Height="28"
                                                Cursor="Hand"
                                                Command="{Binding OpenSupplierSearchModalCommand}"
                                                PreviewKeyDown="SupplierTriggerButton_OnPreviewKeyDown">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="SupBd" CornerRadius="6" Padding="8,0" BorderThickness="1"
                                                            Background="#FFFFFF" BorderBrush="#93C5FD">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Path Grid.Column="0"
                                                                  Data="M3,4H21V6H3V4M3,7H21L22,12V14H21V20H19V14H15V20H5V14H4V12L3,7M7,14V18H13V14H7Z"
                                                                  Fill="#3B82F6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock x:Name="SupTxt" Grid.Column="1"
                                                                       Text="{Binding SelectedSupplierButtonText}"
                                                                       FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="Search" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedSupplier}" Value="True">
                                                            <Setter TargetName="SupBd" Property="Background" Value="#EFF6FF" />
                                                            <Setter TargetName="SupBd" Property="BorderBrush" Value="#60A5FA" />
                                                            <Setter TargetName="SupTxt" Property="Foreground" Value="#1D4ED8" />
                                                            <Setter TargetName="SupTxt" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SupBd" Property="BorderBrush" Value="#2563EB" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="SupBd" Property="BorderBrush" Value="#2563EB" />
                                                            <Setter TargetName="SupBd" Property="BorderThickness" Value="1.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- Col 6: Invoice # -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="INVOICE #" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                                        <TextBox x:Name="InvoiceNumberTextBox"
                                                 Style="{StaticResource WebInputStyle}"
                                                 Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                 PreviewKeyDown="InvoiceNumberTextBox_OnPreviewKeyDown" />
                                    </StackPanel>

                                    <!-- Col 8: Bill Amt (Enter opens Add Product Modal for Row 0!) -->
                                    <StackPanel Grid.Column="8">
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="BILL AMT" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" />
                                            <Button Cursor="Hand" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Command="{Binding MatchBillAmountToTotalCommand}" ToolTip="Copy Total Amount into Bill Amt">
                                                <TextBlock Text="= Net" FontSize="8.5" FontWeight="Bold" Foreground="#2563EB" />
                                            </Button>
                                        </Grid>
                                        <TextBox x:Name="BillAmountTextBox"
                                                 Style="{StaticResource WebInputStyle}"
                                                 FontFamily="Consolas"
                                                 TextAlignment="Right"
                                                 Text="{Binding BillAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                 PreviewKeyDown="BillAmountTextBox_OnPreviewKeyDown" />
                                    </StackPanel>

                                    <!-- Col 10: Diff (Read-only, turns red when != 0) -->
                                    <StackPanel Grid.Column="10">
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="DIFF" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" />
                                            <TextBlock Text="auto" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="28">
                                            <TextBlock Text="{Binding FormattedBillDifference}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBillDiffWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Col 12: Remarks (Same single row as web app!) -->
                                    <StackPanel Grid.Column="12">
                                        <TextBlock Text="REMARKS" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource WebInputStyle}"
                                                 Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Remarks / delivery notes" />
                                    </StackPanel>
                                </Grid>

                                <!-- Conditional Supplier Credit Terms Strip (PurchaseInvoiceForm.jsx:1813-1862) -->
                                <Border Margin="0,5,0,0" Padding="10,3" CornerRadius="5" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        Visibility="{Binding ShowSupplierCreditBar, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Credit Terms: " FontSize="11" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ActiveSupplierCredit.CreditDays, StringFormat='{}{0} days'}" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock Text="Credit Limit: " FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ActiveSupplierCredit.CreditLimit, StringFormat='Rs. {0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock Text="Current Payable: " FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ActiveSupplierCredit.CurrentPayable, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock Text="Available Credit: " FontSize="11" Foreground="#047857" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AvailableSupplierCredit, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Background="#FFE4E6" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCreditLimitExceeded, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Credit Limit Exceeded" FontSize="10.5" FontWeight="Bold" Foreground="#BE123C" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCreditInvoice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="DUE DATE:" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                                        Height="24" Width="118" FontSize="10.5"
                                                        Loaded="AnyDatePicker_OnLoaded" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 3. Combined Compact Line Items & Arrangement Bar (PurchaseInvoiceForm.jsx:1867-1920) -->
                        <Border Padding="12,4" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="LINE ITEMS" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
