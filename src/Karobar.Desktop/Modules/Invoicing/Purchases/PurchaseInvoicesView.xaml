                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="nw" HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="31"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="sw" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="31"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="se" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="31"
                                ToolTip="Drag to resize window"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture">
                            <Path Data="M10,14 L14,10 M6,14 L14,6" Stroke="#94A3B8" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" IsHitTestVisible="False" />
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 3: QUICK "+ ADD PRODUCT" MODAL (Exact ProductFormModal.jsx    -->
        <!--          with Dragging, 8-Way Resizing & Saved User Placement/Size) -->
        <!-- =================================================================== -->
        <Grid x:Name="QuickAddProductOverlayGrid"
              Visibility="{Binding IsQuickAddProductModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000"
              MouseLeftButtonDown="QuickAddProductOverlay_OnMouseLeftButtonDown">
            <Canvas x:Name="QuickAddProductOverlayCanvas"
                    SizeChanged="QuickAddProductOverlayCanvas_OnSizeChanged">
                <Border x:Name="QuickAddProductDialogBorder"
                        Canvas.Left="160"
                        Canvas.Top="70"
                        Width="800"
                        Height="560"
                        MinWidth="600"
                        MinHeight="400"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#0F172A" Opacity="0.28" />
                    </Border.Effect>

                    <Grid>
                        <Border CornerRadius="20" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Draggable Header (.product-modal-header) -->
                                <Border Grid.Row="0"
                                        Padding="16,12"
                                        Cursor="SizeAll"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        ToolTip="Drag header to move window • Drag any edge or corner to resize"
                                        MouseLeftButtonDown="QuickAddProductHeader_OnMouseLeftButtonDown"
                                        MouseMove="QuickAddProductHeader_OnMouseMove"
                                        MouseLeftButtonUp="QuickAddProductHeader_OnMouseLeftButtonUp"
                                        LostMouseCapture="QuickAddProductHeader_OnLostMouseCapture">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#EFF6FF" Offset="0.0" />
                                            <GradientStop Color="#F5F3FF" Offset="0.6" />
                                            <GradientStop Color="#FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#DBEAFE" Margin="0,0,12,0">
                                                <Path Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5Z"
                                                      Fill="#2563EB" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Add New Product" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                                <TextBlock Text="Product details and inventory classification" FontSize="11.5" Foreground="#64748B" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource RowIconBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Command="{Binding CloseQuickAddProductModalCommand}">
                                            <TextBlock Text="✕" FontSize="13" Foreground="#64748B" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Body (.product-modal-body) -->
                                <Border Grid.Row="1" Background="#F8FAFC" Padding="18,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <!-- Row 1: Product Code / Barcode / Rack -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Product Code" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="32">
                                                        <TextBlock Text="{Binding NewProdCode}" FontFamily="Consolas" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="Barcode" FontSize="11.5" FontWeight="Medium" Foreground="#334155" />
                                                        <Button Cursor="Hand" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0"
                                                                Command="{Binding RegenerateQuickProductBarcodeCommand}">
                                                            <TextBlock Text="Auto-generate" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBox Style="{StaticResource WebInputStyle}" Height="32" Text="{Binding NewProdBarcode, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Rack" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <TextBox Style="{StaticResource WebInputStyle}" Height="32" Text="{Binding NewProdRack, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Name * / Formulation / Pack Size -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="0.7*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Name *" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <TextBox x:Name="QuickAddProductNameTextBox" Style="{StaticResource WebInputStyle}" Height="32"
                                                             Text="{Binding NewProdName, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Formulation (Generic / Salt)" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <local:SearchableSelect ItemsSource="{Binding QuickProductFormulations}"
                                                                            SelectedItem="{Binding SelectedNewProdFormulationOption, Mode=TwoWay}"
                                                                            Text="{Binding NewProdFormulation, Mode=TwoWay}"
                                                                            DisplayMemberPath="Name"
                                                                            Placeholder="Search or type formulation..."
                                                                            IsCreatable="True"
                                                                            IsClearable="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Pack Size" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <TextBox Style="{StaticResource WebInputStyle}" Height="32" Text="{Binding NewProdPackSizeText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 3: Category / Brand / Supplier -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Category" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <local:SearchableSelect ItemsSource="{Binding QuickProductCategories}"
                                                                            SelectedItem="{Binding SelectedNewProdCategory, Mode=TwoWay}"
                                                                            DisplayMemberPath="Name"
                                                                            Placeholder="Select..." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Brand" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <local:SearchableSelect ItemsSource="{Binding QuickProductBrands}"
                                                                            SelectedItem="{Binding SelectedNewProdBrand, Mode=TwoWay}"
                                                                            DisplayMemberPath="Name"
                                                                            Placeholder="Search brand..." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Supplier" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                                    <local:SearchableSelect ItemsSource="{Binding QuickProductSuppliers}"
                                                                            SelectedItem="{Binding SelectedNewProdSupplier, Mode=TwoWay}"
                                                                            DisplayMemberPath="Name"
                                                                            Placeholder="Select..." />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 4: Description + Narcotic -->
                                            <TextBlock Text="Description" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                            <TextBox Style="{StaticResource WebInputStyle}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                                     Text="{Binding NewProdDescription, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Content="Narcotic" IsChecked="{Binding NewProdIsNarcotic, Mode=TwoWay}"
                                                      FontSize="12" Foreground="#334155" Margin="0,10,0,0"
                                                      Visibility="{Binding IsPharmacyShop, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock Text="{Binding NewProdError}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Footer (.product-modal-footer) -->
                                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid>
                                        <TextBlock Text="Alt+S to save • Esc to close" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource OutlineBtnStyle}" Padding="14,7" Margin="0,0,8,0"
                                                    Command="{Binding CloseQuickAddProductModalCommand}" Content="Cancel" />
                                            <Button Style="{StaticResource PrimaryBtnStyle}" Padding="16,7"
                                                    Command="{Binding SaveQuickAddProductCommand}" Content="Save Product" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 8-Way Resize Handles for Quick Add Product Modal -->
                        <Border Tag="n" VerticalAlignment="Top" Height="6" Margin="12,0,12,0" Background="Transparent" Cursor="SizeNS" Panel.ZIndex="30"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="s" VerticalAlignment="Bottom" Height="6" Margin="12,0,12,0" Background="Transparent" Cursor="SizeNS" Panel.ZIndex="30"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="e" HorizontalAlignment="Right" Width="6" Margin="0,12,0,12" Background="Transparent" Cursor="SizeWE" Panel.ZIndex="30"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="w" HorizontalAlignment="Left" Width="6" Margin="0,12,0,12" Background="Transparent" Cursor="SizeWE" Panel.ZIndex="30"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="ne" HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="31"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="nw" HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="31"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="sw" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="31"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture" />
                        <Border Tag="se" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="31"
                                ToolTip="Drag to resize window"
                                MouseLeftButtonDown="QuickAddProductResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="QuickAddProductResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="QuickAddProductResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="QuickAddProductResizeHandle_OnLostMouseCapture">
                            <Path Data="M10,14 L14,10 M6,14 L14,6" Stroke="#94A3B8" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" IsHitTestVisible="False" />
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 4: HELD PURCHASE DRAFTS MODAL (Alt+D)                         -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDraftsModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="640" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Held Purchase Drafts (Alt+D)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Resume an in-progress GRN draft or discard drafts you no longer need." FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseHeldDraftsModalCommand}" Content="✕ Close" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldDrafts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DraftNumber}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SupplierName}" FontSize="11.5" Foreground="#475569" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding FormattedUpdatedAt, StringFormat='Updated: {0}'}" FontSize="10.5" Foreground="#64748B" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Button Style="{StaticResource PrimaryBtnStyle}" Padding="10,5" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ResumeHeldDraftCommand, ElementName=PurchaseInvoicesRoot}"
                                                        CommandParameter="{Binding}" Content="Resume" />
                                                <Button Style="{StaticResource DangerBtnStyle}" Padding="9,5"
                                                        Command="{Binding DataContext.DeleteHeldDraftCommand, ElementName=PurchaseInvoicesRoot}"
                                                        CommandParameter="{Binding}" Content="Discard" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right"
                                Command="{Binding CloseHeldDraftsModalCommand}" Content="Done" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 5: PRE-SHIFT CASH DRAWER PROMPT MODAL                         -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsPreShiftPromptOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel>
                    <TextBlock Text="Pre-Shift Cash Purchase Edit Detected" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding PreShiftPromptMessage}" FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding CancelPreShiftPromptCommand}" Content="Cancel" />
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding ConfirmPreShiftKeepDrawerCommand}" Content="Keep Current Shift Unchanged" />
                        <Button Style="{StaticResource PrimaryBtnStyle}"
                                Command="{Binding ConfirmPreShiftUpdateDrawerCommand}" Content="Adjust Current Cash Drawer" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 6: DOCUMENT AUDIT HISTORY MODAL                               -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="640" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding HistoryModalTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right"
                                Command="{Binding CloseHistoryModalCommand}" Content="✕ Close" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistoryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#DBEAFE" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ActionBadge}" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FormattedTimestamp}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding ChangesSummary}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Reason, StringFormat='Reason: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right"
                                Command="{Binding CloseHistoryModalCommand}" Content="Close" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 7: REVERSE / VOID PURCHASE INVOICE MODAL                      -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsReverseModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel>
                    <TextBlock Text="{Binding ReverseTargetPostedNumber, StringFormat='Reverse / Void {0}'}" FontSize="16" FontWeight="Bold" Foreground="#991B1B" />
                    <TextBlock Text="Reversing a purchase invoice deducts received stock &amp; batch quantities, reverts moving weighted-average cost, reverses supplier ledger / cash drawer entries, and marks the voucher as Reversed."
                               FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <TextBlock Text="REVERSAL REASON *" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource WebInputStyle}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding ReverseReason, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding ReverseModalError}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding CloseReverseModalCommand}" Content="Cancel (Esc)" />
                        <Button Style="{StaticResource DangerBtnStyle}" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                                Command="{Binding ConfirmReverseInvoiceCommand}" Content="Confirm Reversal (Alt+S)" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 8: 2-STEP PASSWORD-CONFIRMED DELETE MODAL                     -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteTargetPostedNumber, StringFormat='Delete {0}'}" FontSize="16" FontWeight="Bold" Foreground="#991B1B" />

                    <StackPanel Visibility="{Binding IsDeleteStep1, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock Text="Are you sure you want to permanently delete this purchase invoice? This action cannot be undone."
                                   FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                    Command="{Binding CloseDeleteModalCommand}" Content="Cancel" />
                            <Button Style="{StaticResource DangerBtnStyle}"
                                    Command="{Binding ProceedToDeleteStep2Command}" Content="Yes, continue" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsDeleteStep2, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock Text="For security, please re-enter your password to delete this invoice."
                                   FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                        <PasswordBox x:Name="DeleteConfirmPasswordBox"
                                     Height="32" Padding="8,4" FontSize="13"
                                     IsVisibleChanged="DeleteConfirmPasswordBox_OnIsVisibleChanged"
                                     PreviewKeyDown="DeleteConfirmPasswordBox_OnPreviewKeyDown"
                                     PasswordChanged="DeleteConfirmPasswordBox_OnPasswordChanged" />
                        <TextBlock Text="{Binding DeleteModalError}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                    Command="{Binding CloseDeleteModalCommand}" Content="Cancel" />
                            <Button Style="{StaticResource DangerBtnStyle}" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                                    Command="{Binding ConfirmDeleteInvoiceCommand}" Content="Confirm &amp; Delete" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
