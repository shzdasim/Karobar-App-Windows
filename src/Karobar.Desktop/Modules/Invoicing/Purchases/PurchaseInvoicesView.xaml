                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsZeroOrNegativeMargin}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Col 17: W.S.Mrg% (Read-only) -->
                                                <Border Grid.Column="17" Style="{StaticResource ReadOnlyBoxStyle}" Margin="1,0"
                                                        Visibility="{Binding DataContext.HasWholesale, ElementName=PurchaseInvoicesRoot, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding WholeSaleMarginDisplayText}" FontFamily="Consolas" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Col 18: Avg Cost (Read-only) -->
                                                <Border Grid.Column="18" Style="{StaticResource ReadOnlyBoxStyle}" Margin="1,0">
                                                    <TextBlock Text="{Binding AvgPrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Col 19: Sub Total (Accented Read-only Badge) -->
                                                <Border Grid.Column="19" Style="{StaticResource SubTotalBoxStyle}" Margin="1,0">
                                                    <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Col 20: "+" Add Row & Open Product Modal -->
                                                <Button Grid.Column="20" Style="{StaticResource RowIconBtnStyle}" Width="22" Height="22"
                                                        Command="{Binding DataContext.AppendRowAndOpenProductModalCommand, ElementName=PurchaseInvoicesRoot}"
                                                        ToolTip="Add item">
                                                    <TextBlock Text="⊕" FontSize="13" FontWeight="Bold" Foreground="#2563EB" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ================= ROW 2: ULTRA-COMPACT 2-ROW STICKY FOOTER (PurchaseInvoiceForm.jsx:2447-2664) ================= -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,6">
                    <StackPanel>
                        <!-- Footer Row 1: Adjustments (Disc / Tax) on Left + Computed Totals on Right -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Inline Adjustments -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DISC %" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="FooterDiscountPctTextBox"
                                         Style="{StaticResource WebInputStyle}" Width="54" Height="26" TextAlignment="Right" Margin="0,0,10,0"
                                         Text="{Binding DiscountPctText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                         PreviewKeyDown="FooterDiscountPctTextBox_OnPreviewKeyDown" />

                                <TextBlock Text="DISCOUNT" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="FooterDiscountAmtTextBox"
                                         Style="{StaticResource WebInputStyle}" Width="76" Height="26" TextAlignment="Right" FontFamily="Consolas" Margin="0,0,12,0"
                                         Text="{Binding DiscountAmtText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                         PreviewKeyDown="FooterDiscountAmtTextBox_OnPreviewKeyDown" />

                                <TextBlock Text="TAX %" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="FooterTaxPctTextBox"
                                         Style="{StaticResource WebInputStyle}" Width="54" Height="26" TextAlignment="Right" Margin="0,0,10,0"
                                         Text="{Binding TaxPctText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                         PreviewKeyDown="FooterTaxPctTextBox_OnPreviewKeyDown" />

                                <TextBlock Text="TAX" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="FooterTaxAmtTextBox"
                                         Style="{StaticResource WebInputStyle}" Width="76" Height="26" TextAlignment="Right" FontFamily="Consolas" Margin="0,0,12,0"
                                         Text="{Binding TaxAmtText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                         PreviewKeyDown="FooterTaxAmtTextBox_OnPreviewKeyDown" />

                                <!-- Inline Edit Reason when in Edit Mode -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsEditFormMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="EDIT REASON" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBox Style="{StaticResource WebInputStyle}" Width="165" Height="26"
                                             Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Computed Totals -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ITEMS TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" Padding="8,0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding RowsTotal, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Visibility="{Binding HasDiscountSummary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="DISC" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" Padding="8,0">
                                        <TextBlock Text="{Binding DiscountAmount, StringFormat='−{0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Medium" Foreground="#EF4444" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Visibility="{Binding HasTaxSummary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="TAX" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" Padding="8,0">
                                        <TextBlock Text="{Binding TaxAmount, StringFormat='+{0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="TOTAL AMOUNT" FontSize="10" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Height="26" Padding="10,0">
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footer Row 2: Payment Method & Account + Total Paid + Remaining + Save Button -->
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="METHOD" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <local:SearchableSelect Width="135" Margin="0,0,10,0"
                                                            ItemsSource="{Binding PaymentMethodOptions}"
                                                            SelectedItem="{Binding SelectedPaymentMethodOption, Mode=TwoWay}"
                                                            DisplayMemberPath="Label"
                                                            Placeholder="Cash" />

                                    <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <local:SearchableSelect Width="215" Margin="0,0,12,0"
                                                            ItemsSource="{Binding FilteredAccountOptions}"
                                                            SelectedItem="{Binding SelectedAccountOption, Mode=TwoWay}"
                                                            DisplayMemberPath="DisplayLabel"
                                                            Placeholder="Select account..." />

                                    <TextBlock Text="TOTAL PAID" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBox x:Name="TotalPaidTextBox"
                                             Style="{StaticResource WebInputStyle}" Width="92" Height="26" TextAlignment="Right" FontFamily="Consolas" Margin="0,0,4,0"
                                             Text="{Binding TotalPaidText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown" />
                                    <Button Style="{StaticResource OutlineBtnStyle}" Width="26" Height="26" Padding="0" Margin="0,0,12,0"
                                            Command="{Binding RelinkPaidToTotalCommand}"
                                            ToolTip="Relink paid to total">
                                        <TextBlock Text="🔗" FontSize="11" />
                                    </Button>

                                    <TextBlock Text="REMAINING" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" MinWidth="82" Padding="8,0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding RemainingPayableAmount, StringFormat='{}{0:N2}'}"
                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRemainingPositive}" Value="True">
                                                            <Setter Property="Foreground" Value="#D97706" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Ledger Credit Excess -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding HasLedgerCreditExcess, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="LEDGER CREDIT" FontSize="10" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" MinWidth="82" Padding="8,0">
                                            <TextBlock Text="{Binding LedgerCreditExcessAmount, StringFormat='+{0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Save Purchase Invoice Button -->
                                <Button x:Name="SaveInvoiceFooterButton"
                                        Grid.Column="1"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        Height="28"
                                        Padding="18,0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Command="{Binding SaveInvoiceCommand}"
                                        Content="{Binding SaveButtonLabel}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- MODE 3: VOUCHER DETAIL / SHOW VIEW                                  -->
        <!-- =================================================================== -->
        <Border Visibility="{Binding IsDetailMode, Converter={StaticResource BoolToVis}}"
                Margin="10,8,10,8"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Detail Header Banner -->
                <Border Grid.Row="0" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,4" Margin="0,0,10,0"
                                        Command="{Binding BackToDirectoryCommand}" Content="← Back" />
                                <TextBlock Text="{Binding CurrentDetail.PostedNumber}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border CornerRadius="5" Padding="8,2" VerticalAlignment="Center" Background="#DBEAFE" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentDetail.InvoiceType}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" />
                                </Border>
                                <Border CornerRadius="5" Padding="8,2" VerticalAlignment="Center" Background="#ECFDF5">
                                    <TextBlock Text="{Binding CurrentDetail.Status}" FontSize="11" FontWeight="Bold" Foreground="#047857" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0"
                                        Command="{Binding PrintCurrentDetailA4Command}" Content="🖨 Print A4 (Ctrl+P)" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0"
                                        Command="{Binding PrintCurrentDetailThermalCommand}" Content="🧾 80mm Receipt" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0"
                                        Command="{Binding SendCurrentDetailToBarcodeStudioCommand}" Content="🏷 Print Barcodes" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0"
                                        Command="{Binding OpenCurrentDetailHistoryCommand}" Content="🕒 History" />
                                <Button Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,6,0"
                                        IsEnabled="{Binding CanMutateCurrentDetail}"
                                        Command="{Binding EditCurrentDetailCommand}" Content="✎ Edit (Alt+E)" />
                                <Button Style="{StaticResource DangerBtnStyle}" Margin="0,0,6,0"
                                        IsEnabled="{Binding CanMutateCurrentDetail}"
                                        Command="{Binding OpenReverseForCurrentDetailCommand}" Content="↩ Reverse" />
                                <Button Style="{StaticResource DangerBtnStyle}"
                                        Command="{Binding OpenDeleteForCurrentDetailCommand}" Content="🗑 Delete" />
                            </StackPanel>
                        </Grid>

                        <!-- Metadata Strip -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SUPPLIER" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentDetail.SupplierName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{Binding CurrentDetail.SupplierExpiryPolicyLabel}" FontSize="11" Foreground="#047857" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SUPPLIER INVOICE #" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentDetail.InvoiceNumber}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="POSTED DATE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentDetail.PostedDate, StringFormat='{}{0:dd-MM-yyyy}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="DUE DATE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentDetail.DueDate, StringFormat='{}{0:dd-MM-yyyy}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PAYMENT ACCOUNT" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentDetail.AccountName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Detail Items Table (Full Screen Width) -->
                <Grid Grid.Row="1" Margin="10,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,1,1" CornerRadius="6,6,0,0" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="1" Text="Product" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="2" Text="PSize" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Batch" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="4" Text="Expiry" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Unit Qty" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="Bonus" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="Pack Cost" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="8" Text="Unit Cost" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="9" Text="Disc%" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="10" Text="Pack Sale" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="11" Text="Unit Sale" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="12" Text="Margin%" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="13" Text="Avg Cost" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                            <TextBlock Grid.Column="14" Text="Sub Total" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CurrentDetail.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="0.85*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding LineOrder}" FontSize="11.5" Foreground="#64748B" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BrandName}" FontSize="10" Foreground="#64748B" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PackSize}" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" TextAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Batch}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" />
                                                <TextBlock Grid.Column="4" Text="{Binding Expiry, StringFormat='{}{0:dd-MM-yyyy}'}" FontSize="11.5" Foreground="#334155" TextAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding UnitQuantity}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Right" />
                                                <TextBlock Grid.Column="6" Text="{Binding UnitBonus}" FontFamily="Consolas" FontSize="11.5" Foreground="#059669" TextAlignment="Right" />
                                                <TextBlock Grid.Column="7" Text="{Binding PackPurchasePrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" TextAlignment="Right" />
                                                <TextBlock Grid.Column="8" Text="{Binding UnitPurchasePrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" TextAlignment="Right" />
                                                <TextBlock Grid.Column="9" Text="{Binding ItemDiscountPercentage, StringFormat='{}{0:0.##}%'}" FontFamily="Consolas" FontSize="11.5" Foreground="#64748B" TextAlignment="Right" />
                                                <TextBlock Grid.Column="10" Text="{Binding PackSalePrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" TextAlignment="Right" />
                                                <TextBlock Grid.Column="11" Text="{Binding UnitSalePrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" TextAlignment="Right" />
                                                <TextBlock Grid.Column="12" Text="{Binding Margin, StringFormat='{}{0:0.##}%'}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857" TextAlignment="Right" />
                                                <TextBlock Grid.Column="13" Text="{Binding AvgPrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" Foreground="#64748B" TextAlignment="Right" />
                                                <TextBlock Grid.Column="14" Text="{Binding SubTotal, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Compact Detail Footer -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Gross: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentDetail.GrossTotal, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="Discount: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentDetail.DiscountAmount, StringFormat='-Rs. {0:N2}'}" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="Tax: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
