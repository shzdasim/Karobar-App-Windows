<UserControl x:Class="Karobar.Desktop.Views.PurchaseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Karobar.Desktop.Views"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="PurchaseInvoicesView_OnPreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource OutlineBtnStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FECACA" />
        </Style>

        <Style x:Key="GridCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="CellBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CellBd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="CellBd" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CellBd" Property="Background" Value="#F8FAFC" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InBd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InBd" Property="Background" Value="#F8FAFC" />
                                <Setter Property="Foreground" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- =================================================================== -->
        <!-- MODE 1: PURCHASE INVOICES DIRECTORY (/purchase-invoices)            -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,24">

                    <!-- Top Header Banner -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20,16"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="🛒 GRN &amp; PURCHASES" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED" />
                                    </Border>
                                    <TextBlock Text="Purchase Invoices" FontSize="21" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Receive supplier stock, calculate moving weighted-average costs, manage batches &amp; expiries, fulfill POs, and post cash or credit payables."
                                           FontSize="12.5"
                                           Foreground="#64748B"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineBtnStyle}"
                                        Command="{Binding OpenHeldDraftsModalCommand}"
                                        Margin="0,0,8,0"
                                        ToolTip="View &amp; Resume Held Purchase Drafts (Alt+D)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏸ " FontSize="12" />
                                        <TextBlock Text="{Binding HeldDraftsBadgeText}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource OutlineBtnStyle}"
                                        Command="{Binding RefreshDirectoryCommand}"
                                        Margin="0,0,8,0"
                                        ToolTip="Refresh (F5)">
                                    <TextBlock Text="↻ Refresh" FontSize="12" />
                                </Button>

                                <Button Style="{StaticResource PrimaryBtnStyle}"
                                        Command="{Binding GoToCreateFormCommand}"
                                        ToolTip="Create New Purchase Invoice (Ctrl+N / Alt+1)">
                                    <TextBlock Text="+ New Purchase Invoice" FontSize="12.5" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI Summary Strip -->
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="POSTED INVOICES" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding KpiPostedCount, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                <TextBlock Text="Active goods received notes" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL PURCHASE VALUE" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0">
                                    <Run Text="{Binding CurrencySymbol, Mode=OneWay}" />
                                    <Run Text="{Binding KpiTotalAmount, StringFormat={}{0:N2}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Net posted purchase total" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL PAID OUT" FontSize="10.5" FontWeight="Bold" Foreground="#059669" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0">
                                    <Run Text="{Binding CurrencySymbol, Mode=OneWay}" />
                                    <Run Text="{Binding KpiPaidAmount, StringFormat={}{0:N2}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Direct + allocated supplier payments" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="CREDIT PAYABLE DUE" FontSize="10.5" FontWeight="Bold" Foreground="#D97706" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#92400E" Margin="0,4,0,0">
                                    <Run Text="{Binding CurrencySymbol, Mode=OneWay}" />
                                    <Run Text="{Binding KpiRemainingPayable, StringFormat={}{0:N2}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Remaining supplier credit balance" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter Bar -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Search (Ctrl+F)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="DirectorySearchTextBox"
                                         Style="{StaticResource FormInputTextBoxStyle}"
                                         Text="{Binding DirectorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by PRINV #, Supplier Invoice #, or Supplier Name" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Supplier" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <local:SearchableSelect ItemsSource="{Binding DirectorySupplierOptions}"
                                                        SelectedItem="{Binding SelectedDirectorySupplierOption, Mode=TwoWay}"
                                                        DisplayMemberPath="Label"
                                                        Placeholder="All Suppliers" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Invoice Type" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <local:SearchableSelect ItemsSource="{Binding DirectoryTypeOptions}"
                                                        SelectedItem="{Binding SelectedDirectoryTypeOption, Mode=TwoWay}"
                                                        DisplayMemberPath="Label"
                                                        Placeholder="All Types" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <local:SearchableSelect ItemsSource="{Binding DirectoryStatusOptions}"
                                                        SelectedItem="{Binding SelectedDirectoryStatusOption, Mode=TwoWay}"
                                                        DisplayMemberPath="Label"
                                                        Placeholder="All Statuses" />
                            </StackPanel>

                            <StackPanel Grid.Column="8">
                                <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <Border CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF" Height="34" Padding="2,0">
                                    <DatePicker BorderThickness="0"
                                                Background="Transparent"
                                                SelectedDateFormat="Short"
                                                VerticalContentAlignment="Center"
                                                SelectedDate="{Binding DirectoryFromDate, Mode=TwoWay}"
                                                Loaded="AnyDatePicker_OnLoaded" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="10">
                                <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <Border CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF" Height="34" Padding="2,0">
                                    <DatePicker BorderThickness="0"
                                                Background="Transparent"
                                                SelectedDateFormat="Short"
                                                VerticalContentAlignment="Center"
                                                SelectedDate="{Binding DirectoryToDate, Mode=TwoWay}"
                                                Loaded="AnyDatePicker_OnLoaded" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="12"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    Command="{Binding ResetDirectoryFiltersCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="34"
                                    Content="Clear" />
                        </Grid>
                    </Border>

                    <!-- Directory Table Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="0">
                        <StackPanel>
                            <!-- Table Header -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="POSTED #" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="DATE" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="2" Text="SUPPLIER" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="3" Text="SUPPLIER INV #" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="4" Text="TYPE" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="5" Text="ITEMS" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="NET TOTAL" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="PAID" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="8" Text="PAYABLE DUE" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="9" Text="ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Directory Rows -->
                            <ItemsControl ItemsSource="{Binding DirectoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,10" Background="#FFFFFF">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="95" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="230" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Posted # + Reversed Badge -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PostedNumber}" FontSize="12.5" FontWeight="Bold" Foreground="#1E40AF">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Visibility="{Binding IsReversed, Converter={StaticResource BoolToVis}}"
                                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                        <TextBlock Text="REVERSED" FontSize="9" FontWeight="Bold" Foreground="#DC2626" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SupplierName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PurchaseOrderNumber, StringFormat=PO: {0}}"
                                                               FontSize="10.5"
                                                               Foreground="#7C3AED"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PurchaseOrderNumber}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding InvoiceNumber}" FontSize="12" FontFamily="Consolas" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- Debit / Credit Pill -->
                                                <Border Grid.Column="4" CornerRadius="99" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#ECFDF5" />
                                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                    <Setter Property="Background" Value="#FFFBEB" />
                                                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding InvoiceTypeBadge}" FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#059669" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                        <Setter Property="Foreground" Value="#D97706" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="5" Text="{Binding ItemsCount}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Center" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="6" Text="{Binding TotalAmount, StringFormat={}{0:N2}}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="{Binding TotalPaid, StringFormat={}{0:N2}}" FontSize="12" Foreground="#059669" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="8" Text="{Binding RemainingAmount, StringFormat={}{0:N2}}" FontSize="12" Foreground="#D97706" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />

                                                <!-- Row Actions -->
                                                <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,4" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="View Invoice Details"
                                                            Content="View" />
                                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,4" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.EditInvoiceFromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Edit Purchase Invoice"
                                                            Content="Edit" />
                                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,4" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.PrintInvoiceA4FromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Print A4 GRN Voucher"
                                                            Content="🖨" />
                                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,4" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.SendToBarcodeStudioFromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Send Items to Barcode Label Studio"
                                                            Content="🏷" />
                                                    <Button Style="{StaticResource DangerBtnStyle}" Padding="7,4"
                                                            Command="{Binding DataContext.OpenDeleteFromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete Invoice (Password Required)"
                                                            Content="✕" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <Border Visibility="{Binding ShowEmptyDirectoryState, Converter={StaticResource BoolToVis}}"
                                    Padding="36">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="32" HorizontalAlignment="Center" />
                                    <TextBlock Text="No purchase invoices found" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                    <TextBlock Text="Click '+ New Purchase Invoice' or press Ctrl+N to record your first supplier delivery."
                                               FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                    <Button Style="{StaticResource PrimaryBtnStyle}"
                                            Command="{Binding GoToCreateFormCommand}"
                                            HorizontalAlignment="Center"
                                            Content="+ Create First Purchase Invoice" />
                                </StackPanel>
                            </Border>

                            <!-- Pagination Footer -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding PaginationSummaryText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:SearchableSelect Width="120"
                                                                Margin="0,0,10,0"
                                                                ItemsSource="{Binding PageSizeOptions}"
                                                                SelectedItem="{Binding SelectedPageSizeOption, Mode=TwoWay}"
                                                                DisplayMemberPath="Label" />
                                        <Button Style="{StaticResource OutlineBtnStyle}"
                                                Command="{Binding PrevPageCommand}"
                                                IsEnabled="{Binding CanPrevPage}"
                                                Margin="0,0,6,0"
                                                Content="← Prev" />
                                        <Button Style="{StaticResource OutlineBtnStyle}"
                                                Command="{Binding NextPageCommand}"
                                                IsEnabled="{Binding CanNextPage}"
                                                Content="Next →" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODE 2: CREATE / EDIT PURCHASE INVOICE FORM                         -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}">
            <ScrollViewer x:Name="FormScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,28">

                    <!-- Top Form Action Bar -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineBtnStyle}"
                                        Command="{Binding BackToDirectoryCommand}"
                                        Margin="0,0,12,0"
                                        Content="← Back" />
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FormHeaderTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <Border Visibility="{Binding HasActiveDraftBanner, Converter={StaticResource BoolToVis}}"
                                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveDraftNumber, StringFormat=Draft: {0}}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
                                        </Border>
                                        <Border Visibility="{Binding IsLinkedToPurchaseOrder, Converter={StaticResource BoolToVis}}"
                                                Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LinkedPurchaseOrderNumber, StringFormat=Receiving {0}}" FontSize="11" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center" />
                                                <Button Content="✕" FontSize="10" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#6D28D9" Cursor="Hand"
                                                        Command="{Binding DetachPurchaseOrderCommand}" ToolTip="Detach Purchase Order" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Speed Navigation: Enter advances across fields • ↑/↓ moves vertically between rows • Alt+T toggles Debit/Credit • Alt+H holds draft • Alt+S posts"
                                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Debit / Credit Segmented Toggle -->
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding SetInvoiceTypeCommand}" CommandParameter="debit" Cursor="Hand" BorderThickness="0" Padding="12,5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DbBd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <TextBlock x:Name="DbTxt" Text="💵 Debit (Cash)" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDebitInvoice}" Value="True">
                                                            <Setter TargetName="DbBd" Property="Background" Value="#059669" />
                                                            <Setter TargetName="DbTxt" Property="Foreground" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding SetInvoiceTypeCommand}" CommandParameter="credit" Cursor="Hand" BorderThickness="0" Padding="12,5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CrBd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <TextBlock x:Name="CrTxt" Text="📘 Credit (Payable)" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCreditInvoice}" Value="True">
                                                            <Setter TargetName="CrBd" Property="Background" Value="#D97706" />
                                                            <Setter TargetName="CrTxt" Property="Foreground" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource OutlineBtnStyle}"
                                        Command="{Binding HoldCurrentDraftCommand}"
                                        Margin="0,0,6,0"
                                        ToolTip="Hold Current Invoice as Draft (Alt+H)"
                                        Content="⏸ Hold (Alt+H)" />

                                <Button Style="{StaticResource OutlineBtnStyle}"
                                        Command="{Binding OpenHeldDraftsModalCommand}"
                                        Margin="0,0,10,0"
                                        ToolTip="Open Held Drafts (Alt+D)"
                                        Content="{Binding HeldDraftsBadgeText}" />

                                <Button Style="{StaticResource PrimaryBtnStyle}"
                                        Command="{Binding SaveInvoiceCommand}"
                                        Content="{Binding SaveButtonLabel}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Errors Banner -->
                    <Border Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVis}}"
                            Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Header Card (Exact Web App Order: Posted #, Date, Supplier *, Invoice #, Bill Amt, Diff, Receive PO, Remarks) -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="138" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <!-- 1. Posted # -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Posted #" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FormInputTextBoxStyle}"
                                             IsReadOnly="True"
                                             FontWeight="Bold"
                                             FontFamily="Consolas"
                                             Text="{Binding PostedNumber, Mode=OneWay}" />
                                </StackPanel>

                                <!-- 2. Date (dd-MM-yyyy) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Date *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <Border CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF" Height="34" Padding="2,0">
                                        <DatePicker x:Name="PostedDatePicker"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    SelectedDateFormat="Short"
                                                    VerticalContentAlignment="Center"
                                                    SelectedDate="{Binding PostedDate, Mode=TwoWay}"
                                                    Loaded="AnyDatePicker_OnLoaded" />
                                    </Border>
                                </StackPanel>

                                <!-- 3. Supplier * -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Supplier *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <local:SearchableSelect x:Name="SupplierSelect"
                                                            ItemsSource="{Binding SupplierOptions}"
                                                            SelectedItem="{Binding SelectedSupplierOption, Mode=TwoWay}"
                                                            DisplayMemberPath="DisplayLabel"
                                                            Placeholder="Select supplier..."
                                                            MoveFocusOnEnter="False"
                                                            EnterCommitted="SupplierSelect_OnEnterCommitted" />
                                </StackPanel>

                                <!-- 4. Supplier Invoice # * -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Supplier Invoice # *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox x:Name="InvoiceNumberTextBox"
                                             Style="{StaticResource FormInputTextBoxStyle}"
                                             Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="InvoiceNumberTextBox_OnPreviewKeyDown" />
                                </StackPanel>

                                <!-- 5. Bill Amt + '= Net' sync button -->
                                <StackPanel Grid.Column="8">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Bill Amt *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                        <Button Content="= Net"
                                                Command="{Binding MatchBillAmountToTotalCommand}"
                                                HorizontalAlignment="Right"
                                                Background="#EFF6FF"
                                                BorderBrush="#BFDBFE"
                                                BorderThickness="1"
                                                Foreground="#2563EB"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Padding="5,1"
                                                Cursor="Hand"
                                                ToolTip="Copy calculated Net Total into Bill Amt" />
                                    </Grid>
                                    <TextBox x:Name="BillAmountTextBox"
                                             Style="{StaticResource FormInputTextBoxStyle}"
                                             TextAlignment="Right"
                                             FontWeight="SemiBold"
                                             Text="{Binding BillAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                             PreviewKeyDown="BillAmountTextBox_OnPreviewKeyDown" />
                                </StackPanel>

                                <!-- 6. Diff (Bill Amt - Total Amount) -->
                                <StackPanel Grid.Column="10">
                                    <TextBlock Text="Diff (±5 max)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <Border Height="34" CornerRadius="8" Padding="8,0" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBillDiffWarning}" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2" />
                                                        <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BillDifference, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12.5"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBillDiffWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- 7. Receive from PO (Optional) -->
                                <StackPanel Grid.Column="12">
                                    <TextBlock Text="Receive Purchase Order" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <local:SearchableSelect ItemsSource="{Binding ReceivableOrderOptions}"
                                                            SelectedItem="{Binding SelectedReceivableOrderOption, Mode=TwoWay}"
                                                            DisplayMemberPath="DisplayLabel"
                                                            Placeholder="Load pending PO..."
                                                            IsClearable="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Second Header Row: Remarks + Edit Reason (if editing) -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Remarks / Delivery Notes" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FormInputTextBoxStyle}"
                                             Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding IsEditFormMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Audit Edit Reason" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FormInputTextBoxStyle}"
                                             Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Recorded in Document Audit History" />
                                </StackPanel>
                            </Grid>

                            <!-- Supplier Credit Summary & Due Date Bar (Visible in Credit mode or when supplier has overdue/limit warnings) -->
                            <Border Visibility="{Binding ShowSupplierCreditBar, Converter={StaticResource BoolToVis}}"
                                    Background="#FFFBEB"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="155" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CREDIT TERMS" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                        <TextBlock Text="{Binding ActiveSupplierCredit.CreditDays, StringFormat={}{0} Days}" FontSize="13" FontWeight="Bold" Foreground="#78350F" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CREDIT LIMIT" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                        <TextBlock Text="{Binding ActiveSupplierCredit.CreditLimit, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="#78350F" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CURRENT PAYABLE" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                        <TextBlock Text="{Binding ActiveSupplierCredit.CurrentPayable, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="#B45309" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="OVERDUE BILLS" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0">
                                            <Run Text="{Binding ActiveSupplierCredit.OverdueCount, Mode=OneWay}" />
                                            <Run Text=" (" /><Run Text="{Binding ActiveSupplierCredit.OverdueAmount, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="EXPIRY RETURN POLICY" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                        <TextBlock Text="{Binding ActiveSupplierCredit.ExpiryPolicyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#78350F" Margin="0,2,0,0" />
                                        <TextBlock Visibility="{Binding IsCreditLimitExceeded, Converter={StaticResource BoolToVis}}"
                                                   Text="⚠ Projected payable exceeds supplier credit limit!"
                                                   FontSize="10.5" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="5">
                                        <TextBlock Text="Due Date (dd-MM-yyyy)" FontSize="10" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,3" />
                                        <Border CornerRadius="7" BorderBrush="#F59E0B" BorderThickness="1" Background="#FFFFFF" Height="30" Padding="2,0">
                                            <DatePicker BorderThickness="0"
                                                        Background="Transparent"
                                                        SelectedDateFormat="Short"
                                                        VerticalContentAlignment="Center"
                                                        SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                                        Loaded="AnyDatePicker_OnLoaded" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Line Items Card (High-Speed Pack-First Entry Grid + 16 Row Arrangement Presets) -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="0"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Line Items Toolbar -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Line Items" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="99" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#1D4ED8">
                                                <Run Text="{Binding ActiveProductLinesCount, Mode=OneWay}" />
                                                <Run Text=" Products • " />
                                                <Run Text="{Binding TotalReceivedUnitsCount, Mode=OneWay}" />
                                                <Run Text=" Total Units" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Arrange Rows:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <local:SearchableSelect Width="210"
                                                                Margin="0,0,10,0"
                                                                ItemsSource="{Binding ArrangementOptions}"
                                                                SelectedItem="{Binding SelectedArrangementOption, Mode=TwoWay}"
                                                                DisplayMemberPath="Label" />
                                        <Button Style="{StaticResource OutlineBtnStyle}"
                                                Command="{Binding AppendEmptyLineCommand}"
                                                Content="+ Add Line" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Horizontally Scrollable High-Density Line Grid -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel MinWidth="1360">
                                    <!-- Column Header Row -->
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="116" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="PRODUCT *" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="2" Text="SIZE" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="BATCH" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="3,0,0,0" />
                                            <TextBlock Grid.Column="4" Text="EXPIRY" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="3,0,0,0" />
                                            <TextBlock Grid.Column="5" Text="PACK.Q" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="6" Text="UNIT.Q" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="7" Text="PACK.P" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="8" Text="UNIT.P" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="9" Text="DISC%" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="10" Text="PBONUS" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="11" Text="UBONUS" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="12" Text="PACK.S" FontSize="10.5" FontWeight="Bold" Foreground="#059669" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="13" Text="UNIT.S" FontSize="10.5" FontWeight="Bold" Foreground="#059669" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="14" Text="MRG%" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                            <TextBlock Grid.Column="15" Text="W.S.PACK" Visibility="{Binding HasWholesale, Converter={StaticResource BoolToVis}}" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="16" Text="W.S.UNIT" Visibility="{Binding HasWholesale, Converter={StaticResource BoolToVis}}" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED" TextAlignment="Right" Margin="0,0,3,0" />
                                            <TextBlock Grid.Column="17" Text="W.MRG%" Visibility="{Binding HasWholesale, Converter={StaticResource BoolToVis}}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                            <TextBlock Grid.Column="18" Text="AVG.COST" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                            <TextBlock Grid.Column="19" Text="NET TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" />
                                            <TextBlock Grid.Column="20" Text="ROW" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Editable Line Rows -->
                                    <ItemsControl x:Name="LinesItemsControl" ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,5" Background="#FFFFFF">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="155" />
                                                            <ColumnDefinition Width="116" />
                                                            <ColumnDefinition Width="66" />
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="66" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 0. Row # -->
                                                        <TextBlock Grid.Column="0" Text="{Binding RowNumber}" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" VerticalAlignment="Center" />

                                                        <!-- 1. Product Trigger Button (Enter or Click opens fast Product Search Modal) -->
                                                        <Button Grid.Column="1"
                                                                Tag="product"
                                                                Margin="0,0,3,0"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.OpenProductSearchForLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                PreviewKeyDown="ProductCellButton_OnPreviewKeyDown">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="ProdCellBd"
                                                                            Background="#F8FAFC"
                                                                            BorderBrush="#CBD5E1"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="7,4">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding ProductDisplayText}"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#0F172A"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding ProductMetaText}"
                                                                                       FontSize="10"
                                                                                       Foreground="#64748B"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="ProdCellBd" Property="BorderBrush" Value="#2563EB" />
                                                                            <Setter TargetName="ProdCellBd" Property="Background" Value="#EFF6FF" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ProdCellBd" Property="BorderBrush" Value="#94A3B8" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 2. Pack Size (Read-only) -->
                                                        <TextBlock Grid.Column="2" Text="{Binding PackSize}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" TextAlignment="Center" VerticalAlignment="Center" />

                                                        <!-- 3. Batch (Creatable SearchableSelect) -->
                                                        <Border Grid.Column="3" Margin="2,0">
                                                            <local:SearchableSelect Tag="batch"
                                                                                    IsEnabled="{Binding HasProduct}"
                                                                                    ItemsSource="{Binding BatchOptions}"
                                                                                    SelectedItem="{Binding SelectedBatchOption, Mode=TwoWay}"
                                                                                    Text="{Binding BatchText, Mode=TwoWay}"
                                                                                    DisplayMemberPath="DisplayLabel"
                                                                                    Placeholder="[Unassigned]"
                                                                                    IsCreatable="True"
                                                                                    IsClearable="True"
                                                                                    MoveFocusOnEnter="False"
                                                                                    EnterCommitted="LineBatchSelect_OnEnterCommitted" />
                                                        </Border>

                                                        <!-- 4. Expiry Date (dd-MM-yyyy) -->
                                                        <Border Grid.Column="4" Margin="2,0" Height="30" CornerRadius="6" BorderThickness="1" Padding="1,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasBatchWithoutExpiryWarning}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#EF4444" />
                                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DatePicker Tag="expiry"
                                                                        IsEnabled="{Binding HasProduct}"
                                                                        BorderThickness="0"
                                                                        Background="Transparent"
                                                                        FontSize="11.5"
                                                                        SelectedDateFormat="Short"
                                                                        VerticalContentAlignment="Center"
                                                                        SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                                                        Loaded="AnyDatePicker_OnLoaded"
                                                                        PreviewKeyDown="LineExpiryDatePicker_OnPreviewKeyDown" />
                                                        </Border>

                                                        <!-- 5. Pack.Q -->
                                                        <TextBox Grid.Column="5" Tag="pack_quantity" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding PackQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 6. Unit.Q -->
                                                        <TextBox Grid.Column="6" Tag="unit_quantity" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding UnitQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 7. Pack.P -->
                                                        <TextBox Grid.Column="7" Tag="pack_purchase_price" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding PackPurchaseText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 8. Unit.P -->
                                                        <TextBox Grid.Column="8" Tag="unit_purchase_price" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding UnitPurchaseText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 9. Disc% -->
                                                        <TextBox Grid.Column="9" Tag="item_discount_percentage" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding ItemDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 10. PBonus -->
                                                        <TextBox Grid.Column="10" Tag="pack_bonus" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding PackBonusText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 11. UBonus -->
                                                        <TextBox Grid.Column="11" Tag="unit_bonus" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding UnitBonusText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 12. Pack.S -->
                                                        <TextBox Grid.Column="12" Tag="pack_sale_price" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding PackSaleText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 13. Unit.S -->
                                                        <TextBox Grid.Column="13" Tag="unit_sale_price" Margin="2,0"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding UnitSaleText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 14. Mrg% (Read-only, Red if <= 0) -->
                                                        <TextBlock Grid.Column="14" Text="{Binding MarginDisplayText}" FontSize="11.5" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#059669" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsZeroOrNegativeMargin}" Value="True">
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- 15. W.S.Pack -->
                                                        <TextBox Grid.Column="15" Tag="whole_sale_pack_price" Margin="2,0"
                                                                 Visibility="{Binding DataContext.HasWholesale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding WholeSalePackText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 16. W.S.Unit -->
                                                        <TextBox Grid.Column="16" Tag="whole_sale_unit_price" Margin="2,0"
                                                                 Visibility="{Binding DataContext.HasWholesale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                                 Style="{StaticResource GridCellTextBoxStyle}"
                                                                 IsEnabled="{Binding HasProduct}"
                                                                 Text="{Binding WholeSaleUnitText, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                                 LostFocus="LineCellTextBox_OnLostFocus"
                                                                 PreviewKeyDown="LineCellTextBox_OnPreviewKeyDown" />

                                                        <!-- 17. W.S.Mrg% -->
                                                        <TextBlock Grid.Column="17"
                                                                   Visibility="{Binding DataContext.HasWholesale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                                   Text="{Binding WholeSaleMarginDisplayText}"
                                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#7C3AED" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" />

                                                        <!-- 18. Avg Cost -->
                                                        <TextBlock Grid.Column="18" Text="{Binding AvgPrice, StringFormat={}{0:N2}}" FontSize="11.5" Foreground="#475569" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" />

                                                        <!-- 19. Net Total -->
                                                        <TextBlock Grid.Column="19" Text="{Binding SubTotal, StringFormat={}{0:N2}}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" />

                                                        <!-- 20. Row Reorder & Remove -->
                                                        <StackPanel Grid.Column="20" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button Content="↑" FontSize="10" Padding="3,1" Margin="0,0,2,0" Cursor="Hand"
                                                                    Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                    Command="{Binding DataContext.MoveLineUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Move Row Up" />
                                                            <Button Content="↓" FontSize="10" Padding="3,1" Margin="0,0,2,0" Cursor="Hand"
                                                                    Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                    Command="{Binding DataContext.MoveLineDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Move Row Down" />
                                                            <Button Content="✕" FontSize="10" Padding="4,1" Cursor="Hand"
                                                                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Foreground="#DC2626"
                                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Remove Row" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Footer Summary, Payment Account & Totals Card -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Payment Method, Financial Account & Cash Drawer Status -->
                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Settlement &amp; Payment Account" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Payment Method" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                        <local:SearchableSelect ItemsSource="{Binding PaymentMethodOptions}"
                                                                SelectedItem="{Binding SelectedPaymentMethodOption, Mode=TwoWay}"
                                                                DisplayMemberPath="Label" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Disbursement Account" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                        <local:SearchableSelect ItemsSource="{Binding FilteredAccountOptions}"
                                                                SelectedItem="{Binding SelectedAccountOption, Mode=TwoWay}"
                                                                DisplayMemberPath="DisplayLabel"
                                                                Placeholder="Auto-resolve default account" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Direct Paid Now" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                            <Button Visibility="{Binding ShowRelinkPaidButton, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding RelinkPaidToTotalCommand}"
                                                    Content="↻ Relink to Total"
                                                    HorizontalAlignment="Right"
                                                    Background="#ECFDF5"
                                                    BorderBrush="#A7F3D0"
                                                    BorderThickness="1"
                                                    Foreground="#059669"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Padding="6,1"
                                                    Cursor="Hand" />
                                        </Grid>
                                        <TextBox x:Name="TotalPaidTextBox"
                                                 Style="{StaticResource FormInputTextBoxStyle}"
                                                 TextAlignment="Right"
                                                 FontWeight="Bold"
                                                 Text="{Binding TotalPaidText, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                 PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Remaining Payable (Supplier Ledger)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                        <Border Height="34" CornerRadius="8" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="10,0">
                                            <TextBlock Text="{Binding RemainingPayableAmount, StringFormat={}{0:N2}}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="#B45309" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Visibility="{Binding HasLedgerCreditExcess, Converter={StaticResource BoolToVis}}"
                                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF">
                                        <Run Text="ℹ Excess Overpayment (" />
                                        <Run Text="{Binding LedgerCreditExcessAmount, StringFormat={}{0:N2}, Mode=OneWay}" />
                                        <Run Text=") will be recorded as Advance Supplier Ledger Credit." />
                                    </TextBlock>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock FontSize="11.5" Foreground="#475569">
                                        <Run Text="🗄 Cash Drawer Status: " FontWeight="SemiBold" />
                                        <Run Text="{Binding OpenCashDrawerBalance, StringFormat=Expected {0:N2}, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right: SubTotal, Discount (% & Amt), Tax (% & Amt), Net Total & Save Button -->
                        <Border Grid.Column="2"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Rows Sub-Total" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock Text="{Binding RowsTotal, StringFormat={}{0:N2}}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Invoice Discount (% and Amt bi-directional) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Discount (% / Amt)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBox x:Name="FooterDiscountPctTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource FormInputTextBoxStyle}"
                                             Height="32"
                                             TextAlignment="Right"
                                             Text="{Binding DiscountPctText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                             PreviewKeyDown="FooterDiscountPctTextBox_OnPreviewKeyDown" />
                                    <TextBox Grid.Column="3"
                                             Style="{StaticResource FormInputTextBoxStyle}"
                                             Height="32"
                                             TextAlignment="Right"
                                             Text="{Binding DiscountAmtText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                             PreviewKeyDown="FooterDiscountAmtTextBox_OnPreviewKeyDown" />
                                </Grid>

                                <!-- Invoice Tax (% and Amt bi-directional) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tax (% / Amt)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBox x:Name="FooterTaxPctTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource FormInputTextBoxStyle}"
                                             Height="32"
                                             TextAlignment="Right"
                                             Text="{Binding TaxPctText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                             PreviewKeyDown="FooterTaxPctTextBox_OnPreviewKeyDown" />
                                    <TextBox Grid.Column="3"
                                             Style="{StaticResource FormInputTextBoxStyle}"
                                             Height="32"
                                             TextAlignment="Right"
                                             Text="{Binding TaxAmtText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                             PreviewKeyDown="FooterTaxAmtTextBox_OnPreviewKeyDown" />
                                </Grid>

                                <!-- Grand Net Total Banner -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock Text="NET TOTAL AMOUNT" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A">
                                            <Run Text="{Binding CurrencySymbol, Mode=OneWay}" />
                                            <Run Text="{Binding TotalAmount, StringFormat={}{0:N2}, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button x:Name="SaveInvoiceFooterButton"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        Height="40"
                                        Command="{Binding SaveInvoiceCommand}"
                                        Content="{Binding SaveButtonLabel}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODE 3: PURCHASE INVOICE DETAIL / VOUCHER VIEW (/purchase-invoices/X) -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDetailMode, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,28">
                    <!-- Detail Action Toolbar -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource OutlineBtnStyle}" Command="{Binding BackToDirectoryCommand}" Content="← Back to Invoices" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0" Command="{Binding PrintCurrentDetailA4Command}" Content="🖨 Print A4 (Ctrl+P)" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0" Command="{Binding PrintCurrentDetailThermalCommand}" Content="🧾 Thermal 80mm" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0" Command="{Binding SendCurrentDetailToBarcodeStudioCommand}" Content="🏷 Print Barcodes" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0" Command="{Binding OpenCurrentDetailHistoryCommand}" Content="🕒 Audit History" />
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,6,0"
                                        IsEnabled="{Binding CanMutateCurrentDetail}"
                                        Command="{Binding EditCurrentDetailCommand}"
                                        Content="✎ Edit (Alt+E)" />
                                <Button Style="{StaticResource DangerBtnStyle}" Margin="0,0,6,0"
                                        IsEnabled="{Binding CanMutateCurrentDetail}"
                                        Command="{Binding OpenReverseForCurrentDetailCommand}"
                                        Content="↺ Reverse / Void" />
                                <Button Style="{StaticResource DangerBtnStyle}" Margin="0,0,8,0"
                                        Command="{Binding OpenDeleteForCurrentDetailCommand}"
                                        Content="🗑 Delete" />
                                <Button Style="{StaticResource PrimaryBtnStyle}"
                                        Command="{Binding GoToCreateFormCommand}"
                                        Content="+ New (Alt+N)" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Reversed Banner (if reversed) -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDetail.Status}" Value="reversed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="⚠ THIS PURCHASE INVOICE HAS BEEN REVERSED (VOIDED)" FontSize="13" FontWeight="Bold" Foreground="#B91C1C" />
                            <TextBlock FontSize="12" Foreground="#991B1B" Margin="0,3,0,0">
                                <Run Text="Reason: " FontWeight="Bold" />
                                <Run Text="{Binding CurrentDetail.ReversalReason, Mode=OneWay}" />
                                <Run Text=" • Reversed By: " FontWeight="Bold" />
                                <Run Text="{Binding CurrentDetail.ReversedByName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Main GRN Voucher Sheet -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="24,20">
                        <StackPanel>
                            <!-- Voucher Header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding StoreSettings.StoreName}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding StoreSettings.Address}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding StoreSettings.PhoneNumber}" FontSize="12" Foreground="#64748B" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="PURCHASE INVOICE (GRN)" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding CurrentDetail.PostedNumber}" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Right" />
                                    <TextBlock FontSize="12" Foreground="#475569" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <Run Text="Posted Date: " FontWeight="SemiBold" />
                                        <Run Text="{Binding CurrentDetail.PostedDate, StringFormat={}{0:dd-MM-yyyy}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Metadata Strip -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                                <UniformGrid Columns="5">
                                    <StackPanel>
                                        <TextBlock Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding CurrentDetail.SupplierName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding CurrentDetail.SupplierPhone}" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SUPPLIER INVOICE #" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding CurrentDetail.InvoiceNumber}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="INVOICE TYPE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding CurrentDetail.InvoiceType}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="DUE DATE &amp; RETURN POLICY" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding CurrentDetail.DueDate, StringFormat={}{0:dd-MM-yyyy}}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding CurrentDetail.SupplierExpiryPolicyLabel}" FontSize="10.5" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PAYMENT ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding CurrentDetail.AccountName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding CurrentDetail.PaymentMethod}" FontSize="10.5" Foreground="#64748B" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <!-- Detail Items Table Header -->
                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1" CornerRadius="8,8,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="PRODUCT" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="2" Text="BATCH" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="3" Text="EXPIRY" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="4" Text="SIZE" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="PAID U" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="BONUS" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="UNIT COST" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="8" Text="DISC%" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="9" Text="UNIT SALE" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="10" Text="MRG%" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="11" Text="NET TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CurrentDetail.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="12,8">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="95" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="75" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="105" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding LineOrder}" FontSize="11.5" Foreground="#64748B" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding ProductCode}" FontSize="10.5" Foreground="#64748B" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Batch}" FontSize="12" FontFamily="Consolas" Foreground="#334155" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Expiry, StringFormat={}{0:dd-MM-yyyy}}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding PackSize}" FontSize="12" Foreground="#475569" TextAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding UnitQuantity}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding UnitBonus}" FontSize="12" Foreground="#059669" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="{Binding UnitPurchasePrice, StringFormat={}{0:N2}}" FontSize="12" Foreground="#334155" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="8" Text="{Binding ItemDiscountPercentage, StringFormat={}{0:0.##}%}" FontSize="12" Foreground="#475569" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="9" Text="{Binding UnitSalePrice, StringFormat={}{0:N2}}" FontSize="12" Foreground="#059669" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="10" Text="{Binding Margin, StringFormat={}{0:0.##}%}" FontSize="12" Foreground="#475569" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="11" Text="{Binding SubTotal, StringFormat={}{0:N2}}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Detail Totals Summary -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="340" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Remarks:" FontSize="11.5" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Text="{Binding CurrentDetail.Remarks}" FontSize="12.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,4,24,0" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                    <StackPanel>
                                        <Grid Margin="0,2"><TextBlock Text="Gross Total" Foreground="#475569" /><TextBlock Text="{Binding CurrentDetail.GrossTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                                        <Grid Margin="0,2"><TextBlock Text="Discount" Foreground="#475569" /><TextBlock Text="{Binding CurrentDetail.DiscountAmount, StringFormat=-{0:N2}}" Foreground="#DC2626" HorizontalAlignment="Right" /></Grid>
                                        <Grid Margin="0,2"><TextBlock Text="Tax" Foreground="#475569" /><TextBlock Text="{Binding CurrentDetail.TaxAmount, StringFormat=+{0:N2}}" HorizontalAlignment="Right" /></Grid>
                                        <Border Height="1" Background="#CBD5E1" Margin="0,6" />
                                        <Grid Margin="0,2"><TextBlock Text="Net Total" FontSize="14" FontWeight="Bold" Foreground="#0F172A" /><TextBlock Text="{Binding CurrentDetail.TotalAmount, StringFormat={}{0:N2}}" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Right" /></Grid>
                                        <Grid Margin="0,2"><TextBlock Text="Supplier Bill Amt" Foreground="#64748B" /><TextBlock Text="{Binding CurrentDetail.InvoiceAmount, StringFormat={}{0:N2}}" HorizontalAlignment="Right" /></Grid>
                                        <Grid Margin="0,2"><TextBlock Text="Total Paid" Foreground="#059669" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentDetail.TotalPaid, StringFormat={}{0:N2}}" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                        <Grid Margin="0,2"><TextBlock Text="Balance Payable" Foreground="#D97706" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentDetail.RemainingAmount, StringFormat={}{0:N2}}" Foreground="#D97706" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 1: FAST PRODUCT SEARCH & BARCODE SCANNER MODAL                -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsProductSearchModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#660F172A"
              Panel.ZIndex="100">
            <Border Width="820"
                    MaxHeight="580"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Select Product or Scan Barcode" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right" Padding="8,4" Command="{Binding CloseProductSearchModalCommand}" Content="Esc • Close" />
                    </Grid>

                    <TextBox x:Name="ProductModalSearchTextBox"
                             Grid.Row="1"
                             Style="{StaticResource FormInputTextBoxStyle}"
                             Height="38"
                             FontSize="13.5"
                             Margin="0,0,0,10"
                             Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="ProductModalSearchTextBox_OnPreviewKeyDown" />

                    <ListBox x:Name="ProductModalResultsListBox"
                             Grid.Row="2"
                             ItemsSource="{Binding ProductSearchResults}"
                             SelectedItem="{Binding HighlightedSearchProduct, Mode=TwoWay}"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"
                             MaxHeight="390"
                             MouseDoubleClick="ProductModalResultsListBox_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductCode}" FontSize="11.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="6,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock FontSize="10.5" Foreground="#64748B">
                                            <Run Text="{Binding BrandName, Mode=OneWay}" />
                                            <Run Text=" • Rack: " />
                                            <Run Text="{Binding Rack, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PackSize, StringFormat=1×{0}}" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat=Stk: {0}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding PackPurchasePrice, StringFormat=Cost: {0:N2}}" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{Binding PackSalePrice, StringFormat=Sale: {0:N2}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="↑ / ↓ to highlight • Enter or Double-Click to select product into row" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryBtnStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding CommitProductSelectionCommand}"
                                Content="Select Highlighted Product (Enter)" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 2: HELD PURCHASE DRAFTS MODAL (Alt+D)                         -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDraftsModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#660F172A"
              Panel.ZIndex="105">
            <Border Width="680" MaxHeight="520" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Held Purchase Drafts" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right" Command="{Binding CloseHeldDraftsModalCommand}" Content="Close" />
                    </Grid>

                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldDrafts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" Background="#F8FAFC">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DraftNumber}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" />
                                                    <TextBlock Text="{Binding SupplierName, StringFormat= — {0}}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <TextBlock FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" items • Total: " />
                                                    <Run Text="{Binding TotalAmount, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text=" • Updated: " /><Run Text="{Binding FormattedUpdatedAt, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryBtnStyle}" Padding="10,5" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ResumeHeldDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Content="Resume" />
                                                <Button Style="{StaticResource DangerBtnStyle}" Padding="8,5"
                                                        Command="{Binding DataContext.DeleteHeldDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Content="Discard" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 3: PRE-SHIFT CASH DRAWER PROMPT MODAL                         -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsPreShiftPromptOpen, Converter={StaticResource BoolToVis}}"
              Background="#660F172A"
              Panel.ZIndex="110">
            <Border Width="520" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="🗄 Pre-Shift Cash Invoice Edit" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding PreShiftPromptMessage}" FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,10,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CancelPreShiftPromptCommand}" Content="Cancel" />
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding ConfirmPreShiftKeepDrawerCommand}" Content="No, Keep Drawer As-Is" />
                        <Button Style="{StaticResource PrimaryBtnStyle}" Command="{Binding ConfirmPreShiftUpdateDrawerCommand}" Content="Yes, Adjust Current Drawer" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 4: DOCUMENT AUDIT HISTORY MODAL                               -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#660F172A"
              Panel.ZIndex="115">
            <Border Width="680" MaxHeight="520" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding HistoryModalTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right" Command="{Binding CloseHistoryModalCommand}" Content="Close" />
                    </Grid>
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistoryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" Background="#F8FAFC">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding ActionBadge}" FontSize="12.5" FontWeight="Bold" Foreground="#1E40AF" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="#64748B">
                                                    <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding FormattedTimestamp, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding ChangesSummary}" FontSize="12" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,4,0,2" />
                                            <TextBlock Text="{Binding Reason, StringFormat=Reason: {0}}" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 5: REVERSE / VOID PURCHASE INVOICE MODAL                      -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsReverseModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#660F172A"
              Panel.ZIndex="120">
            <Border Width="480" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ReverseTargetPostedNumber, StringFormat=Reverse Purchase Invoice {0}}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" />
                    <TextBlock Text="Reversing voids this invoice while preserving its audit trail. Received stock, weighted average cost, supplier ledger payable, and cash/account balances will be rolled back."
                               FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,12" />

                    <TextBlock Text="Reversal Reason * (min 3 chars)" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="ReverseReasonTextBox"
                             Style="{StaticResource FormInputTextBoxStyle}"
                             Text="{Binding ReverseReason, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding ReverseModalError}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseReverseModalCommand}" Content="Cancel" />
                        <Button Style="{StaticResource DangerBtnStyle}" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                                Command="{Binding ConfirmReverseInvoiceCommand}" Content="Confirm Reversal" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 6: 2-STEP PASSWORD-CONFIRMED DELETE MODAL                     -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#660F172A"
              Panel.ZIndex="125">
            <Border Width="460" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteTargetPostedNumber, StringFormat=Permanently Delete {0}?}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" />

                    <!-- Step 1 -->
                    <StackPanel Visibility="{Binding IsDeleteStep1, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock Text="Warning: Permanent deletion removes this invoice record completely and reverses all unreversed stock, ledger, and payment account entries. Prefer 'Reverse / Void' if you want to keep an audit trail."
                                   FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseDeleteModalCommand}" Content="Cancel" />
                            <Button Style="{StaticResource DangerBtnStyle}" Command="{Binding ProceedToDeleteStep2Command}" Content="Continue to Password Verification →" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 2 -->
                    <StackPanel Visibility="{Binding IsDeleteStep2, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock Text="Enter your login password to authorize permanent deletion:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                        <PasswordBox x:Name="DeleteConfirmPasswordBox"
                                     Height="34"
                                     Padding="8,5"
                                     FontSize="13"
                                     IsVisibleChanged="DeleteConfirmPasswordBox_OnIsVisibleChanged"
                                     PreviewKeyDown="DeleteConfirmPasswordBox_OnPreviewKeyDown"
                                     PasswordChanged="DeleteConfirmPasswordBox_OnPasswordChanged" />
                        <TextBlock Text="{Binding DeleteModalError}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseDeleteModalCommand}" Content="Cancel" />
                            <Button Style="{StaticResource DangerBtnStyle}" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                                    Command="{Binding ConfirmDeleteInvoiceCommand}" Content="Authorize &amp; Delete" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
