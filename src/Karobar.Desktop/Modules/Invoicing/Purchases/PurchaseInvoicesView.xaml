                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- Col 1: Pack Size Badge with TagIcon (ProductSearchInput.jsx:700-710) -->
                                                    <Border Grid.Column="1" Background="#CFFAFE" BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="6" Padding="8,3"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M5.5,7A1.5,1.5 0 0,1 4,5.5A1.5,1.5 0 0,1 5.5,4A1.5,1.5 0 0,1 7,5.5A1.5,1.5 0 0,1 5.5,7M21.41,11.58L12.41,2.58C12.05,2.22 11.55,2 11,2H4C2.89,2 2,2.89 2,4V11C2,11.55 2.22,12.05 2.59,12.41L11.58,21.41C11.95,21.77 12.45,22 13,22C13.55,22 14.05,21.77 14.41,21.41L21.41,14.41C21.78,14.05 22,13.55 22,13C22,12.45 21.77,11.94 21.41,11.58Z"
                                                                  Fill="#0E7490" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding PackSize}" FontSize="12" FontWeight="ExtraBold" Foreground="#0E7490" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Col 2: Qty Pill with SVG Chevron (ProductSearchInput.jsx:712-736) -->
                                                    <Border Grid.Column="2" CornerRadius="12" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E0F2FE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                        <Setter Property="Background" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="2.4" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="M6,15 L12,9 L18,15" />
                                                                        <Setter Property="Stroke" Value="#0369A1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                                <Setter Property="Data" Value="M6,9 L12,15 L18,9" />
                                                                                <Setter Property="Stroke" Value="#FFFFFF" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#0369A1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Col 3 & 4: Purchase Pack / Unit (ProductSearchInput.jsx:738-744) -->
                                                    <Border Grid.Column="3" BorderBrush="#F1F5F9" BorderThickness="1,0,0,0">
                                                        <TextBlock Text="{Binding FormattedPackPurchasePrice}" FontSize="12" FontWeight="ExtraBold" Foreground="#0E7490" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding FormattedUnitPurchasePrice}" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <!-- Col 5 & 6: Sale Pack / Unit (ProductSearchInput.jsx:746-752) -->
                                                    <Border Grid.Column="5" BorderBrush="#F1F5F9" BorderThickness="1,0,0,0">
                                                        <TextBlock Text="{Binding FormattedPackSalePrice}" FontSize="12" FontWeight="ExtraBold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="6" Text="{Binding FormattedUnitSalePrice}" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <!-- Col 7: Avg (ProductSearchInput.jsx:754-757) -->
                                                    <TextBlock Grid.Column="7" Text="{Binding FormattedAvgPrice}" FontSize="12" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <!-- Col 8: Margin % Pill (ProductSearchInput.jsx:759-764) -->
                                                    <Border Grid.Column="8" Background="#D1FAE5" CornerRadius="12" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MarginBadgeText}" FontSize="11.5" FontWeight="ExtraBold" Foreground="#047857" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Empty State (ProductSearchInput.jsx:613-617) -->
                                    <StackPanel Visibility="{Binding ShowEmptyProductSearchState, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5Z"
                                              Fill="#94A3B8" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="No products found" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Footer Toolbar (.product-search-footer in ProductSearchInput.jsx:774-803) -->
                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="All products" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowAllProductsFooterText, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding HasProductSearchQuery, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ProductSearchResultsCount}" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text=" results for " FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{Binding ProductSearchTrimmedQueryText}" FontSize="12" FontWeight="Medium" Foreground="#64748B" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                <TextBlock Text="↑↓" FontSize="9.5" Foreground="#94A3B8" />
                                            </Border>
                                            <TextBlock Text="Navigate" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                <TextBlock Text="↵" FontSize="9.5" Foreground="#94A3B8" />
                                            </Border>
                                            <TextBlock Text="Select" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Cursor="Hand"
                                                    Command="{Binding CloseProductSearchModalCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="FooterCloseBd" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock x:Name="FooterCloseX" Text="✕" FontSize="9.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="FooterCloseTxt" Text="Close (Esc)" FontSize="10.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="FooterCloseBd" Property="Background" Value="#F43F5E" />
                                                                <Setter TargetName="FooterCloseBd" Property="BorderBrush" Value="#F43F5E" />
                                                                <Setter TargetName="FooterCloseX" Property="Foreground" Value="#FFFFFF" />
                                                                <Setter TargetName="FooterCloseTxt" Property="Foreground" Value="#FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 8-Way Resize Handles (n, s, e, w, ne, nw, se, sw) matching ProductSearchInput.jsx:487-506 -->
                        <Border Tag="n" VerticalAlignment="Top" Height="6" Margin="12,0,12,0" Background="Transparent" Cursor="SizeNS" Panel.ZIndex="30"
