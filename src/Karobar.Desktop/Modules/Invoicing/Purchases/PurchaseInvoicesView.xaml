                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#0F172A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                <Setter Property="Foreground" Value="#4338CA" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding BrandName}" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasBrand, Converter={StaticResource BoolToVis}}" />
