                                <TextBlock Text="Open" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
