                        </Border>
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="12" Style="{StaticResource ThReadOnlyStyle}">
                            <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Header Row 1 -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ThReadOnlyStyle}">
                            <TextBlock Text="PSize" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Batch" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ThReadOnlyStyle}">
                            <TextBlock Text="Exp" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource ThReadOnlyStyle}">
                            <TextBlock Text="{Binding AvailableColumnHeader}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Pack.Q" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="7" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Unit.Q" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="8" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Pack.P" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="9" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Unit.P" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
