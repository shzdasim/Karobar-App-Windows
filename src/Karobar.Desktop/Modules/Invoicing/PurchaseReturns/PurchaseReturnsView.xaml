                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="4" Background="#F8FAFC" Padding="4,3">
                                            <TextBlock Text="Unit" FontSize="10" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="4,3">
                                            <TextBlock Text="Pack" FontSize="10" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="6" Background="#F8FAFC" Padding="4,3">
                                            <TextBlock Text="Unit" FontSize="10" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

