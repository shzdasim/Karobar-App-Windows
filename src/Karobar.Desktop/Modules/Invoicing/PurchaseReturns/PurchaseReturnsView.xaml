                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#8B5CF6" Margin="0,0,12,0">
                                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                          Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ViewingDetail.PostedNumber, StringFormat='Purchase Return {0}'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding ViewingDetail.DateFormatted}" FontSize="11.5" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>

