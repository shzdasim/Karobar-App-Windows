                            </ItemsControl>

                            <!-- Compact Pagination Footer (PurchaseReturn/index.jsx:595-663) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                                <Grid>
                                    <TextBlock Text="{Binding PaginationSummaryText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowIconBtnStyle}"
                                                Command="{Binding FirstPageCommand}"
                                                IsEnabled="{Binding CanPrevPage}"
                                                ToolTip="First Page">
                                            <TextBlock Text="«" FontSize="13" FontWeight="Bold" Foreground="#334155" />
                                        </Button>
                                        <Button Style="{StaticResource RowIconBtnStyle}"
                                                Command="{Binding PreviousPageCommand}"
                                                IsEnabled="{Binding CanPrevPage}"
                                                ToolTip="Previous Page">
                                            <TextBlock Text="‹" FontSize="13" FontWeight="Bold" Foreground="#334155" />
                                        </Button>
                                        <Border Background="#2563EB" CornerRadius="6" Padding="10,4" Margin="4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentPage}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                        <Button Style="{StaticResource RowIconBtnStyle}"
                                                Command="{Binding NextPageCommand}"
                                                IsEnabled="{Binding CanNextPage}"
                                                ToolTip="Next Page">
                                            <TextBlock Text="›" FontSize="13" FontWeight="Bold" Foreground="#334155" />
                                        </Button>
                                        <Button Style="{StaticResource RowIconBtnStyle}"
                                                Command="{Binding LastPageCommand}"
                                                IsEnabled="{Binding CanNextPage}"
                                                ToolTip="Last Page">
                                            <TextBlock Text="»" FontSize="13" FontWeight="Bold" Foreground="#334155" />
