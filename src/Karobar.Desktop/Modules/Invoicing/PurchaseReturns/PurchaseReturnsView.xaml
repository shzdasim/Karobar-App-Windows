                                                                                   Text="{Binding ProductDisplayText}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="#64748B"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="Search"
                                                                               FontSize="9.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#2563EB"
                                                                               VerticalAlignment="Center"
                                                                               Margin="4,0,0,0" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding HasProduct}" Value="True">
                                                                    <Setter TargetName="ProdBd" Property="Background" Value="#EFF6FF" />
                                                                    <Setter TargetName="ProdBd" Property="BorderBrush" Value="#93C5FD" />
                                                                    <Setter TargetName="ProdIcon" Property="Fill" Value="#2563EB" />
                                                                    <Setter TargetName="ProdTitle" Property="Foreground" Value="#0F172A" />
                                                                    <Setter TargetName="ProdTitle" Property="FontWeight" Value="SemiBold" />
