                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Gross Total" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding ViewingDetail.GrossTotal, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right" />
