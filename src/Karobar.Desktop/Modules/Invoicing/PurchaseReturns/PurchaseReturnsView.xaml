                        <StackPanel Visibility="{Binding ShowEmptySupplierModalState, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32">
                            <TextBlock Text="No suppliers found" FontSize="13.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </StackPanel>
