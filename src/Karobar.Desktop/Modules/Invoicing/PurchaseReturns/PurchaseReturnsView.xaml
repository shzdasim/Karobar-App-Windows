                                        Command="{Binding PrintReturnCommand}" Content="🖨 Print" />
                                <Button Style="{StaticResource PrimaryBtnStyle}" Padding="12,5" Margin="0,0,8,0"
                                        Command="{Binding OpenEditFormCommand}" Content="✎ Edit" />
                                <Button Style="{StaticResource RowIconBtnStyle}"
                                        Command="{Binding CloseDetailModalCommand}">
                                    <TextBlock Text="✕" FontSize="12" Foreground="#64748B" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Modal Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Padding="20,16">
                            <StackPanel>
                                <!-- 4-Column Metadata Grid -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ViewingDetail.SupplierName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ORIGINAL INVOICE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ViewingDetail.PurchaseInvoicePostedNumber, TargetNullValue='Open / Direct Return'}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SETTLEMENT MODE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ViewingDetail.SettlementBadgeLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="REMARKS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ViewingDetail.Remarks, TargetNullValue='—'}" FontSize="13" Foreground="#334155" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Items Table -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                                <TextBlock Grid.Column="1" Text="PRODUCT" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                                <TextBlock Grid.Column="2" Text="BATCH" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                                <TextBlock Grid.Column="3" Text="EXPIRY" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                                <TextBlock Grid.Column="4" Text="PACK.Q" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="UNIT.Q" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                                <TextBlock Grid.Column="6" Text="UNIT.P" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                                <TextBlock Grid.Column="7" Text="DISC%" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                                <TextBlock Grid.Column="8" Text="SUB TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding ViewingDetail.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="2.5*" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="1.1*" />
