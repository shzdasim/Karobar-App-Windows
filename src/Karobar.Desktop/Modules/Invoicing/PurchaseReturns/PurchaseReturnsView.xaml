                                Command="{Binding ConfirmPreShiftUpdateDrawerCommand}" Content="Adjust Current Cash Drawer" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 6: DOCUMENT AUDIT HISTORY MODAL                               -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="640" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding HistoryModalTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right"
                                Command="{Binding CloseHistoryModalCommand}" Content="✕ Close" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistoryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#DBEAFE" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ActionBadge}" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FormattedTimestamp}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding ChangesSummary}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Right"
                                Command="{Binding CloseHistoryModalCommand}" Content="Close" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 7: PASSWORD-CONFIRMED DELETE MODAL                            -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel>
                    <TextBlock Text="{Binding DeletingRow.PostedNumber, StringFormat='Delete Purchase Return {0}'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Deleting this purchase return will restore deducted product/batch inventory and reverse the supplier ledger or cash/bank refund entry. Enter your password to confirm:"
                               FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,12" />
                    <PasswordBox x:Name="DeletePasswordBox"
                                 Height="34" Padding="8,5" FontSize="13"
                                 PasswordChanged="DeletePasswordBox_OnPasswordChanged"
                                 PreviewKeyDown="DeletePasswordBox_OnPreviewKeyDown" />
                    <TextBlock Text="{Binding DeleteErrorMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding CloseDeleteModalCommand}" Content="Cancel" />
                        <Button Style="{StaticResource DangerBtnStyle}"
                                Command="{Binding ConfirmDeleteReturnCommand}" Content="Delete Return" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
