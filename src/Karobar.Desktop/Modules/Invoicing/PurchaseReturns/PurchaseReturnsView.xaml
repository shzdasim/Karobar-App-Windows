                                <TextBlock Text="Gross Total" FontSize="10" Foreground="#64748B" />
                                <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding FormGrossTotal, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Discount % -->
                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,5">
                            <StackPanel>
                                <TextBlock Text="Discount %" FontSize="10" Foreground="#64748B" />
                                <TextBox x:Name="FooterDiscountPctTextBox"
                                         Style="{StaticResource GridCellInputStyle}"
                                         Height="26" Margin="0,3,0,0"
                                         Text="{Binding FooterDiscountPctText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                         PreviewKeyDown="FooterDiscountPctTextBox_OnPreviewKeyDown" />
                            </StackPanel>
                        </Border>

                        <!-- Discount Amount -->
                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,5">
                            <StackPanel>
                                <TextBlock Text="Discount Amount" FontSize="10" Foreground="#64748B" />
                                <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding FormDiscountAmount, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tax % -->
                        <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,5">
                            <StackPanel>
                                <TextBlock Text="Tax %" FontSize="10" Foreground="#64748B" />
                                <TextBox x:Name="FooterTaxPctTextBox"
                                         Style="{StaticResource GridCellInputStyle}"
                                         Height="26" Margin="0,3,0,0"
                                         Text="{Binding FooterTaxPctText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
