                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CloseBd" Property="Background" Value="#F43F5E" />
                                                            <Setter TargetName="CloseBd" Property="BorderBrush" Value="#F43F5E" />
                                                            <Setter TargetName="CloseX" Property="Foreground" Value="#FFFFFF" />
                                                            <Setter TargetName="CloseTxt" Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Sticky 2-Row Grouped Table Header (Exact ProductSearchInput.jsx:620-661) -->
                                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
