                        <Border Grid.Row="1" Grid.Column="10" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Disc%" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Repeater Body (Vertical Scroll Only, Zero Horizontal Scroll) -->
                <Border Grid.Row="2"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8"
                        Background="#FFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LinesItemsControl"
                                      ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF" />
