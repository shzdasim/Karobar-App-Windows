                                                     Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="ProductModalSearchTextBox_OnPreviewKeyDown" />
                                            <TextBlock Text="Search products by name, SKU, barcode, formulation, or brand..."
                                                       FontSize="14" Foreground="#94A3B8"
                                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ProductModalSearchTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
