                                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                         LostFocus="LineCellTextBox_OnLostFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown" />
                                            </Border>

                                            <!-- Col 7: Return Unit Qty -->
                                            <Border Grid.Column="7" Padding="2,0">
                                                <TextBox Tag="unit_quantity"
                                                         Style="{StaticResource GridCellInputStyle}"
                                                         Text="{Binding ReturnUnitQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                         LostFocus="LineCellTextBox_OnLostFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown" />
                                            </Border>

                                            <!-- Col 8: Pack Purchase Price -->
                                            <Border Grid.Column="8" Padding="2,0">
                                                <TextBox Tag="pack_purchase_price"
                                                         Style="{StaticResource GridCellInputStyle}"
                                                         Text="{Binding PackPurchasePriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                         LostFocus="LineCellTextBox_OnLostFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown" />
                                            </Border>

                                            <!-- Col 9: Unit Purchase Price -->
                                            <Border Grid.Column="9" Padding="2,0">
                                                <TextBox Tag="unit_purchase_price"
                                                         Style="{StaticResource GridCellInputStyle}"
                                                         Text="{Binding UnitPurchasePriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                         LostFocus="LineCellTextBox_OnLostFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown" />
                                            </Border>

                                            <!-- Col 10: Item Discount % -->
                                            <Border Grid.Column="10" Padding="2,0">
                                                <TextBox Tag="item_discount_percentage"
                                                         Style="{StaticResource GridCellInputStyle}"
                                                         Text="{Binding ItemDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericTextBox_OnGotKeyboardFocus"
                                                         PreviewMouseLeftButtonDown="NumericTextBox_OnPreviewMouseLeftButtonDown"
                                                         LostFocus="LineCellTextBox_OnLostFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown" />
                                            </Border>

                                            <!-- Col 11: Sub Total -->
                                            <Border Grid.Column="11" Margin="2,0" Style="{StaticResource SubTotalBoxStyle}">
