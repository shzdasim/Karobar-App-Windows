                                                        Height="28"
                                                        Cursor="Hand"
                                                        Click="ProductCellButton_Click"
                                                        PreviewKeyDown="ProductCellButton_PreviewKeyDown"
                                                        ToolTip="{Binding ProductDisplayText}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ProdBd"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="#CBD5E1"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="7,2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Path x:Name="ProdIcon"
                                                                          Grid.Column="0"
                                                                          Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5Z"
                                                                          Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform"
                                                                          VerticalAlignment="Center" Margin="0,0,6,0" />
