                                         Text="{Binding SupplierSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="SupplierModalSearchTextBox_OnPreviewKeyDown" />
                                <TextBlock Text="Search supplier by name or phone..."
                                           FontSize="13.5" Foreground="#94A3B8"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SupplierModalSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2"
                                    Style="{StaticResource RowIconBtnStyle}" Width="24" Height="24" Margin="6,0"
                                    Visibility="{Binding HasSupplierSearchQuery, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding ClearSupplierSearchQueryCommand}"
                                    ToolTip="Clear search">
                                <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" />
                            </Button>
                            <Border Grid.Column="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="Esc" FontFamily="Consolas" FontSize="10" Foreground="#64748B" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Results List -->
                    <Grid Grid.Row="1" MaxHeight="410">
                        <ListBox x:Name="SupplierModalResultsListBox"
                                 ItemsSource="{Binding FilteredSuppliers}"
                                 SelectedItem="{Binding SelectedSupplierInModal, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="SupplierModalResultsListBox_OnPreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBd"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#F1F5F9"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="16,12"
                                                        Cursor="Hand">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="#F8FAFC" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="RowBd" Property="BorderBrush" Value="#BFDBFE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#D1FAE5" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <Path Data="M3,21H21V19H3V21M5,17H19V7L12,3L5,7V17M9,9H11V11H9V9M13,9H15V11H13V9M9,13H11V15H9V13M13,13H15V15H13V13Z"
                                                  Fill="#059669" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                        Visibility="{Binding HasAddress, Converter={StaticResource BoolToVis}}">
                                                <Path Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"
                                                      Fill="#64748B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Address}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
