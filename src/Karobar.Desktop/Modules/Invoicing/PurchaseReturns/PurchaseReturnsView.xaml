                        </StackPanel>
                    </Grid>

                    <!-- GlassToolbar Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="16,8">
                        <Grid>
                            <TextBlock Text="{Binding InvoiceModalFooterText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                    <TextBlock Text="↑↓" FontSize="9" Foreground="#94A3B8" />
