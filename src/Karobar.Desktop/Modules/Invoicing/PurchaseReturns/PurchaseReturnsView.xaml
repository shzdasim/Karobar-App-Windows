                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel>
                    <TextBlock Text="Pre-Shift Cash Return Edit Detected" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
