                                                <TextBlock Text="{Binding ViewingDetail.Total, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="14" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Right" />
