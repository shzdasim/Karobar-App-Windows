                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLedgerSettlement}" Value="True">
                                                    <Setter TargetName="LedBd" Property="Background" Value="#EEF2FF" />
                                                    <Setter TargetName="LedBd" Property="BorderBrush" Value="#6366F1" />
                                                    <Setter TargetName="LedTxt" Property="Foreground" Value="#4338CA" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Instant Refund (Cash / Bank / Wallet) -->
                                <Button Cursor="Hand"
                                        Command="{Binding SetSettlementModeCommand}"
                                        CommandParameter="cash_refund"
                                        Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CashBd" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock x:Name="CashTxt" Text="Instant Refund (Cash / Bank / Wallet)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCashRefundSettlement}" Value="True">
                                                    <Setter TargetName="CashBd" Property="Background" Value="#ECFDF5" />
                                                    <Setter TargetName="CashBd" Property="BorderBrush" Value="#10B981" />
                                                    <Setter TargetName="CashTxt" Property="Foreground" Value="#047857" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Payment Method & Account Selectors (when Instant Refund is active) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsCashRefundSettlement, Converter={StaticResource BoolToVis}}">
                                    <local:SearchableSelect Width="148"
                                                            Margin="0,0,6,0"
                                                            ItemsSource="{Binding PaymentMethodOptions}"
                                                            SelectedItem="{Binding SelectedPaymentMethodOption, Mode=TwoWay}"
                                                            DisplayMemberPath="Label"
                                                            IsSearchable="False"
                                                            IsClearable="False" />
                                    <local:SearchableSelect Width="185"
                                                            ItemsSource="{Binding AccountOptions}"
                                                            SelectedItem="{Binding SelectedAccountOption, Mode=TwoWay}"
                                                            DisplayMemberPath="Name"
                                                            IsSearchable="True"
                                                            IsClearable="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource OutlineBtnStyle}"
                                    Padding="16,7" Margin="0,0,8,0"
                                    Command="{Binding CancelFormCommand}"
                                    Content="Cancel" />
                            <Button Style="{StaticResource SecondaryBtnStyle}"
                                    Padding="16,7" Margin="0,0,8,0"
                                    Command="{Binding SaveAndPrintReturnCommand}"
                                    Content="Save &amp; Print (Alt+P)" />
                            <Button x:Name="SaveReturnFooterButton"
                                    Style="{StaticResource PrimaryBtnStyle}"
                                    Padding="20,7"
                                    Command="{Binding SaveReturnCommand}"
                                    Content="{Binding SaveButtonText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 1: SUPPLIER SEARCH MODAL (Exact SupplierSearch.jsx            -->
        <!--          & PurchaseInvoicesView.xaml:1760-1926)                     -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsSupplierSearchModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Border Width="640" MaxHeight="540"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0"
                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16"
