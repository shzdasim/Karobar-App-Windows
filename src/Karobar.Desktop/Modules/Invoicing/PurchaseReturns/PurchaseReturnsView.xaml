                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- =================================================================== -->
        <!-- MODE 2: CREATE / EDIT PURCHASE RETURN FORM                          -->
        <!--         (Exact PurchaseReturnForm.jsx & PurchaseInvoicesView.xaml)  -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}"
              Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =============================================================== -->
            <!-- ROW 0: COMPACT BRANDED HEADER BANNER + SINGLE-ROW FIELDS CARD   -->
            <!-- =============================================================== -->
            <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel>
                    <!-- Branded Gradient Banner (PurchaseReturnForm.jsx:1697-1740) -->
                    <Border Padding="12,7" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EFF6FF" Offset="0.0" />
                                <GradientStop Color="#F5F3FF" Offset="0.55" />
                                <GradientStop Color="#FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RowIconBtnStyle}"
                                        Command="{Binding CancelFormCommand}"
                                        ToolTip="Back to Purchase Returns Directory (Esc)"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="←" FontSize="13" FontWeight="Bold" Foreground="#334155" />
                                </Button>
                                <Border Width="32" Height="32" CornerRadius="9" Background="#DBEAFE" Margin="0,0,10,0">
                                    <Path Data="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"
                                          Stroke="#2563EB" StrokeThickness="2" Stretch="Uniform"
                                          Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Purchase Return" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,8,0" />
                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="6,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="UNIT-BASED" FontSize="9" FontWeight="Bold" Foreground="#1D4ED8" />
                                        </Border>
                                        <Border Background="#D1FAE5" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormModeBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#047857" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Alt+S save · Alt+P save &amp; print · Alt+U supplier · Alt+I invoice · Enter=next · ↑/↓ rows"
                                               FontSize="10.5" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineBtnStyle}"
                                        Padding="10,5" FontSize="11"
                                        Command="{Binding AddRowCommand}"
                                        ToolTip="Add Row (Alt+A)"
                                        Margin="0,0,6,0"
                                        Content="+ Add Row" />
                                <Button Style="{StaticResource PrimaryBtnStyle}"
                                        Padding="14,5" FontSize="11.5"
                                        Command="{Binding SaveReturnCommand}"
                                        Content="{Binding HeaderSubmitButtonText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status / Validation Banner -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="12,6"
                            Visibility="{Binding HasStatusBanner, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding StatusBannerMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Style="{StaticResource RowIconBtnStyle}" Width="22" Height="22" HorizontalAlignment="Right"
                                    Command="{Binding DismissStatusBannerCommand}">
                                <TextBlock Text="✕" FontSize="10" Foreground="#DC2626" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Single-Row Header Fields Card (PurchaseReturnForm.jsx:1742-1835 & PurchaseInvoicesView.xaml:750-870) -->
                    <Border Padding="12,8" Background="#F8FAFC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.10*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2.25*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2.25*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2.35*" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Posted # -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="POSTED #" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
