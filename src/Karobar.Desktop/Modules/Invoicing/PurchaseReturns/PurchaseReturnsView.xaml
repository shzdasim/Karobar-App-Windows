<UserControl x:Class="Karobar.Desktop.Views.PurchaseReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DesignWidth="1440"
             d:DesignHeight="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <!-- =================================================================== -->
        <!-- 1. DIRECTORY VIEW (INDEX)                                           -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="↩" FontSize="20" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Purchase Returns" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            <TextBlock Text="Return purchased stock to suppliers via Debit Note (Supplier Ledger) or Instant Cash/Bank Refund" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshDirectoryCommand}"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="14,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock Text="⟳ Refresh (F5)"/>
                        </Button>
                        <Button Command="{Binding OpenCreateFormCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" FontWeight="Bold">
                            <TextBlock Text="+ New Purchase Return (Ctrl+N)"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI Summary Strip -->
            <Grid Grid.Row="1" Margin="20,12,20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL PURCHASE RETURNS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalReturnsCount, StringFormat={}{0:N0}}" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="NET RETURNED VALUE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalNetAmount, StringFormat={}{0:N2}}" FontSize="20" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="INSTANT REFUNDS (CASH/BANK)" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="{Binding TotalCashRefundAmount, StringFormat={}{0:N2}}" FontSize="20" FontWeight="ExtraBold" Foreground="#059669" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="SUPPLIER DEBIT NOTES (LEDGER)" FontSize="10" FontWeight="Bold" Foreground="#4F46E5"/>
                        <TextBlock Text="{Binding TotalLedgerCreditAmount, StringFormat={}{0:N2}}" FontSize="20" FontWeight="ExtraBold" Foreground="#4F46E5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search & Filter Bar -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="20,4,20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="POSTED #" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="DirectorySearchPostedBox"
                                 Text="{Binding FilterPostedNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 KeyDown="DirectoryFilterBox_KeyDown"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="SUPPLIER NAME" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding FilterSupplierSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 KeyDown="DirectoryFilterBox_KeyDown"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Command="{Binding SearchDirectoryCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Height="32" Padding="16,0" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock Text="Search"/>
                        </Button>
                        <Button Command="{Binding ResetDirectoryFiltersCommand}"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Height="32" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="Reset"/>
                        </Button>
                    </StackPanel>

                    <!-- Status Banner -->
                    <Border Grid.Column="3" VerticalAlignment="Center" Margin="14,0"
                            Padding="10,6" CornerRadius="6" Background="#EFF6FF">
                        <TextBlock Text="{Binding StatusBannerMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Directory DataGrid -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="20,0,20,8" ClipToBounds="True">
                <DataGrid x:Name="DirectoryGrid"
                          ItemsSource="{Binding DirectoryRows}"
                          SelectedItem="{Binding SelectedDirectoryRow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="38"
                          ColumnHeaderHeight="36"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          MouseDoubleClick="DirectoryGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RowIndex}" Width="48"/>
                        <DataGridTextColumn Header="Posted #" Binding="{Binding PostedNumber}" Width="125" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="105"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="2*"/>
                        <DataGridTextColumn Header="Purchase Inv #" Binding="{Binding InvoiceDisplay}" Width="130"/>
                        <DataGridTextColumn Header="Settlement" Binding="{Binding SettlementBadgeLabel}" Width="165"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding ItemsCount}" Width="65"/>
                        <DataGridTextColumn Header="Units" Binding="{Binding TotalReturnUnits}" Width="75"/>
                        <DataGridTextColumn Header="Gross" Binding="{Binding GrossTotal, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Disc" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="85"/>
                        <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat={}{0:N2}}" Width="85"/>
                        <DataGridTextColumn Header="Net Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="115" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Actions" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="View"
                                                Command="{Binding DataContext.ViewReturnDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                                Padding="8,3" Margin="2,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                                Padding="8,3" Margin="2,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                        <Button Content="Print"
                                                Command="{Binding DataContext.PrintReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                                Padding="8,3" Margin="2,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                        <Button Content="Del"
                                                Command="{Binding DataContext.PromptDeleteReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                                Padding="8,3" Margin="2,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pagination Footer -->
            <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#64748B">
                        <Run Text="Total Records: "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="◀ Previous" Command="{Binding PreviousPageCommand}"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="12,5" Margin="0,0,8,0" Cursor="Hand"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="8,0">
                            <Run Text="Page "/>
                            <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Content="Next ▶" Command="{Binding NextPageCommand}"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="12,5" Margin="8,0,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 2. CREATE / EDIT FORM VIEW (PurchaseReturnForm.jsx)                 -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Branded Header Banner -->
            <Border Grid.Row="0" Background="#1E3A8A" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#3B82F6" Margin="0,0,12,0">
                            <TextBlock Text="↩" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Purchase Return" FontSize="17" FontWeight="ExtraBold" Foreground="White"/>
                                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="UNIT-BASED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding FormModeBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#0F172A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Alt+S save · Alt+P save &amp; print · Alt+U supplier · Alt+I invoice · Enter=next · ↑/↓ rows"
                                       FontSize="10.5" Foreground="#BFDBFE" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CancelFormCommand}"
                                Background="#334155" Foreground="White" BorderThickness="0"
                                Padding="14,7" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock Text="← Directory (Esc)"/>
                        </Button>
                        <Button Command="{Binding SaveAndPrintReturnCommand}"
                                Background="#0D9488" Foreground="White" BorderThickness="0"
                                Padding="14,7" Margin="0,0,8,0" Cursor="Hand" FontWeight="Bold">
                            <TextBlock Text="⎙ Save &amp; Print (Alt+P)"/>
                        </Button>
                        <Button Command="{Binding SaveReturnCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="16,7" Cursor="Hand" FontWeight="Bold">
                            <TextBlock Text="{Binding SaveButtonText}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Header Fields Card -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel>
                    <!-- Error / Status Alert -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                            Visibility="{Binding IsStatusBannerError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusBannerMessage}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Posted # -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="POSTED #" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FormPostedNumber, Mode=OneWay}" IsReadOnly="True"
                                     Background="#F1F5F9" Foreground="#475569" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     ToolTip="Auto-generated on Save"/>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding FormDate}" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Supplier Trigger Button -->
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="SUPPLIER *" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"
                                           Visibility="{Binding HasSelectedSupplier, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Payable: "/>
                                    <Run Text="{Binding FormSupplierPayableBalance, StringFormat={}{0:N2}, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="SupplierTriggerButton"
                                    Command="{Binding OpenSupplierSearchModalCommand}"
                                    Height="32" HorizontalContentAlignment="Left" Padding="10,0"
                                    Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Foreground="#1E3A8A"
                                    FontWeight="SemiBold" Cursor="Hand">
                                <TextBlock Text="{Binding SupplierButtonText}" TextTrimming="CharacterEllipsis"/>
                            </Button>
                        </StackPanel>

                        <!-- Purchase Invoice Trigger Button + Clear -->
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="PURCHASE INVOICE (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="InvoiceTriggerButton"
                                        Grid.Column="0"
                                        Command="{Binding OpenInvoiceSearchModalCommand}"
                                        Height="32" HorizontalContentAlignment="Left" Padding="10,0"
                                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155"
                                        FontWeight="SemiBold" Cursor="Hand">
                                    <TextBlock Text="{Binding InvoiceButtonText}" TextTrimming="CharacterEllipsis"/>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding ClearLinkedInvoiceCommand}"
                                        Visibility="{Binding HasSelectedInvoice, Converter={StaticResource BoolToVis}}"
                                        Content="✕" Width="30" Height="32" Margin="4,0,0,0"
                                        Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                        ToolTip="Clear linked invoice (switch to Open Return)" Cursor="Hand" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>

                        <!-- Remarks -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="REMARKS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="RemarksBox"
                                     Text="{Binding FormRemarks, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 13-Column Repeater Grid -->
            <Border Grid.Row="2" Background="White" Margin="12,8" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Group Header Row -->
                    <Grid Grid.Row="0" Background="#E2E8F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="2.6*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,5">
                            <TextBlock Text="#" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="8,5">
                            <TextBlock Text="Product *" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="2" Grid.ColumnSpan="4" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,5">
                            <TextBlock Text="Pack Size / Batch / Expiry / Available Qty" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="6" Grid.ColumnSpan="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,5">
                            <TextBlock Text="Return Qty (Pack / Unit)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="8" Grid.ColumnSpan="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,5">
                            <TextBlock Text="Purchase Price (P / U)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="10" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,5">
                            <TextBlock Text="Disc %" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="11" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,5">
                            <TextBlock Text="Sub Total" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="12" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,5">
                            <TextBlock Text="+" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Column Sub-Header Row -->
                    <Grid Grid.Row="1" Background="#F1F5F9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="2.6*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Del" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="8,4">
                            <TextBlock Text="Click or press Enter / F2 to search" FontSize="10" Foreground="#64748B"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="PSize" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Batch (F3)" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Exp" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="5" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="{Binding AvailableColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="6" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Pack.Q" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="7" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Unit.Q" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="8" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Pack.P" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="9" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Unit.P" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="10" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Disc%" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="11" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="2,4">
                            <TextBlock Text="Sub Total" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="12" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="2,4">
                            <TextBlock Text="Add" FontSize="10" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Repeater Lines ScrollViewer -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LinesRepeater" ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="White">
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="2.6*"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Delete Row Button -->
                                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                                <Button Content="🗑"
                                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                                        Cursor="Hand" FontSize="12" ToolTip="Remove item"/>
                                            </Border>

                                            <!-- Product Trigger Button -->
                                            <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <Button Tag="product"
                                                        Click="ProductCellButton_Click"
                                                        PreviewKeyDown="ProductCellButton_PreviewKeyDown"
                                                        HorizontalContentAlignment="Left" Padding="6,0"
                                                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                                        Foreground="#0F172A" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                                    <TextBlock Text="{Binding ProductDisplayText}" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </Border>

                                            <!-- Pack Size (ReadOnly) -->
                                            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#F1F5F9" Padding="4,0">
                                                <TextBlock Text="{Binding PackSize}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           FontSize="11.5" Foreground="#475569"/>
                                            </Border>

                                            <!-- Batch Trigger Button -->
                                            <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <Button Tag="batch"
                                                        Click="BatchCellButton_Click"
                                                        PreviewKeyDown="BatchCellButton_PreviewKeyDown"
                                                        HorizontalContentAlignment="Left" Padding="5,0"
                                                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                                        Foreground="#1E293B" FontSize="11" Cursor="Hand">
                                                    <TextBlock Text="{Binding BatchDisplayText}" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </Border>

                                            <!-- Expiry (ReadOnly MM/yyyy) -->
                                            <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#F1F5F9" Padding="4,0">
                                                <TextBlock Text="{Binding ExpiryFormatted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="11" Foreground="#475569"/>
                                            </Border>

                                            <!-- Available / Returnable Units (ReadOnly) -->
                                            <Border Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#F1F5F9" Padding="4,0">
                                                <TextBlock Text="{Binding AvailableUnits}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            </Border>

                                            <!-- Return Pack Qty -->
                                            <Border Grid.Column="6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <TextBox Tag="pack_quantity"
                                                         Text="{Binding ReturnPackQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                         FontSize="11.5" Padding="4,0"
                                                         GotFocus="LineTextBox_GotFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown"/>
                                            </Border>

                                            <!-- Return Unit Qty -->
                                            <Border Grid.Column="7" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <TextBox Tag="unit_quantity"
                                                         Text="{Binding ReturnUnitQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                         FontSize="11.5" Padding="4,0"
                                                         GotFocus="LineTextBox_GotFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown"/>
                                            </Border>

                                            <!-- Pack Purchase Price -->
                                            <Border Grid.Column="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <TextBox Tag="pack_purchase_price"
                                                         Text="{Binding PackPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                         FontSize="11.5" Padding="4,0"
                                                         GotFocus="LineTextBox_GotFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown"/>
                                            </Border>

                                            <!-- Unit Purchase Price -->
                                            <Border Grid.Column="9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <TextBox Tag="unit_purchase_price"
                                                         Text="{Binding UnitPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                         FontSize="11.5" Padding="4,0"
                                                         GotFocus="LineTextBox_GotFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown"/>
                                            </Border>

                                            <!-- Item Discount % -->
                                            <Border Grid.Column="10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="2">
                                                <TextBox Tag="item_discount"
                                                         Text="{Binding ItemDiscountPercentage, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                         FontSize="11.5" Padding="4,0"
                                                         GotFocus="LineTextBox_GotFocus"
                                                         PreviewKeyDown="LineTextBox_PreviewKeyDown"/>
                                            </Border>

                                            <!-- Sub Total (ReadOnly) -->
                                            <Border Grid.Column="11" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#F1F5F9" Padding="6,0">
                                                <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N2}}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            </Border>

                                            <!-- Add Row Button -->
                                            <Border Grid.Column="12">
                                                <Button Content="+"
                                                        Command="{Binding DataContext.AddRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Background="Transparent" Foreground="#059669" BorderThickness="0"
                                                        FontWeight="ExtraBold" FontSize="14" Cursor="Hand" ToolTip="Add row (Alt+A)"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Sticky Bottom Footer (6 Summary Cards + Settlement Outcome Selector) -->
            <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel>
                    <!-- 6 Totals Cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Gross Total" FontSize="10" Foreground="#64748B"/>
                                <TextBox Text="{Binding FormGrossTotal, StringFormat={}{0:F2}, Mode=OneWay}" IsReadOnly="True"
                                         Background="#F1F5F9" Height="26" VerticalContentAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Discount %" FontSize="10" Foreground="#64748B"/>
                                <TextBox Text="{Binding FormDiscountPercentage, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Discount Amount" FontSize="10" Foreground="#64748B"/>
                                <TextBox Text="{Binding FormDiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#F1F5F9" Height="26" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Tax %" FontSize="10" Foreground="#64748B"/>
                                <TextBox Text="{Binding FormTaxPercentage, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Tax Amount" FontSize="10" Foreground="#64748B"/>
                                <TextBox Text="{Binding FormTaxAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#F1F5F9" Height="26" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Total" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                <TextBox Text="{Binding FormTotal, StringFormat={}{0:F2}, Mode=OneWay}" IsReadOnly="True"
                                         Background="White" Foreground="#DC2626" FontWeight="ExtraBold" Height="26" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Settlement Outcome Selector + Action Buttons -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SETTLEMENT OUTCOME:" FontSize="10" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <Button Command="{Binding SetSettlementModeCommand}" CommandParameter="credit_note"
                                        Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                        Background="#EEF2FF" Foreground="#4338CA" BorderBrush="#6366F1" BorderThickness="1">
                                    <TextBlock Text="Adjust Supplier Ledger (Debit Note)"/>
                                </Button>

                                <Button Command="{Binding SetSettlementModeCommand}" CommandParameter="invoice_offset"
                                        Visibility="{Binding CanSelectInvoiceOffset, Converter={StaticResource BoolToVis}}"
                                        Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                        Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#8B5CF6" BorderThickness="1">
                                    <TextBlock Text="Offset Linked Credit Invoice"/>
                                </Button>

                                <Button Command="{Binding SetSettlementModeCommand}" CommandParameter="cash_refund"
                                        Padding="10,5" Margin="0,0,10,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                        Background="#ECFDF5" Foreground="#047857" BorderBrush="#10B981" BorderThickness="1">
                                    <TextBlock Text="Instant Refund (Cash / Bank / Wallet)"/>
                                </Button>

                                <Border Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormSettlementMode}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Payment Method & Account when Instant Refund is active -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsCashRefundSettlement, Converter={StaticResource BoolToVis}}">
                                    <ComboBox SelectedValue="{Binding FormPaymentMethod}" SelectedValuePath="Tag"
                                              Width="145" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Cash (Drawer)" Tag="cash"/>
                                        <ComboBoxItem Content="Bank Transfer" Tag="bank_transfer"/>
                                        <ComboBoxItem Content="Card / POS" Tag="card"/>
                                        <ComboBoxItem Content="Mobile Wallet" Tag="mobile_wallet"/>
                                    </ComboBox>

                                    <ComboBox ItemsSource="{Binding PaymentAccounts}"
                                              SelectedValue="{Binding FormAccountId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Width="200" Height="28" VerticalContentAlignment="Center"
                                              ToolTip="Deposit Account (leave blank for Auto)"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding CancelFormCommand}"
                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Padding="18,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold">
                                <TextBlock Text="Cancel"/>
                            </Button>
                            <Button Command="{Binding SaveReturnCommand}"
                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                    Padding="24,8" Cursor="Hand" FontWeight="Bold">
                                <TextBlock Text="{Binding SaveButtonText}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 3. SUPPLIER SEARCH MODAL                                            -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsSupplierSearchModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Width="640" MaxHeight="560" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Select Supplier" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        <Button Content="✕" Command="{Binding CloseSupplierSearchModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <TextBox x:Name="SupplierModalSearchBox"
                             Grid.Row="1"
                             Text="{Binding SupplierSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10"
                             PreviewKeyDown="SupplierModalSearchBox_PreviewKeyDown"/>

                    <DataGrid x:Name="SupplierModalGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding FilteredSuppliers}"
                              SelectedItem="{Binding SelectedSupplierInModal}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="34"
                              MouseDoubleClick="SupplierModalGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Payable Balance" Binding="{Binding CurrentPayableBalance, StringFormat={}{0:N2}}" Width="130" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="↑↓ Navigate · Enter Select · Esc Close" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,14,0"/>
                        <Button Content="Select Supplier" Command="{Binding SelectSupplierFromModalCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,7" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 4. PURCHASE INVOICE SEARCH MODAL (PurchaseInvoiceSearch.jsx)        -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsInvoiceSearchModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="105">
            <Border Width="760" MaxHeight="600" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Search Purchase Invoice (Optional — Link Return to Invoice)" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        <Button Content="✕" Command="{Binding CloseInvoiceSearchModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <TextBox x:Name="InvoiceModalSearchBox"
                             Grid.Row="1"
                             Text="{Binding InvoiceSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10"
                             PreviewKeyDown="InvoiceModalSearchBox_PreviewKeyDown"/>

                    <DataGrid x:Name="InvoiceModalGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding InvoiceSearchResults}"
                              SelectedItem="{Binding SelectedInvoiceInModal}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="36"
                              MouseDoubleClick="InvoiceModalGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Posted #" Binding="{Binding PostedNumber}" Width="125" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Bill / Inv #" Binding="{Binding InvoiceNumber}" Width="115"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PostedDateFormatted}" Width="105"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding InvoiceTypeBadge}" Width="85"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="105" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="↑↓ Navigate · Enter Select · Esc Close" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,14,0"/>
                        <Button Content="Select Invoice" Command="{Binding SelectInvoiceFromModalCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,7" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 5. DRAGGABLE & RESIZABLE PRODUCT SEARCH MODAL                       -->
        <!-- =================================================================== -->
        <Canvas Visibility="{Binding IsProductSearchModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="110" Background="#40000000">
            <Border x:Name="ProductModalDialog"
                    Canvas.Left="220" Canvas.Top="110"
                    Width="860" Height="520"
                    MinWidth="540" MinHeight="340"
                    Background="White" CornerRadius="10" BorderBrush="#94A3B8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Draggable Header -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="9,9,0,0" Padding="14,9" Cursor="SizeAll"
                            MouseLeftButtonDown="ProductModalHeader_MouseLeftButtonDown"
                            MouseMove="ProductModalHeader_MouseMove"
                            MouseLeftButtonUp="ProductModalHeader_MouseLeftButtonUp">
                        <Grid>
                            <TextBlock Text="Select Product for Purchase Return (Drag header to move · Drag bottom-right corner to resize)"
                                       FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding CloseProductSearchModalCommand}" HorizontalAlignment="Right"
                                    Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="12,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <TextBox x:Name="ProductModalSearchBox"
                                 Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" VerticalContentAlignment="Center" Padding="10,0"
                                 PreviewKeyDown="ProductModalSearchBox_PreviewKeyDown"/>
                    </Border>

                    <DataGrid x:Name="ProductModalGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding ProductSearchResults}"
                              SelectedItem="{Binding SelectedProductInModal}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="34"
                              BorderThickness="0"
                              MouseDoubleClick="ProductModalGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="95"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Pack Size" Binding="{Binding PackSize}" Width="75"/>
                            <DataGridTextColumn Header="Avail / Returnable" Binding="{Binding DisplayAvailableUnits}" Width="125" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Pack Cost" Binding="{Binding PackPurchasePrice, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitPurchasePrice, StringFormat={}{0:N4}}" Width="100"/>
                            <DataGridTextColumn Header="Rack" Binding="{Binding Rack}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <TextBlock Text="↑↓ Navigate · Enter Select · Esc Close" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Select Product" Command="{Binding SelectProductFromModalCommand}"
                                        Background="#2563EB" Foreground="White" BorderThickness="0" Padding="14,6" FontWeight="Bold" Cursor="Hand"/>
                                <Thumb Width="16" Height="16" Margin="10,0,0,0" Cursor="SizeNWSE"
                                       DragDelta="ProductModalResizeThumb_DragDelta" ToolTip="Drag to resize"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Canvas>

        <!-- =================================================================== -->
        <!-- 6. BATCH SEARCH MODAL                                               -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsBatchSearchModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="115">
            <Border Width="620" MaxHeight="500" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Select Batch or Unassigned Stock" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        <Button Content="✕" Command="{Binding CloseBatchSearchModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <TextBox x:Name="BatchModalSearchBox"
                             Grid.Row="1"
                             Text="{Binding BatchSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10"
                             PreviewKeyDown="BatchModalSearchBox_PreviewKeyDown"/>

                    <DataGrid x:Name="BatchModalGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding BatchSearchResults}"
                              SelectedItem="{Binding SelectedBatchInModal}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="34"
                              MouseDoubleClick="BatchModalGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Batch" Binding="{Binding DisplayBatchNumber}" Width="*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryFormatted}" Width="100"/>
                            <DataGridTextColumn Header="Available Units" Binding="{Binding AvailableUnits}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Pack Cost" Binding="{Binding PackPurchasePrice, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitPurchasePrice, StringFormat={}{0:N4}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="↑↓ Navigate · Enter Select · Esc Close" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,14,0"/>
                        <Button Content="Select Batch" Command="{Binding SelectBatchFromModalCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,7" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 7. VIEW PURCHASE RETURN DETAIL MODAL                                -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="120">
            <Border Width="920" MaxHeight="720" Background="White" CornerRadius="14" BorderBrush="#CBD5E1" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Purchase Return Details — " FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding ViewingDetail.PostedNumber}" FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="History" Command="{Binding OpenHistoryModalCommand}"
                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="⎙ Print" Command="{Binding PrintReturnCommand}"
                                    Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="✎ Edit" Command="{Binding OpenEditFormCommand}"
                                    Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Close" Command="{Binding CloseDetailModalCommand}"
                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Padding="12,6" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Metadata Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ViewingDetail.SupplierName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="RETURN DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ViewingDetail.DateFormatted}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="LINKED INVOICE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ViewingDetail.PurchaseInvoicePostedNumber, TargetNullValue='Open Return'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SETTLEMENT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ViewingDetail.SettlementBadgeLabel}" FontSize="13" FontWeight="Bold" Foreground="#4F46E5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Items Table -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ViewingDetail.Items}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="110"/>
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryFormatted}" Width="85"/>
                            <DataGridTextColumn Header="Return Pack" Binding="{Binding ReturnPackQuantity, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="Return Units" Binding="{Binding ReturnUnitQuantity}" Width="95" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPurchasePrice, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Disc %" Binding="{Binding ItemDiscountPercentage, StringFormat={}{0:N2}%}" Width="80"/>
                            <DataGridTextColumn Header="Sub Total" Binding="{Binding SubTotal, StringFormat={}{0:N2}}" Width="110" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary Totals -->
                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="{Binding ViewingDetail.Remarks}" VerticalAlignment="Center" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Gross: " Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewingDetail.GrossTotal, StringFormat={}{0:N2}}" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Discount: " Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewingDetail.DiscountAmount, StringFormat={}{0:N2}}" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tax: " Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewingDetail.TaxAmount, StringFormat={}{0:N2}}" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Net Return Total: " FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewingDetail.Total, StringFormat={}{0:N2}}" FontSize="15" FontWeight="ExtraBold" Foreground="#DC2626" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 8. DOCUMENT HISTORY MODAL                                           -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="125">
            <Border Width="700" MaxHeight="520" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Document Audit History" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        <Button Content="✕" Command="{Binding CloseHistoryModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryEntries}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90" FontWeight="Bold"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="Summary" Binding="{Binding ChangesSummary}" Width="*"/>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAt}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 9. PRE-SHIFT CASH DRAWER EDIT PROMPT MODAL                          -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsPreShiftModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="130">
            <Border Width="520" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Pre-Shift Purchase Return Edit Detected" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    <TextBlock Text="This purchase return was created before the current cash drawer shift opened. How should the cash refund difference be handled?"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#475569" Margin="0,8,0,12"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="#334155">
                                <Run Text="Previous Cash Refund: "/>
                                <Run Text="{Binding PreShiftCheck.OldCashAmount, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#334155" Margin="0,4,0,0">
                                <Run Text="New Cash Refund: "/>
                                <Run Text="{Binding PreShiftCheck.NewCashAmount, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#2563EB" Margin="0,4,0,0">
                                <Run Text="Net Drawer Delta: "/>
                                <Run Text="{Binding PreShiftCheck.CashDelta, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="ExtraBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding ClosePreShiftModalCommand}"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="Historical Only (Keep Current Drawer)" Command="{Binding ConfirmPreShiftKeepHistoricalCommand}"
                                Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button Content="Update Current Drawer" Command="{Binding ConfirmPreShiftUpdateDrawerCommand}"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="14,7" Cursor="Hand" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 10. PASSWORD-CONFIRMED DELETE MODAL                                 -->
        <!-- =================================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="135">
            <Border Width="440" Background="White" CornerRadius="12" BorderBrush="#FECACA" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Delete Purchase Return" FontSize="16" FontWeight="ExtraBold" Foreground="#DC2626"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#475569" Margin="0,6,0,12">
                        <Run Text="Deleting "/>
                        <Run Text="{Binding DeletingRow.PostedNumber, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" will restore returned stock back to inventory and unwind its refund/ledger settlement. Enter your password to confirm:"/>
                    </TextBlock>

                    <TextBox x:Name="DeletePasswordBox"
                             Text="{Binding DeletePassword, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding DeleteErrorMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseDeleteModalCommand}"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="14,7" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="Confirm Delete" Command="{Binding ConfirmDeleteReturnCommand}"
                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                Padding="16,7" Cursor="Hand" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
