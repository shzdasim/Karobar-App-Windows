                                            </Border>

                                            <!-- Col 3: Batch (Same local:SearchableSelect component as PurchaseInvoicesView.xaml:1130-1142) -->
                                            <Border Grid.Column="3" Padding="2,0">
                                                <local:SearchableSelect Tag="batch"
                                                                        ItemsSource="{Binding RowBatches}"
                                                                        SelectedItem="{Binding SelectedBatchOption, Mode=TwoWay}"
                                                                        Text="{Binding BatchText, Mode=TwoWay}"
                                                                        DisplayMemberPath="DisplayBatchNumber"
                                                                        Placeholder="Select batch..."
                                                                        IsCreatable="False"
                                                                        IsClearable="False"
                                                                        EnterCommitted="LineBatchSelect_OnEnterCommitted" />
                                            </Border>

                                            <!-- Col 4: Exp (ReadOnly) -->
                                            <Border Grid.Column="4" Margin="2,0" Style="{StaticResource ReadOnlyBoxStyle}">
                                                <TextBlock Text="{Binding ExpiryFormatted}" FontFamily="Consolas" FontSize="10.5" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Col 5: Available / Returnable Units (ReadOnly) -->
                                            <Border Grid.Column="5" Margin="2,0" Style="{StaticResource ReadOnlyBoxStyle}">
                                                <TextBlock Text="{Binding AvailableUnits}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
