                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Col 12: Add Row Button (+) -->
                                            <Button Grid.Column="12"
                                                    Style="{StaticResource RowIconBtnStyle}"
                                                    Width="24" Height="26"
                                                    ToolTip="Add item"
                                                    Command="{Binding DataContext.AddRowCommand, ElementName=PurchaseReturnsRoot}">
                                                <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#2563EB" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- =============================================================== -->
            <!-- ROW 2: STICKY COMPACT FOOTER (PurchaseReturnForm.jsx:2064-2225) -->
            <!-- =============================================================== -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="10,8">
                <StackPanel>
                    <!-- 6-Column Financial Summary Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.15*" />
