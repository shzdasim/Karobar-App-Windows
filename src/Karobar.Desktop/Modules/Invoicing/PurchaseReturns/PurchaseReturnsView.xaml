<UserControl x:Class="Karobar.Desktop.Views.PurchaseReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Karobar.Desktop.Views"
             x:Name="PurchaseReturnsRoot"
             Background="#F8FAFC"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Primary Action Button (#3B82F6 -> #2563EB) -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button (#8B5CF6 -> #7C3AED) -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#8B5CF6" />
            <Setter Property="BorderBrush" Value="#7C3AED" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7C3AED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral Outline Button -->
        <Style x:Key="OutlineBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (#EF4444 -> #DC2626) -->
        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Row Action Icon Button -->
        <Style x:Key="RowIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Form TextBox -->
        <Style x:Key="WebInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Repeater Editable Numeric Cell TextBox -->
        <Style x:Key="GridCellInputStyle" TargetType="TextBox" BasedOn="{StaticResource WebInputStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
        </Style>

        <!-- Repeater Read-Only Gray Box -->
        <Style x:Key="ReadOnlyBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,2" />
        </Style>

        <!-- Repeater SubTotal Highlight Box -->
        <Style x:Key="SubTotalBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!-- Repeater Header Cell Styles -->
        <Style x:Key="ThEditableStyle" TargetType="Border">
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style x:Key="ThReadOnlyStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- =================================================================== -->
        <!-- MODE 1: PURCHASE RETURNS DIRECTORY VIEW (Exact PurchaseReturn/index.jsx -->
        <!--         & PurchaseInvoicesView.xaml Directory Mode)                 -->
        <!-- =================================================================== -->
        <ScrollViewer Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="20,16">
                <StackPanel>
                    <!-- 1. Top Hero Header Card with Integrated 2-Column Search Bar -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="18,16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Hero Top Row -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#DCFCE7" Margin="0,0,12,0">
                                        <Path Data="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"
                                              Stroke="#16A34A" StrokeThickness="2" Stretch="Uniform"
                                              Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Purchase Returns" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                        <TextBlock Text="{Binding DirectoryTotalSubtitleText}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OutlineBtnStyle}"
                                            Command="{Binding RefreshDirectoryCommand}"
                                            ToolTip="Refresh purchase returns (F5)"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                  Fill="#334155" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource PrimaryBtnStyle}"
                                            Command="{Binding OpenCreateFormCommand}"
                                            ToolTip="Add Return (Alt+N)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M17,13H13V17H11V13H7V11H11V7H13V11H17V13Z"
                                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Add Return" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Integrated 2-Column Search Bar (PurchaseReturn/index.jsx:380-412) -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Search by Posted No -->
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="DirectorySearchPostedBox"
                                                 Style="{StaticResource WebInputStyle}"
                                                 Height="36"
                                                 Padding="32,6,10,6"
                                                 Text="{Binding FilterPostedNumber, UpdateSourceTrigger=PropertyChanged}" />
                                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                              Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                                        <TextBlock Text="Search by Posted No (e.g., PRRET-0001)…"
                                                   FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="34,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DirectorySearchPostedBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Search by Supplier -->
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="DirectorySearchSupplierBox"
                                                 Style="{StaticResource WebInputStyle}"
                                                 Height="36"
                                                 Padding="32,6,10,6"
                                                 Text="{Binding FilterSupplierSearch, UpdateSourceTrigger=PropertyChanged}" />
                                        <Path Data="M3,21H21V19H3V21M5,17H19V7L12,3L5,7V17M9,9H11V11H9V9M13,9H15V11H13V9M9,13H11V15H9V13M13,13H15V15H13V13Z"
                                              Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                                        <TextBlock Text="Search by Supplier…"
                                                   FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="34,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DirectorySearchSupplierBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Returns Table Card (PurchaseReturn/index.jsx:416-664) -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="16"
                            ClipToBounds="True">
                        <StackPanel>
                            <!-- Table Subheader: "Return List" + Page Size Selector -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="#EDE9FE" Margin="0,0,9,0">
                                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                                  Fill="#7C3AED" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Return List" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" />
                                            <TextBlock Text="{Binding DirectoryRangeSubtitleText}" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Show" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <local:SearchableSelect Width="84"
                                                                ItemsSource="{Binding PageSizeOptions}"
                                                                SelectedItem="{Binding SelectedPageSizeOption, Mode=TwoWay}"
                                                                DisplayMemberPath="Label"
                                                                IsSearchable="False"
                                                                IsClearable="False" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Column Header Row -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="168" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="POSTED NO" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="2" Text="INVOICE" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="3" Text="SUPPLIER" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="4" Text="DATE" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="5" Text="SETTLEMENT" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Grid.Column="6" Text="AMOUNT" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Empty Directory State -->
                            <Border Padding="24,42"
                                    Visibility="{Binding ShowEmptyDirectoryState, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                          Fill="#94A3B8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="No returns found" FontSize="13.5" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Directory Rows -->
                            <ItemsControl ItemsSource="{Binding DirectoryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="168" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding RowIndex}" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />

                                                <!-- Posted No Pill Button (PurchaseReturn/index.jsx:502-514) -->
                                                <Button Grid.Column="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        ToolTip="View Purchase Return Details"
                                                        Command="{Binding DataContext.ViewReturnDetailCommand, ElementName=PurchaseReturnsRoot}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="PillBd" Background="#EDE9FE" CornerRadius="7" Padding="8,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                                                          Fill="#7C3AED" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding PostedNumber}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#6D28D9" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="PillBd" Property="Background" Value="#DDD6FE" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Linked Invoice -->
                                                <TextBlock Grid.Column="2" Text="{Binding InvoiceDisplay}" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />

                                                <!-- Supplier Pill Badge (Matches PurchaseInvoicesView.xaml:483-485) -->
                                                <Border Grid.Column="3" Background="#ECFDF5" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding SupplierName}" FontSize="11.5" FontWeight="Medium" Foreground="#047857" TextTrimming="CharacterEllipsis" />
                                                </Border>

                                                <!-- Date -->
                                                <TextBlock Grid.Column="4" Text="{Binding DateFormatted}" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" />

                                                <!-- Settlement Mode Badge -->
                                                <Border Grid.Column="5" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SettlementBadgeLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                                </Border>

                                                <!-- Amount -->
                                                <TextBlock Grid.Column="6" Text="{Binding Total, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />

                                                <!-- Actions: View, Print, Edit, History, Delete -->
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource RowIconBtnStyle}"
