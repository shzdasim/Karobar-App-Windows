                                                            <TextBlock Grid.Column="2" Text="{Binding Batch, TargetNullValue='[Unassigned]'}" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" />
                                                            <TextBlock Grid.Column="3" Text="{Binding ExpiryFormatted}" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" />
                                                            <TextBlock Grid.Column="4" Text="{Binding ReturnPackQuantity, StringFormat={}{0:0.##}}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="5" Text="{Binding ReturnUnitQuantity}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="6" Text="{Binding UnitPurchasePrice, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="7" Text="{Binding ItemDiscountPercentage, StringFormat={}{0:0.##}%}" FontFamily="Consolas" FontSize="11.5" Foreground="#64748B" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="8" Text="{Binding SubTotal, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Summary Totals -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" HorizontalAlignment="Right" Width="300">
