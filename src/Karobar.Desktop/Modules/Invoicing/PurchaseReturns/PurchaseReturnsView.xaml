                                                    <TextBlock Grid.Column="2"
                                                               Text="Search"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2563EB"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedSupplier}" Value="True">
                                                    <Setter TargetName="SupBd" Property="Background" Value="#EFF6FF" />
                                                    <Setter TargetName="SupBd" Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter TargetName="SupIcon" Property="Fill" Value="#1D4ED8" />
                                                    <Setter TargetName="SupTxt" Property="Foreground" Value="#1D4ED8" />
                                                    <Setter TargetName="SupTxt" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SupBd" Property="BorderBrush" Value="#60A5FA" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="SupBd" Property="BorderBrush" Value="#2563EB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Col 6: Purchase Invoice (Optional) Trigger Button (PurchaseReturnForm.jsx:1798-1822) -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="PURCHASE INVOICE (OPTIONAL)" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="InvoiceTriggerButton"
                                            Grid.Column="0"
                                            Height="30"
                                            Cursor="Hand"
                                            Command="{Binding OpenInvoiceSearchModalCommand}"
                                            PreviewKeyDown="InvoiceTriggerButton_OnPreviewKeyDown"
                                            ToolTip="{Binding InvoiceButtonText}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="InvBd"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="InvIcon"
                                                              Grid.Column="0"
                                                              Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                                              Fill="#64748B" Width="14" Height="14" Stretch="Uniform"
                                                              VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock x:Name="InvTxt"
                                                                   Grid.Column="1"
                                                                   Text="{Binding InvoiceButtonText}"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="Search"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#2563EB"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedInvoice}" Value="True">
                                                        <Setter TargetName="InvBd" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="InvBd" Property="BorderBrush" Value="#3B82F6" />
                                                        <Setter TargetName="InvIcon" Property="Fill" Value="#1D4ED8" />
                                                        <Setter TargetName="InvTxt" Property="Foreground" Value="#1D4ED8" />
                                                        <Setter TargetName="InvTxt" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InvBd" Property="BorderBrush" Value="#60A5FA" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="InvBd" Property="BorderBrush" Value="#2563EB" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource RowIconBtnStyle}"
                                            Width="28" Height="30" Margin="4,0,0,0"
                                            ToolTip="Clear linked invoice (switch to Open Return)"
