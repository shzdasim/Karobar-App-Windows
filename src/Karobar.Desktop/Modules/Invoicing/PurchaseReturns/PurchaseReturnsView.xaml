                                <Border Style="{StaticResource ReadOnlyBoxStyle}" Height="26" Margin="0,3,0,0" Background="#FEF2F2" BorderBrush="#FECACA">
                                    <TextBlock Text="{Binding FormTotal, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="13" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Settlement Outcome Bar + Action Buttons (PurchaseReturnForm.jsx:2141-2224) -->
                    <Grid Margin="0,8,0,0">
                        <Border HorizontalAlignment="Left"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SETTLEMENT OUTCOME:" FontSize="10" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <!-- Adjust Supplier Ledger (Debit Note) -->
                                <Button Cursor="Hand"
                                        Command="{Binding SetSettlementModeCommand}"
                                        CommandParameter="credit_note"
                                        Margin="0,0,6,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="LedBd" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4">
