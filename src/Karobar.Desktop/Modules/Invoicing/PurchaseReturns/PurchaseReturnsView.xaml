                                    <TextBlock Text="{Binding FormTaxAmount, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Border>
