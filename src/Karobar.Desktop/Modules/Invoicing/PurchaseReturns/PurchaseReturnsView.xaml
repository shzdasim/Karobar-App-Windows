        <Grid Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#800F172A">
            <Border Width="860" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
