                               FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding ClosePreShiftModalCommand}" Content="Cancel" />
