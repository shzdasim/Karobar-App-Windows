                        </Border>
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Product" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Pack Size / Batch / Expiry / Available Qty" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Return Qty (Pack / Unit)" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Purchase Price (P / U)" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="10" Style="{StaticResource ThEditableStyle}">
                            <TextBlock Text="Disc %" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="11" Style="{StaticResource ThReadOnlyStyle}">
