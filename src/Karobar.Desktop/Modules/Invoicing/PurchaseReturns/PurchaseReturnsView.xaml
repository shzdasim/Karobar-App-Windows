                                    <TextBlock Text="{Binding PostedNumberDisplayText}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- Col 2: Date -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DATE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                <DatePicker x:Name="ReturnDatePicker"
                                            Height="30"
                                            FontSize="11.5"
                                            SelectedDate="{Binding FormDate, Mode=TwoWay}"
                                            Loaded="AnyDatePicker_OnLoaded" />
                            </StackPanel>

                            <!-- Col 4: Supplier * Trigger Button (Exact PurchaseInvoicesView.xaml:783-832) -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="SUPPLIER *" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                <Button x:Name="SupplierTriggerButton"
                                        Height="30"
                                        Cursor="Hand"
                                        Command="{Binding OpenSupplierSearchModalCommand}"
                                        PreviewKeyDown="SupplierTriggerButton_OnPreviewKeyDown"
                                        ToolTip="{Binding SupplierButtonText}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SupBd"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="SupIcon"
                                                          Grid.Column="0"
                                                          Data="M3,21H21V19H3V21M5,17H19V7L12,3L5,7V17M9,9H11V11H9V9M13,9H15V11H13V9M9,13H11V15H9V13M13,13H15V15H13V13Z"
                                                          Fill="#64748B" Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock x:Name="SupTxt"
                                                               Grid.Column="1"
                                                               Text="{Binding SupplierButtonText}"
