                        <!-- Bottom Quick Actions (Print / Edit + New / Delete / Back) -->
                        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,8" Background="#F8FAFC">
