<UserControl x:Class="Karobar.Desktop.Views.SaleInvoicesView"
             x:Name="SaleInvoicesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Karobar.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1480"
             Focusable="True"
             PreviewKeyDown="SaleInvoicesView_OnPreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Web App Button Styles -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurpleBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="BorderBrush" Value="#6D28D9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmeraldBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#047857" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#047857" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="HeaderInputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepeaterCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WholesalePriceCellTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RepeaterCellTextBoxStyle}">
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#6EE7B7" />
            <Setter Property="Foreground" Value="#065F46" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ColHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">

        <!-- =================================================================== -->
        <!-- VIEW 1: SALE INVOICES DIRECTORY / INDEX MODE                        -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVis}}" Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1.1 Directory Header Banner -->
            <Border Grid.Row="0" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A8A" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.55" />
                        <GradientStop Color="#4F46E5" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DirectoryHeaderTitle}" FontSize="17" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                            <Border Background="#33FFFFFF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalDirectoryCount, StringFormat='{}{0} Records'}" FontSize="11" FontWeight="Bold" Foreground="#E0E7FF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Ctrl+N New Retail • Ctrl+W New Wholesale • Ctrl+D Held Drafts • Ctrl+F Search • F5 Refresh"
                                   FontSize="11" Foreground="#BFDBFE" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Held Drafts Button -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding OpenDraftsModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Held Drafts (Ctrl+D)" VerticalAlignment="Center" />
                                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0"
                                        Visibility="{Binding HasHeldDrafts, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding HeldDraftsCount}" FontSize="10.5" FontWeight="ExtraBold" Foreground="#B45309" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- + New Wholesale Invoice -->
                        <Button Style="{StaticResource PurpleBtnStyle}" Margin="0,0,8,0"
                                Visibility="{Binding HasWholesale, Converter={StaticResource BoolToVis}}"
                                Command="{Binding NavigateToCreateWholesaleCommand}">
                            <TextBlock Text="+ Wholesale Invoice (Ctrl+W)" />
                        </Button>

                        <!-- + New Retail Invoice -->
                        <Button Style="{StaticResource EmeraldBtnStyle}"
                                Command="{Binding NavigateToCreateRetailCommand}">
                            <TextBlock Text="+ Retail Invoice (Ctrl+N)" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1.2 KPI Cards Row -->
            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="POSTED INVOICES" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding KpiTotalPostedCount}" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,2,0,0" />
                        <TextBlock FontSize="10.5" Foreground="#64748B">
                            <Run Text="Retail: " /><Run Text="{Binding KpiRetailCount, Mode=OneWay}" FontWeight="Bold" Foreground="#2563EB" />
                            <Run Text=" • Wholesale: " /><Run Text="{Binding KpiWholesaleCount, Mode=OneWay}" FontWeight="Bold" Foreground="#7C3AED" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL NET SALES" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding KpiTotalPostedAmount, StringFormat='Rs. {0:N0}'}" FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,2,0,0" />
                        <TextBlock Text="Posted active bills" FontSize="10.5" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL RECEIVED" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding KpiTotalReceivedAmount, StringFormat='Rs. {0:N0}'}" FontSize="18" FontWeight="ExtraBold" Foreground="#059669" Margin="0,2,0,0" />
                        <TextBlock Text="Cash &amp; account collections" FontSize="10.5" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="REMAINING RECEIVABLE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding KpiTotalRemainingReceivable, StringFormat='Rs. {0:N0}'}" FontSize="18" FontWeight="ExtraBold" Foreground="#D97706" Margin="0,2,0,0" />
                        <TextBlock Text="Credit (Udhar) due on bills" FontSize="10.5" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <StackPanel>
                        <TextBlock Text="ESTIMATED PROFIT" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding KpiTotalEstimatedProfit, StringFormat='Rs. {0:N0}'}" FontSize="18" FontWeight="ExtraBold" Foreground="#0D9488" Margin="0,2,0,0" />
                        <TextBlock Text="Based on cost snapshot" FontSize="10.5" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 1.3 Filter Bar -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- All / Retail / Wholesale Segmented Pills -->
                    <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,0"
                            Visibility="{Binding ShowSaleTypeFilterPills, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetDirectorySaleTypeFilterCommand}" CommandParameter="all" Cursor="Hand" BorderThickness="0" Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAllSaleTypes}" Value="True">
                                                <Setter Property="Background" Value="#2563EB" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="All" FontSize="11" FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding SetDirectorySaleTypeFilterCommand}" CommandParameter="retail" Cursor="Hand" BorderThickness="0" Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterRetailOnly}" Value="True">
                                                <Setter Property="Background" Value="#059669" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Retail" FontSize="11" FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding SetDirectorySaleTypeFilterCommand}" CommandParameter="wholesale" Cursor="Hand" BorderThickness="0" Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterWholesaleOnly}" Value="True">
                                                <Setter Property="Background" Value="#7C3AED" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Wholesale" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search Box -->
                    <TextBox x:Name="DirectorySearchTextBox"
                             Grid.Column="1"
                             Style="{StaticResource HeaderInputBoxStyle}"
                             Margin="0,0,8,0"
                             Tag="Search Invoice #, Customer, Doctor, Patient..."
                             Text="{Binding DirectorySearch, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="DirectorySearchTextBox_OnKeyDown" />

                    <!-- Customer Filter -->
                    <local:SearchableSelect Grid.Column="2"
                                            Margin="0,0,8,0"
                                            ItemsSource="{Binding CustomerFilterOptions}"
                                            SelectedItem="{Binding SelectedCustomerFilter, Mode=TwoWay}"
                                            Placeholder="All Customers" />

                    <!-- Invoice Type Filter -->
                    <local:SearchableSelect Grid.Column="3"
                                            Margin="0,0,8,0"
                                            ItemsSource="{Binding InvoiceTypeFilterOptions}"
                                            SelectedItem="{Binding SelectedInvoiceTypeFilter, Mode=TwoWay}"
                                            Placeholder="All Types" />

                    <!-- Status Filter -->
                    <local:SearchableSelect Grid.Column="4"
                                            Margin="0,0,8,0"
                                            ItemsSource="{Binding StatusFilterOptions}"
                                            SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                            Placeholder="All Statuses" />

                    <!-- From / To Date -->
                    <DatePicker Grid.Column="5" Width="115" Height="30" Margin="0,0,6,0"
                                SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                                ToolTip="From Date (dd-MM-yyyy)" />
                    <DatePicker Grid.Column="6" Width="115" Height="30" Margin="0,0,8,0"
                                SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                                ToolTip="To Date (dd-MM-yyyy)" />

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,6,0"
                                Command="{Binding LoadDirectoryPageCommand}">
                            <TextBlock Text="Filter" />
                        </Button>
                        <Button Style="{StaticResource OutlineBtnStyle}"
                                Command="{Binding ClearDirectoryFiltersCommand}">
                            <TextBlock Text="Reset" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1.4 Directory Table -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.95*" />
                                <ColumnDefinition Width="2.1*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.65*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.95*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="INVOICE #" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource ColHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="CUSTOMER" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="3" Text="CHANNEL" Style="{StaticResource ColHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="MODE" Style="{StaticResource ColHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="ITEMS" Style="{StaticResource ColHeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="NET TOTAL" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="RECEIVED" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="8" Text="REMAINING" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="9" Text="EST. PROFIT" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="10" Text="STATUS" Style="{StaticResource ColHeaderTextStyle}" />
                            <TextBlock Grid.Column="11" Text="ACTIONS" Style="{StaticResource ColHeaderTextStyle}" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DirectoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,7" Background="#FFFFFF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="2.1*" />
                                                <ColumnDefinition Width="0.85*" />
                                                <ColumnDefinition Width="0.85*" />
                                                <ColumnDefinition Width="0.65*" />
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="0.85*" />
                                                <ColumnDefinition Width="1.35*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding PostedNumber}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontSize="11.5" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CustomerPhone}" FontSize="10.5" Foreground="#64748B" />
                                            </StackPanel>

                                            <!-- Sale Type Badge -->
                                            <Border Grid.Column="3" CornerRadius="5" Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWholesale}" Value="True">
                                                                <Setter Property="Background" Value="#F3E8FF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SaleTypeBadge}" FontSize="10.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#047857" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWholesale}" Value="True">
                                                                    <Setter Property="Foreground" Value="#6D28D9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Invoice Type Badge -->
                                            <Border Grid.Column="4" CornerRadius="5" Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding InvoiceTypeBadge}" FontSize="10.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="5" Text="{Binding ItemsCount}" FontSize="11.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding Total, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="7" Text="{Binding TotalReceive, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Text="{Binding RemainingAmount, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="9" Text="{Binding EstimatedProfit, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#0D9488" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Status Badge -->
                                            <Border Grid.Column="10" CornerRadius="5" Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Row Actions -->
                                            <StackPanel Grid.Column="11" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,3" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.ViewInvoiceDetailCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}" ToolTip="View &amp; Print">
                                                    <TextBlock Text="View" FontSize="10.5" />
                                                </Button>
                                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,3" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditInvoiceFromDirectoryCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}" ToolTip="Edit Invoice">
                                                    <TextBlock Text="Edit" FontSize="10.5" />
                                                </Button>
                                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="7,3" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.PrintInvoiceFromDirectoryCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}" ToolTip="Print Invoice">
                                                    <TextBlock Text="Print" FontSize="10.5" />
                                                </Button>
                                                <Button Style="{StaticResource DangerBtnStyle}" Padding="7,3"
                                                        Command="{Binding DataContext.OpenReverseModalCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}" ToolTip="Reverse / Void Invoice">
                                                    <TextBlock Text="Void" FontSize="10.5" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 1.5 Pagination Footer -->
            <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,8,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B">
                        <Run Text="Page " /><Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                        <Run Text=" of " /><Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                        <Run Text=" • Total " /><Run Text="{Binding TotalDirectoryCount, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" invoices" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="10,4" Margin="0,0,6,0"
                                Command="{Binding PreviousPageCommand}">
                            <TextBlock Text="← Previous" />
                        </Button>
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="10,4"
                                Command="{Binding NextPageCommand}">
                            <TextBlock Text="Next →" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- VIEW 2: CREATE / EDIT SALE INVOICE FORM (RETAIL & WHOLESALE)        -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}" Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 2.1 Top Gradient Banner (Retail Blue/Indigo vs Wholesale Purple/Indigo) -->
            <Border Grid.Row="0" CornerRadius="9" Padding="14,8" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1E3A8A" Offset="0.0" />
                                    <GradientStop Color="#2563EB" Offset="0.55" />
                                    <GradientStop Color="#0D9488" Offset="1.0" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWholesaleFormMode}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3B0764" Offset="0.0" />
                                            <GradientStop Color="#6D28D9" Offset="0.55" />
                                            <GradientStop Color="#4F46E5" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#33FFFFFF" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding FormModeBadgeText}" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="{Binding FormBannerTitle}" FontSize="15.5" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Border Background="#26FFFFFF" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PostedNumber}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FDE68A" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding FormShortcutHintText}" FontSize="10.5" Foreground="#E0E7FF" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Retail / Wholesale Switcher -->
                        <Border Background="#26000000" CornerRadius="6" Padding="2" Margin="0,0,8,0"
                                Visibility="{Binding HasWholesale, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SwitchFormSaleTypeCommand}" CommandParameter="retail" Cursor="Hand" BorderThickness="0" Padding="9,3">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#E2E8F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRetailFormMode}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Retail POS" FontSize="10.5" FontWeight="Bold" />
                                </Button>
                                <Button Command="{Binding SwitchFormSaleTypeCommand}" CommandParameter="wholesale" Cursor="Hand" BorderThickness="0" Padding="9,3">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#E2E8F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWholesaleFormMode}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" Value="#581C87" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Wholesale B2B" FontSize="10.5" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Hold & New (Ctrl+H) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="10,4" Margin="0,0,6,0"
                                Command="{Binding HoldAndNewCommand}" ToolTip="Hold current invoice as draft and open fresh bill (Ctrl+H)">
                            <TextBlock Text="Hold &amp; New (Ctrl+H)" FontSize="11" />
                        </Button>

                        <!-- Held Drafts (Ctrl+D) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="10,4" Margin="0,0,6,0"
                                Command="{Binding OpenDraftsModalCommand}" ToolTip="Open Held Drafts (Ctrl+D)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Drafts (Ctrl+D)" FontSize="11" />
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="5,0" Margin="5,0,0,0"
                                        Visibility="{Binding HasHeldDrafts, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding HeldDraftsCount}" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Clear / New (Ctrl+N) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="10,4" Margin="0,0,6,0"
                                Command="{Binding ClearOrNewInvoiceCommand}">
                            <TextBlock Text="Clear (Ctrl+N)" FontSize="11" />
                        </Button>

                        <!-- Back to List -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="10,4"
                                Command="{Binding NavigateBackToListCommand}">
                            <TextBlock Text="← Back (Ctrl+B)" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2.2 Compact Header Card (Customer Trigger, Walk-In Name/Phone, Debit/Credit, Doctor/Patient, Remarks, Date) -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.0*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.05*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Customer Trigger Button + Walk-in Reset + Quick Add -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Grid>
                                <TextBlock Text="CUSTOMER *" Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-2,0,2">
                                    <Button Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="4,0"
                                            Command="{Binding ResetToWalkInCustomerCommand}" ToolTip="Reset to Walk-in Customer">
                                        <TextBlock Text="Walk-in" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                                    </Button>
                                    <TextBlock Text="•" FontSize="10" Foreground="#CBD5E1" Margin="3,0" />
                                    <Button Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="4,0"
                                            Command="{Binding ToggleQuickAddCustomerCommand}" ToolTip="Quick Add New Customer">
                                        <TextBlock Text="+ Quick Add" FontSize="10" FontWeight="Bold" Foreground="#2563EB" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="CustomerSelectTriggerButton"
                                    Height="30"
                                    Cursor="Hand"
                                    Command="{Binding OpenCustomerSearchModalCommand}"
                                    PreviewKeyDown="CustomerSelectTriggerButton_OnPreviewKeyDown">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CustBd" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SelectedCustomerDisplayText}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="▾" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CustBd" Property="BorderBrush" Value="#2563EB" />
                                                <Setter TargetName="CustBd" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="CustBd" Property="Background" Value="#EFF6FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Col 1: Walk-in Customer Name (or Registered Customer Info Strip) -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"
                                    Visibility="{Binding IsWalkInSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CUSTOMER NAME (WALK-IN)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="OneTimeCustomerNameTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding OneTimeCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="HeaderField_OnPreviewKeyDown"
                                     Tag="one_time_name" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,8,0"
                                    Visibility="{Binding ShowRegisteredCustomerInfoStrip, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CUSTOMER LEDGER &amp; PRICING" Style="{StaticResource FieldLabelStyle}" />
                            <Border Height="30" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerCurrentDueText}" FontSize="11" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding CustomerCreditLimitText}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="#F3E8FF" CornerRadius="4" Padding="5,1" Margin="0,0,4,0"
                                            Visibility="{Binding HasCustomerCustomPrices, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding CustomerCustomPricesBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#6D28D9" />
                                    </Border>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1"
                                            Visibility="{Binding HasCustomerDefaultDiscount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding CustomerDefaultDiscountBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Col 2: Walk-in Customer Phone -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0"
                                    Visibility="{Binding IsWalkInSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PHONE #" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="OneTimeCustomerPhoneTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding OneTimeCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="HeaderField_OnPreviewKeyDown"
                                     Tag="one_time_phone" />
                        </StackPanel>

                        <!-- Col 3: Invoice Type (Debit / Credit Toggle) -->
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="PAYMENT TYPE" Style="{StaticResource FieldLabelStyle}" />
                            <Border Height="30" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="2">
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding SetInvoiceTypeCommand}" CommandParameter="debit" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDebitInvoice}" Value="True">
                                                        <Setter Property="Background" Value="#059669" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="Cash (Debit)" FontSize="10.5" FontWeight="Bold" />
                                    </Button>
                                    <Button Command="{Binding SetInvoiceTypeCommand}" CommandParameter="credit" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCreditInvoice}" Value="True">
                                                        <Setter Property="Background" Value="#D97706" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="Credit (Udhar)" FontSize="10.5" FontWeight="Bold" />
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- Col 4: Doctor Name (Pharmacy) -->
                        <StackPanel Grid.Column="4" Margin="0,0,8,0"
                                    Visibility="{Binding IsPharmacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DOCTOR" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="DoctorNameTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="HeaderField_OnPreviewKeyDown"
                                     Tag="doctor_name" />
                        </StackPanel>

                        <!-- Col 5: Patient Name (Pharmacy) -->
                        <StackPanel Grid.Column="5" Margin="0,0,8,0"
                                    Visibility="{Binding IsPharmacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PATIENT" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="PatientNameTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="HeaderField_OnPreviewKeyDown"
                                     Tag="patient_name" />
                        </StackPanel>

                        <!-- Col 6: Remarks -->
                        <StackPanel Grid.Column="6" Margin="0,0,8,0">
                            <TextBlock Text="REMARKS / NOTES" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="RemarksTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="HeaderField_OnPreviewKeyDown"
                                     Tag="remarks" />
                        </StackPanel>

                        <!-- Col 7: Invoice Date (dd-MM-yyyy) -->
                        <StackPanel Grid.Column="7">
                            <TextBlock Text="DATE *" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker x:Name="InvoiceDatePicker"
                                        Height="30"
                                        SelectedDate="{Binding InvoiceDate, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Inline Quick Add Customer Strip -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0"
                            Visibility="{Binding IsQuickAddCustomerOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Quick New Customer:" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,8,0"
                                     Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Customer Name *" />
                            <TextBox Grid.Column="2" Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,8,0"
                                     Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Phone Number" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryBtnStyle}" Padding="10,4" Margin="0,0,6,0"
                                        Command="{Binding SaveQuickCustomerCommand}">
                                    <TextBlock Text="Save Customer" />
                                </Button>
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="8,4"
                                        Command="{Binding ToggleQuickAddCustomerCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- =============================================================== -->
            <!-- 2.3A RETAIL POS BODY (12-Col Repeater + 248px Right Sidebar)    -->
            <!-- =============================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsRetailFormMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="256" />
                </Grid.ColumnDefinitions>

                <!-- Left: 12-Column Full-Width Retail Repeater -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Retail 12-Col Header (Sums to 100*) -->
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.0*" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="35.0*" />
                                    <ColumnDefinition Width="4.5*" />
                                    <ColumnDefinition Width="8.0*" />
                                    <ColumnDefinition Width="8.5*" />
                                    <ColumnDefinition Width="6.0*" />
                                    <ColumnDefinition Width="6.5*" />
                                    <ColumnDefinition Width="8.0*" />
                                    <ColumnDefinition Width="5.5*" />
                                    <ColumnDefinition Width="9.5*" />
                                    <ColumnDefinition Width="3.0*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DEL" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="1" Text="#" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="2" Text="PRODUCT *" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="3" Text="PSIZE" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="4" Text="BATCH" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="5" Text="EXPIRY" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="6" Text="AVAIL" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="7" Text="QTY *" Style="{StaticResource ColHeaderTextStyle}" Foreground="#1D4ED8" />
                                <TextBlock Grid.Column="8" Text="PRICE" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="9" Text="DISC %" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="10" Text="SUB TOTAL" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="11" Text="+" Style="{StaticResource ColHeaderTextStyle}" />
                            </Grid>
                        </Border>

                        <!-- Retail Repeater Rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="RetailLinesItemsControl" ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,3" Background="#FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3.0*" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="35.0*" />
                                                    <ColumnDefinition Width="4.5*" />
                                                    <ColumnDefinition Width="8.0*" />
                                                    <ColumnDefinition Width="8.5*" />
                                                    <ColumnDefinition Width="6.0*" />
                                                    <ColumnDefinition Width="6.5*" />
                                                    <ColumnDefinition Width="8.0*" />
                                                    <ColumnDefinition Width="5.5*" />
                                                    <ColumnDefinition Width="9.5*" />
                                                    <ColumnDefinition Width="3.0*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Delete Row -->
                                                <Button Grid.Column="0" Style="{StaticResource RowIconBtnStyle}"
                                                        Command="{Binding DataContext.RemoveLineCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}" ToolTip="Remove Row">
                                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                                </Button>

                                                <!-- Col 1: Row # -->
                                                <TextBlock Grid.Column="1" Text="{Binding RowNumber}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Col 2: Product Trigger + Substitute (⇄) Button -->
                                                <Grid Grid.Column="2" Margin="2,0,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Tag="product"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.OpenProductSearchForLineCommandCommand, ElementName=SaleInvoicesRoot}"
                                                            CommandParameter="{Binding}"
                                                            PreviewKeyDown="RepeaterCell_OnPreviewKeyDown">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ProdBd" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="7,3">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding ProductDisplayText}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ProductMetaText}" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter TargetName="ProdBd" Property="BorderBrush" Value="#2563EB" />
                                                                        <Setter TargetName="ProdBd" Property="BorderThickness" Value="1.5" />
                                                                        <Setter TargetName="ProdBd" Property="Background" Value="#EFF6FF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- Substitute (⇄) Lookup Button -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource RowIconBtnStyle}"
                                                            Margin="3,0,0,0"
                                                            Visibility="{Binding HasProduct, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.OpenSubstituteModalForLineCommand, ElementName=SaleInvoicesRoot}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Find Generic / Salt Substitute Products">
                                                        <TextBlock Text="⇄" FontSize="12" FontWeight="Bold" Foreground="#0284C7" />
                                                    </Button>
                                                </Grid>

                                                <!-- Col 3: Pack Size -->
                                                <TextBlock Grid.Column="3" Text="{Binding PackSize}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Col 4: Batch Trigger -->
                                                <Button Grid.Column="4"
                                                        Tag="batch"
                                                        Margin="2,0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenBatchSearchForLineCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}"
                                                        PreviewKeyDown="RepeaterCell_OnPreviewKeyDown">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="BatchBd" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="5,3">
                                                                <TextBlock Text="{Binding BatchDisplayText}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="BatchBd" Property="BorderBrush" Value="#2563EB" />
                                                                    <Setter TargetName="BatchBd" Property="Background" Value="#EFF6FF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Col 5: Expiry -->
                                                <Border Grid.Column="5" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpiredBatch}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding FormattedExpiry}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpiredBatch}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                        <Setter Property="FontWeight" Value="ExtraBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Col 6: Available Stock -->
                                                <Border Grid.Column="6" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F0FDF4" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsZeroOrLowStock}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding CurrentQuantity}" FontFamily="Consolas" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#15803D" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsZeroOrLowStock}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Col 7: Quantity * -->
                                                <TextBox Grid.Column="7"
                                                         Tag="quantity"
                                                         Margin="2,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 8: Retail Unit Price (Read-Only in Retail POS) -->
                                                <Border Grid.Column="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="2,0" Height="26">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Col 9: Item Disc % -->
                                                <TextBox Grid.Column="9"
                                                         Tag="disc"
                                                         Margin="2,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding ItemDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 10: Sub Total -->
                                                <TextBlock Grid.Column="10"
                                                           Text="{Binding SubTotal, StringFormat='{}{0:N2}'}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="ExtraBold"
                                                           Foreground="#0F172A"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />

                                                <!-- Col 11: Add Row (+) -->
                                                <Button Grid.Column="11" Style="{StaticResource RowIconBtnStyle}"
                                                        Command="{Binding DataContext.AppendRowAndOpenProductModalCommand, ElementName=SaleInvoicesRoot}"
                                                        ToolTip="Add New Row">
                                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#2563EB" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Bottom Quick Add Item Strip -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,5">
                            <Grid>
                                <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Left" Padding="10,3"
                                        Command="{Binding AppendRowAndOpenProductModalCommand}">
                                    <TextBlock Text="+ Add Product Row (Down Arrow on last row)" FontSize="11" />
                                </Button>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#64748B">
                                    <Run Text="Active Items: " /><Run Text="{Binding ActiveItemsCount, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text=" • Gross: Rs. " /><Run Text="{Binding GrossAmount, StringFormat='{}{0:N2}', Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: 248px Retail Summary & Payment Sidebar (Matching SaleInvoiceRetailForm.jsx) -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,9">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="BILL SUMMARY" FontSize="11" FontWeight="ExtraBold" Foreground="#1E293B" Margin="0,0,0,6" />

                            <Grid Margin="0,2">
                                <TextBlock Text="Gross Total" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding GrossAmount, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Item Discounts" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding ItemDiscountAmount, StringFormat='- Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Right" />
                            </Grid>

                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,6" />

                            <!-- Extra Bill Discount % & Amt -->
                            <TextBlock Text="BILL DISCOUNT (% / RS)" Style="{StaticResource FieldLabelStyle}" />
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <TextBox x:Name="RetailDiscountPctTextBox"
                                         Style="{StaticResource RepeaterCellTextBoxStyle}" Margin="0,0,4,0"
                                         Text="{Binding DiscountPercentageText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                         PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                         Tag="discount_percentage" />
                                <TextBox x:Name="RetailDiscountAmtTextBox"
                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                         Text="{Binding DiscountAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                         PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                         Tag="discount_amount" />
                            </UniformGrid>

                            <!-- Tax % & Amt -->
                            <TextBlock Text="TAX (% / RS)" Style="{StaticResource FieldLabelStyle}" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <TextBox x:Name="RetailTaxPctTextBox"
                                         Style="{StaticResource RepeaterCellTextBoxStyle}" Margin="0,0,4,0"
                                         Text="{Binding TaxPercentageText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                         PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                         Tag="tax_percentage" />
                                <TextBox x:Name="RetailTaxAmtTextBox"
                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                         Text="{Binding TaxAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                         PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                         Tag="tax_amount" />
                            </UniformGrid>

                            <!-- NET PAYABLE TOTAL BANNER -->
                            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1E3A8A" Offset="0.0" />
                                        <GradientStop Color="#2563EB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="NET PAYABLE TOTAL" FontSize="9.5" FontWeight="Bold" Foreground="#BFDBFE" />
                                    <TextBlock Text="{Binding FormattedNetTotal}" FontFamily="Consolas" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Payment Account -->
                            <Grid>
                                <TextBlock Text="PAYMENT ACCOUNT" Style="{StaticResource FieldLabelStyle}" />
                                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding ToggleQuickAddAccountCommand}">
                                    <TextBlock Text="+ Account" FontSize="9.5" FontWeight="Bold" Foreground="#2563EB" />
                                </Button>
                            </Grid>
                            <local:SearchableSelect Margin="0,0,0,6"
                                                    ItemsSource="{Binding PaymentAccounts}"
                                                    SelectedItem="{Binding SelectedPaymentAccount, Mode=TwoWay}"
                                                    DisplayMemberPath="DisplayLabel"
                                                    Placeholder="Select Account" />

                            <!-- Received Now (Visible in Credit Mode) -->
                            <StackPanel Visibility="{Binding IsCreditInvoice, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="RECEIVED NOW (PARTIAL CASH)" Style="{StaticResource FieldLabelStyle}" Foreground="#B45309" />
                                <TextBox x:Name="RetailTotalReceiveTextBox"
                                         Style="{StaticResource HeaderInputBoxStyle}"
                                         FontFamily="Consolas" FontWeight="Bold"
                                         Text="{Binding TotalReceiveText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                         PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                         Tag="total_receive" />
                            </StackPanel>

                            <!-- Cash Given (Enter Submits Invoice!) -->
                            <TextBlock Text="CASH GIVEN (ENTER SUBMITS)" Style="{StaticResource FieldLabelStyle}" Foreground="#047857" />
                            <TextBox x:Name="RetailCashGivenTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     FontFamily="Consolas" FontSize="13" FontWeight="ExtraBold"
                                     Background="#ECFDF5" BorderBrush="#6EE7B7"
                                     Text="{Binding CashGivenText, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                     PreviewKeyDown="CashGivenTextBox_OnPreviewKeyDown" />

                            <!-- Quick Cash Chips: Exact | 500 | 1000 | 5000 -->
                            <UniformGrid Columns="4" Margin="0,4,0,8">
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,3" Margin="0,0,3,0"
                                        Command="{Binding SetQuickCashGivenCommand}" CommandParameter="exact">
                                    <TextBlock Text="Exact" FontSize="10" FontWeight="Bold" />
                                </Button>
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,3" Margin="0,0,3,0"
                                        Command="{Binding SetQuickCashGivenCommand}" CommandParameter="500">
                                    <TextBlock Text="500" FontSize="10" FontWeight="Bold" />
                                </Button>
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,3" Margin="0,0,3,0"
                                        Command="{Binding SetQuickCashGivenCommand}" CommandParameter="1000">
                                    <TextBlock Text="1000" FontSize="10" FontWeight="Bold" />
                                </Button>
                                <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,3"
                                        Command="{Binding SetQuickCashGivenCommand}" CommandParameter="5000">
                                    <TextBlock Text="5000" FontSize="10" FontWeight="Bold" />
                                </Button>
                            </UniformGrid>

                            <!-- Change to Return Banner -->
                            <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                                    Visibility="{Binding ShowChangeToReturnBanner, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="CHANGE TO RETURN" FontSize="10" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChangeToReturnAmount, StringFormat='Rs. {0:N0}'}" FontFamily="Consolas" FontSize="14" FontWeight="ExtraBold" Foreground="#047857" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Remaining Due Banner (Credit) -->
                            <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                                    Visibility="{Binding ShowRemainingDueBanner, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="REMAINING BILL DUE" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                        <TextBlock Text="{Binding RemainingDueAmount, StringFormat='Rs. {0:N0}'}" FontFamily="Consolas" FontSize="13" FontWeight="ExtraBold" Foreground="#B45309" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding CustomerProjectedDueText, StringFormat='Projected Ledger Due: {0}'}" FontSize="10" Foreground="#92400E" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Excess Credit Banner -->
                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                                    Visibility="{Binding ShowExcessCreditBanner, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="LEDGER CREDIT" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ExcessCreditAmount, StringFormat='Rs. {0:N0}'}" FontFamily="Consolas" FontSize="13" FontWeight="ExtraBold" Foreground="#1D4ED8" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Primary Save & Print CTA -->
                            <Button Style="{StaticResource EmeraldBtnStyle}" Height="36" Margin="0,4,0,0"
                                    Command="{Binding SubmitInvoiceCommand}">
                                <TextBlock Text="{Binding SubmitButtonText}" FontSize="12.5" FontWeight="ExtraBold" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- =============================================================== -->
            <!-- 2.3B WHOLESALE B2B BODY (18-Col Repeater + Sticky 4-Col Footer) -->
            <!-- =============================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsWholesaleFormMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top: 18-Column Full-Width Wholesale Repeater -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Wholesale 18-Col Header (Sums to 100*) -->
                        <Border Grid.Row="0" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="0,0,0,1" Padding="3,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.0*" />
                                    <ColumnDefinition Width="2.0*" />
                                    <ColumnDefinition Width="22.5*" />
                                    <ColumnDefinition Width="3.5*" />
                                    <ColumnDefinition Width="6.5*" />
                                    <ColumnDefinition Width="6.5*" />
                                    <ColumnDefinition Width="5.8*" />
                                    <ColumnDefinition Width="4.3*" />
                                    <ColumnDefinition Width="4.3*" />
                                    <ColumnDefinition Width="4.2*" />
                                    <ColumnDefinition Width="4.0*" />
                                    <ColumnDefinition Width="4.0*" />
                                    <ColumnDefinition Width="4.6*" />
                                    <ColumnDefinition Width="5.6*" />
                                    <ColumnDefinition Width="5.3*" />
                                    <ColumnDefinition Width="4.9*" />
                                    <ColumnDefinition Width="6.8*" />
                                    <ColumnDefinition Width="2.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DEL" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="1" Text="#" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="2" Text="PRODUCT *" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="3" Text="PSZ" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="4" Text="BATCH" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="5" Text="EXPIRY" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="6" Text="AVAIL" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="7" Text="PACK.Q" Style="{StaticResource ColHeaderTextStyle}" Foreground="#6D28D9" />
                                <TextBlock Grid.Column="8" Text="UNIT.Q" Style="{StaticResource ColHeaderTextStyle}" Foreground="#6D28D9" />
                                <TextBlock Grid.Column="9" Text="DISC %" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="10" Text="PACK.B" Style="{StaticResource ColHeaderTextStyle}" Foreground="#0284C7" />
                                <TextBlock Grid.Column="11" Text="UNIT.B" Style="{StaticResource ColHeaderTextStyle}" Foreground="#0284C7" />
                                <TextBlock Grid.Column="12" Text="TOT.U" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="13" Text="PACK.P *" Style="{StaticResource ColHeaderTextStyle}" Foreground="#047857" />
                                <TextBlock Grid.Column="14" Text="UNIT.P *" Style="{StaticResource ColHeaderTextStyle}" Foreground="#047857" />
                                <TextBlock Grid.Column="15" Text="MRG %" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="16" Text="SUB TOTAL" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="17" Text="+" Style="{StaticResource ColHeaderTextStyle}" />
                            </Grid>
                        </Border>

                        <!-- Wholesale Repeater Rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="WholesaleLinesItemsControl" ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="3,3" Background="#FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.0*" />
                                                    <ColumnDefinition Width="2.0*" />
                                                    <ColumnDefinition Width="22.5*" />
                                                    <ColumnDefinition Width="3.5*" />
                                                    <ColumnDefinition Width="6.5*" />
                                                    <ColumnDefinition Width="6.5*" />
                                                    <ColumnDefinition Width="5.8*" />
                                                    <ColumnDefinition Width="4.3*" />
                                                    <ColumnDefinition Width="4.3*" />
                                                    <ColumnDefinition Width="4.2*" />
                                                    <ColumnDefinition Width="4.0*" />
                                                    <ColumnDefinition Width="4.0*" />
                                                    <ColumnDefinition Width="4.6*" />
                                                    <ColumnDefinition Width="5.6*" />
                                                    <ColumnDefinition Width="5.3*" />
                                                    <ColumnDefinition Width="4.9*" />
                                                    <ColumnDefinition Width="6.8*" />
                                                    <ColumnDefinition Width="2.2*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Delete -->
                                                <Button Grid.Column="0" Style="{StaticResource RowIconBtnStyle}" Width="22" Height="22"
                                                        Command="{Binding DataContext.RemoveLineCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}" ToolTip="Remove Row">
                                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#EF4444" />
                                                </Button>

                                                <!-- Col 1: Row # -->
                                                <TextBlock Grid.Column="1" Text="{Binding RowNumber}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Col 2: Product Trigger -->
                                                <Button Grid.Column="2"
                                                        Tag="product"
                                                        Margin="1,0,3,0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenProductSearchForLineCommandCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}"
                                                        PreviewKeyDown="RepeaterCell_OnPreviewKeyDown">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ProdBd" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding ProductDisplayText}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                                        <Border Background="#F3E8FF" CornerRadius="3" Padding="4,0" Margin="4,0,0,0"
                                                                                Visibility="{Binding IsCustomPrice, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="Custom" FontSize="8.5" FontWeight="Bold" Foreground="#6D28D9" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ProductMetaText}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="ProdBd" Property="BorderBrush" Value="#6D28D9" />
                                                                    <Setter TargetName="ProdBd" Property="BorderThickness" Value="1.5" />
                                                                    <Setter TargetName="ProdBd" Property="Background" Value="#F5F3FF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Col 3: Pack Size -->
                                                <TextBlock Grid.Column="3" Text="{Binding PackSize}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Col 4: Batch Trigger -->
                                                <Button Grid.Column="4"
                                                        Tag="batch"
                                                        Margin="1,0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenBatchSearchForLineCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}"
                                                        PreviewKeyDown="RepeaterCell_OnPreviewKeyDown">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="BatchBd" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="4,2">
                                                                <TextBlock Text="{Binding BatchDisplayText}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="BatchBd" Property="BorderBrush" Value="#6D28D9" />
                                                                    <Setter TargetName="BatchBd" Property="Background" Value="#F5F3FF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Col 5: Expiry -->
                                                <TextBlock Grid.Column="5" Text="{Binding FormattedExpiry}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpiredBatch}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                    <Setter Property="FontWeight" Value="ExtraBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Col 6: Avail (P/U) -->
                                                <TextBlock Grid.Column="6" Text="{Binding AvailPackUnitText}" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsZeroOrLowStock}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Col 7: Pack.Q -->
                                                <TextBox Grid.Column="7"
                                                         Tag="pack_quantity"
                                                         Margin="1,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding PackQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 8: Unit.Q -->
                                                <TextBox Grid.Column="8"
                                                         Tag="unit_quantity"
                                                         Margin="1,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding UnitQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 9: Disc % -->
                                                <TextBox Grid.Column="9"
                                                         Tag="disc"
                                                         Margin="1,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding ItemDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 10: Pack.B -->
                                                <TextBox Grid.Column="10"
                                                         Tag="pack_bonus"
                                                         Margin="1,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding PackBonusText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 11: Unit.B -->
                                                <TextBox Grid.Column="11"
                                                         Tag="unit_bonus"
                                                         Margin="1,0"
                                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                                         Text="{Binding UnitBonusText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 12: Tot.U (Read-Only Total Units + Bonus) -->
                                                <TextBlock Grid.Column="12" Text="{Binding TotalUnitsDisplay}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Col 13: Pack.P * (Editable Emerald Wholesale Pack Price) -->
                                                <TextBox Grid.Column="13"
                                                         Tag="pack_price"
                                                         Margin="1,0"
                                                         Style="{StaticResource WholesalePriceCellTextBoxStyle}"
                                                         Text="{Binding PackPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 14: Unit.P * (Editable Emerald Wholesale Unit Price) -->
                                                <TextBox Grid.Column="14"
                                                         Tag="price"
                                                         Margin="1,0"
                                                         Style="{StaticResource WholesalePriceCellTextBoxStyle}"
                                                         Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                                         PreviewKeyDown="RepeaterCell_OnPreviewKeyDown" />

                                                <!-- Col 15: Margin % Badge (Red if < 0%) -->
                                                <Border Grid.Column="15" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#ECFDF5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNegativeMargin}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding MarginDisplayText}" FontFamily="Consolas" FontSize="10" FontWeight="ExtraBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#047857" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNegativeMargin}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Col 16: Sub Total -->
                                                <TextBlock Grid.Column="16"
                                                           Text="{Binding SubTotal, StringFormat='{}{0:N2}'}"
                                                           FontFamily="Consolas"
                                                           FontSize="11.5"
                                                           FontWeight="ExtraBold"
                                                           Foreground="#0F172A"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0" />

                                                <!-- Col 17: Add Row (+) -->
                                                <Button Grid.Column="17" Style="{StaticResource RowIconBtnStyle}" Width="22" Height="22"
                                                        Command="{Binding DataContext.AppendRowAndOpenProductModalCommand, ElementName=SaleInvoicesRoot}"
                                                        ToolTip="Add New Row">
                                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#6D28D9" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Bottom Quick Add Item Strip -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,4">
                            <Grid>
                                <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Left" Padding="10,3"
                                        Command="{Binding AppendRowAndOpenProductModalCommand}">
                                    <TextBlock Text="+ Add Wholesale Product Row (Down Arrow on last row)" FontSize="11" />
                                </Button>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#64748B">
                                    <Run Text="Active Items: " /><Run Text="{Binding ActiveItemsCount, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text=" • Avg Margin: " /><Run Text="{Binding OverallMarginPercentage, StringFormat='{}{0:0.0}%', Mode=OneWay}" FontWeight="Bold" Foreground="#059669" />
                                    <Run Text=" • Est. Profit: Rs. " /><Run Text="{Binding OverallEstimatedProfit, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="Bold" Foreground="#0D9488" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom: Compact 4-Column Wholesale Summary Footer (#wholesale-summary-footer) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Footer Col 0: Bill Discount, Tax & Overall Profit/Margin -->
                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Extra Disc:" FontSize="10.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBox x:Name="WholesaleDiscountPctTextBox"
                                             Grid.Column="1" Style="{StaticResource RepeaterCellTextBoxStyle}" Margin="0,0,4,0"
                                             Text="{Binding DiscountPercentageText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                             PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                             Tag="discount_percentage" />
                                    <TextBox x:Name="WholesaleDiscountAmtTextBox"
                                             Grid.Column="2" Style="{StaticResource RepeaterCellTextBoxStyle}"
                                             Text="{Binding DiscountAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                             PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                             Tag="discount_amount" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tax % / Rs:" FontSize="10.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBox x:Name="WholesaleTaxPctTextBox"
                                             Grid.Column="1" Style="{StaticResource RepeaterCellTextBoxStyle}" Margin="0,0,4,0"
                                             Text="{Binding TaxPercentageText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                             PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                             Tag="tax_percentage" />
                                    <TextBox x:Name="WholesaleTaxAmtTextBox"
                                             Grid.Column="2" Style="{StaticResource RepeaterCellTextBoxStyle}"
                                             Text="{Binding TaxAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                             PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                             Tag="tax_amount" />
                                </Grid>

                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                    <Grid>
                                        <TextBlock FontSize="10" Foreground="#166534">
                                            <Run Text="Avg Margin: " /><Run Text="{Binding OverallMarginPercentage, StringFormat='{}{0:0.1}%', Mode=OneWay}" FontWeight="ExtraBold" />
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#166534">
                                            <Run Text="Profit: Rs. " /><Run Text="{Binding OverallEstimatedProfit, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="ExtraBold" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Footer Col 1: Gross, Item Discounts & Net Payable Card -->
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,0">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Gross Amount:" FontSize="10.5" Foreground="#64748B" />
                                    <TextBlock Text="{Binding GrossAmount, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Item Discounts:" FontSize="10.5" Foreground="#64748B" />
                                    <TextBlock Text="{Binding ItemDiscountAmount, StringFormat='- Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Right" />
                                </Grid>
                                <Border CornerRadius="7" Padding="10,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4C1D95" Offset="0.0" />
                                            <GradientStop Color="#6D28D9" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <TextBlock Text="NET PAYABLE" FontSize="9.5" FontWeight="Bold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FormattedNetTotal}" FontFamily="Consolas" FontSize="17" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Footer Col 2: Payment Account + Cash Given + Quick Cash Chips -->
                        <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,0">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account:" FontSize="10.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                                    <local:SearchableSelect Grid.Column="1"
                                                            ItemsSource="{Binding PaymentAccounts}"
                                                            SelectedItem="{Binding SelectedPaymentAccount, Mode=TwoWay}"
                                                            DisplayMemberPath="DisplayLabel"
                                                            Placeholder="Payment Account" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cash Given:" FontSize="10.5" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center" />
                                    <TextBox x:Name="WholesaleCashGivenTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource RepeaterCellTextBoxStyle}"
                                             Background="#ECFDF5" BorderBrush="#6EE7B7"
                                             FontSize="12.5" FontWeight="ExtraBold"
                                             Text="{Binding CashGivenText, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                             PreviewKeyDown="CashGivenTextBox_OnPreviewKeyDown" />
                                </Grid>

                                <UniformGrid Columns="4">
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,2" Margin="0,0,3,0"
                                            Command="{Binding SetQuickCashGivenCommand}" CommandParameter="exact">
                                        <TextBlock Text="Exact" FontSize="9.5" FontWeight="Bold" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,2" Margin="0,0,3,0"
                                            Command="{Binding SetQuickCashGivenCommand}" CommandParameter="1000">
                                        <TextBlock Text="1000" FontSize="9.5" FontWeight="Bold" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,2" Margin="0,0,3,0"
                                            Command="{Binding SetQuickCashGivenCommand}" CommandParameter="5000">
                                        <TextBlock Text="5000" FontSize="9.5" FontWeight="Bold" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineBtnStyle}" Padding="2,2"
                                            Command="{Binding SetQuickCashGivenCommand}" CommandParameter="10000">
                                        <TextBlock Text="10000" FontSize="9.5" FontWeight="Bold" />
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Footer Col 3: Received Now (Credit) / Change / Balance & Save & Print CTA -->
                        <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,4" Visibility="{Binding IsCreditInvoice, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Received Now:" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                <TextBox x:Name="WholesaleTotalReceiveTextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource RepeaterCellTextBoxStyle}"
                                         Text="{Binding TotalReceiveText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="NumericCell_OnGotKeyboardFocus"
                                         PreviewKeyDown="FooterField_OnPreviewKeyDown"
                                         Tag="total_receive" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <TextBlock FontSize="10.5" Foreground="#047857" Visibility="{Binding ShowChangeToReturnBanner, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Change: Rs. " /><Run Text="{Binding ChangeToReturnAmount, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="ExtraBold" />
                                </TextBlock>
                                <TextBlock FontSize="10.5" Foreground="#B45309" HorizontalAlignment="Right" Visibility="{Binding ShowRemainingDueBanner, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Bill Due: Rs. " /><Run Text="{Binding RemainingDueAmount, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="ExtraBold" />
                                </TextBlock>
                            </Grid>

                            <Button Style="{StaticResource PurpleBtnStyle}" Height="34"
                                    Command="{Binding SubmitInvoiceCommand}">
                                <TextBlock Text="{Binding SubmitButtonText}" FontSize="12" FontWeight="ExtraBold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- =================================================================== -->
        <!-- VIEW 3: SALE INVOICE DETAIL / SHOW MODE (Exact Show.jsx Replica)    -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDetailMode, Converter={StaticResource BoolToVis}}" Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 3.1 Top Branded Banner (Matching Show.jsx sale-entry-banner) -->
            <Border Grid.Row="0" CornerRadius="9" Padding="14,9" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1E3A8A" Offset="0.0" />
                                    <GradientStop Color="#2563EB" Offset="0.55" />
                                    <GradientStop Color="#0D9488" Offset="1.0" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentDetail.IsWholesale}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#581C87" Offset="0.0" />
                                            <GradientStop Color="#6D28D9" Offset="0.55" />
                                            <GradientStop Color="#4F46E5" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title, Badges & Keyboard Shortcut Hint -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#33FFFFFF" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CurrentDetail.ShowBannerBadge}" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="{Binding CurrentDetail.ShowBannerTitle}" FontSize="15.5" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Border Background="#26FFFFFF" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDetail.PostedNumber, StringFormat='#{0}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FDE68A" />
                            </Border>
                            <Border Background="#DC2626" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CurrentDetail.IsReversed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REVERSED" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentDetail.ShowBannerSubtitle}" FontSize="10.5" Foreground="#E0E7FF" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Right: Read-only Debit/Credit Pill + Show.jsx Action Buttons -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Read-Only Debit / Credit Segmented Pill -->
                        <Border Background="#26000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentDetail.IsDebit}" Value="True">
                                                    <Setter Property="Background" Value="#16A34A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Debit" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                                <Border CornerRadius="4" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentDetail.IsCredit}" Value="True">
                                                    <Setter Property="Background" Value="#D97706" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Credit" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Search (Ctrl+F) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding OpenShowInvoiceSearchModalCommand}" ToolTip="Search &amp; jump to another sale invoice (Ctrl+F)">
                            <TextBlock Text="🔍 Search (Ctrl+F)" FontSize="11" />
                        </Button>

                        <!-- Thermal / A4 Switcher -->
                        <Border Background="#26000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,5,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SetPrintPaperSizeCommand}" CommandParameter="thermal" Cursor="Hand" BorderThickness="0" Padding="7,2">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#E2E8F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrintThermalMode}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Thermal" FontSize="10" FontWeight="Bold" />
                                </Button>
                                <Button Command="{Binding SetPrintPaperSizeCommand}" CommandParameter="a4" Cursor="Hand" BorderThickness="0" Padding="7,2">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#E2E8F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrintA4Mode}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="A4" FontSize="10" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Print (Ctrl+P) -->
                        <Button Style="{StaticResource EmeraldBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding PrintCurrentDetailInvoiceCommand}" ToolTip="Print Invoice (Ctrl+P)">
                            <TextBlock Text="🖨 Print (Ctrl+P)" FontSize="11" />
                        </Button>

                        <!-- Delivery Challan (Gate Pass without Prices) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding PrintDeliveryChallanCommand}" ToolTip="Print Delivery Challan / Gate Pass (without prices)">
                            <TextBlock Text="📦 Delivery Challan" FontSize="11" />
                        </Button>

                        <!-- Receive Payment (Visible when Credit Invoice has Remaining Due) -->
                        <Button Style="{StaticResource EmeraldBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Visibility="{Binding CurrentDetail.HasRemainingDue, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenRecordPaymentModalCommand}" ToolTip="Record Payment against this Credit Invoice">
                            <TextBlock Text="💳 Receive Payment" FontSize="11" />
                        </Button>

                        <!-- History -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding OpenHistoryModalCommand}" ToolTip="View Document Audit History">
                            <TextBlock Text="🕒 History" FontSize="11" />
                        </Button>

                        <!-- Held Invoices (Ctrl+H) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding OpenDraftsModalCommand}" ToolTip="Held Invoices &amp; Drafts (Ctrl+H)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Held (Ctrl+H)" FontSize="11" />
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="5,0" Margin="4,0,0,0"
                                        Visibility="{Binding HasHeldDrafts, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding HeldDraftsCount}" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Void / Reverse -->
                        <Button Style="{StaticResource DangerBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Visibility="{Binding CurrentDetail.IsActive, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenReverseModalCommand}" ToolTip="Void / Reverse this invoice">
                            <TextBlock Text="Void" FontSize="11" />
                        </Button>

                        <!-- Edit (Ctrl+E) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                IsEnabled="{Binding CurrentDetail.IsActive}"
                                Command="{Binding EditCurrentDetailInvoiceCommand}" ToolTip="Edit Invoice (Ctrl+E)">
                            <TextBlock Text="Edit (Ctrl+E)" FontSize="11" />
                        </Button>

                        <!-- Delete (Ctrl+D) -->
                        <Button Style="{StaticResource DangerBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding OpenDeleteModalCommand}" ToolTip="Delete Invoice (Ctrl+D)">
                            <TextBlock Text="Delete (Ctrl+D)" FontSize="11" />
                        </Button>

                        <!-- New (Ctrl+N) -->
                        <Button Style="{StaticResource PrimaryBtnStyle}" Padding="9,4" Margin="0,0,5,0"
                                Command="{Binding CreateNewFromShowModeCommand}" ToolTip="Create New Sale Invoice (Ctrl+N)">
                            <TextBlock Text="+ New (Ctrl+N)" FontSize="11" />
                        </Button>

                        <!-- Back (Ctrl+B) -->
                        <Button Style="{StaticResource OutlineBtnStyle}" Padding="9,4"
                                Command="{Binding NavigateBackToListCommand}" ToolTip="Back to List (Ctrl+B)">
                            <TextBlock Text="← Back (Ctrl+B)" FontSize="11" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 3.2 Header Details Table Card (Matching Show.jsx Top Details Table) -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" ClipToBounds="True">
                <StackPanel>
                    <!-- Row 1: Posted # | Date | Customer | Doctor | Patient | Items / Order Breakdown -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.65*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <TextBlock Text="Posted #" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <TextBlock Text="{Binding CurrentDetail.PostedNumber}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <TextBlock Text="Date" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <TextBlock Text="{Binding CurrentDetail.FormattedDate}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <TextBlock Text="Customer" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDetail.CustomerName}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0"
                                        Visibility="{Binding CurrentDetail.HasCustomerPhone, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CurrentDetail.CustomerPhone}" FontFamily="Consolas" FontSize="10" Foreground="#475569" />
                                </Border>
                                <TextBlock Text="{Binding CurrentDetail.CustomerAddress}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"
                                           Visibility="{Binding CurrentDetail.HasCustomerAddress, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6"
                                Visibility="{Binding IsPharmacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Doctor" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="7" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6"
                                Visibility="{Binding IsPharmacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CurrentDetail.ShowDoctorDisplay}" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border Grid.Column="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6"
                                Visibility="{Binding IsPharmacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Patient" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6"
                                Visibility="{Binding IsPharmacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CurrentDetail.ShowPatientDisplay}" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border Grid.Column="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                            <TextBlock Text="Breakdown" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="11" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                            <TextBlock Text="{Binding CurrentDetail.WholesaleOrderBreakdownText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>

                    <!-- Row 2: Remarks / Delivery Note -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,5">
                            <TextBlock Text="Remarks" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Padding="10,5">
                            <TextBlock Text="{Binding CurrentDetail.ShowRemarksDisplay}" FontSize="11" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =============================================================== -->
            <!-- 3.3A RETAIL SHOW WORKSPACE (10-Col Items + 280px Summary Panel) -->
            <!-- =============================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding CurrentDetail.IsRetail, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Left: 10-Column Retail Repeater Table (Exact Show.jsx lines 1753-1790) -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Retail Show 10-Col Header (Sums to 100*) -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4.0*" />
                                    <ColumnDefinition Width="34.0*" />
                                    <ColumnDefinition Width="6.5*" />
                                    <ColumnDefinition Width="11.0*" />
                                    <ColumnDefinition Width="9.0*" />
                                    <ColumnDefinition Width="7.5*" />
                                    <ColumnDefinition Width="7.0*" />
                                    <ColumnDefinition Width="8.5*" />
                                    <ColumnDefinition Width="5.5*" />
                                    <ColumnDefinition Width="7.0*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="1" Text="Product" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="PSize" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="3" Text="Batch" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" Text="Expiry" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="5" Text="Avail" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="Qty" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="Price" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="Disc%" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="9" Text="Sub Total" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CurrentDetail.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,6" Background="#FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4.0*" />
                                                    <ColumnDefinition Width="34.0*" />
                                                    <ColumnDefinition Width="6.5*" />
                                                    <ColumnDefinition Width="11.0*" />
                                                    <ColumnDefinition Width="9.0*" />
                                                    <ColumnDefinition Width="7.5*" />
                                                    <ColumnDefinition Width="7.0*" />
                                                    <ColumnDefinition Width="8.5*" />
                                                    <ColumnDefinition Width="5.5*" />
                                                    <ColumnDefinition Width="7.0*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding RowNumber}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Formulation}" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasFormulation, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PackSize}" FontFamily="Consolas" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding BatchDisplay}" FontFamily="Consolas" FontSize="11" Foreground="#334155" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedExpiry}" FontFamily="Consolas" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding CurrentQuantity}" FontFamily="Consolas" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Quantity}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="{Binding Price, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="8" Text="{Binding ItemDiscountPercentage, StringFormat='{}{0:0.##}'}" FontFamily="Consolas" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="9" Text="{Binding SubTotal, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: 280px Retail Invoice Summary Card (Exact Show.jsx lines 1793-1960) -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0" Padding="14,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0.0" />
                                    <GradientStop Color="#1D4ED8" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="Invoice Summary" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <TextBlock Text="📊" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Content (Table Style matching Show.jsx) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Padding="10,10">
                                <StackPanel>
                                    <!-- Tax & Discount Table -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                                                    <TextBlock Text="Tax %" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                                                    <TextBlock Text="{Binding CurrentDetail.TaxPercentage, StringFormat='{}{0:0.##}%'}" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Right" />
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                                                    <TextBlock Text="Tax Amt" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                                                    <TextBlock Text="{Binding CurrentDetail.TaxAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="10,6">
                                                    <TextBlock Text="Disc %" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                                                    <TextBlock Text="{Binding CurrentDetail.DiscountPercentage, StringFormat='{}{0:0.##}%'}" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Right" />
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,6">
                                                    <TextBlock Text="Disc Amt" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                                </Border>
                                                <Border Grid.Column="1" Padding="10,6">
                                                    <TextBlock Text="{Binding CurrentDetail.DiscountAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Gross & Net Total Highlight Card -->
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="GROSS" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentDetail.GrossAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border BorderBrush="#93C5FD" BorderThickness="0,1,0,0" Margin="0,4" />
                                            <Grid>
                                                <TextBlock Text="Total" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentDetail.Total, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="19" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Payment & Printer Table -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" ClipToBounds="True">
                                        <StackPanel>
                                            <Grid>
