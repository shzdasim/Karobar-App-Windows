                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.25" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Header -->
                    <Border Grid.Row="0" Padding="18,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="#94A3B8" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="CustomerModalSearchTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     BorderThickness="0"
                                     FontSize="13.5"
                                     Text="{Binding CustomerModalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="CustomerModalSearchTextBox_OnPreviewKeyDown" />
                            <Button Grid.Column="2" Style="{StaticResource RowIconBtnStyle}" Margin="4,0"
                                    Visibility="{Binding HasCustomerSearchQuery, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding ClearCustomerSearchQueryCommand}">
                                <TextBlock Text="✕" FontSize="11" Foreground="#64748B" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource OutlineBtnStyle}" Padding="8,3"
                                    Command="{Binding CloseCustomerSearchModalCommand}">
                                <TextBlock Text="Close (Esc)" FontSize="10.5" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Customer Results List -->
                    <ListBox x:Name="CustomerModalResultsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding FilteredModalCustomers}"
                             SelectedItem="{Binding HighlightedModalCustomer, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="#FFFFFF"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="CustomerModalResultsListBox_OnPreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBd" Padding="16,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="#FFFFFF" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#F8FAFC" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#EFF6FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" />
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsWalkIn, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Walk-in Default" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="#64748B">
                                            <Run Text="{Binding Phone, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Area, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BalanceSummaryText}" FontSize="11.5" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CustomPricesCount, StringFormat='{}{0} Custom Prices'}" FontSize="10" Foreground="#6D28D9" HorizontalAlignment="Right"
                                                   Visibility="{Binding HasCustomPrices, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
                        <Grid>
                            <TextBlock Text="{Binding CustomerModalFooterCountText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Text="↑↓ Navigate • Enter Select • Esc Close" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 2: DRAGGABLE & 8-WAY RESIZABLE PRODUCT SEARCH MODAL           -->
        <!--          (Exact ProductSearchInput.jsx with Saved Size & Position)  -->
        <!-- =================================================================== -->
        <Grid x:Name="ProductSearchOverlayGrid"
              Visibility="{Binding IsProductSearchModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000"
              MouseLeftButtonDown="ProductSearchOverlay_OnMouseLeftButtonDown">
            <Canvas x:Name="ProductSearchOverlayCanvas"
                    SizeChanged="ProductSearchOverlayCanvas_OnSizeChanged">
                <Border x:Name="ProductSearchDialogBorder"
                        Canvas.Left="120"
                        Canvas.Top="60"
                        Width="960"
                        Height="600"
                        MinWidth="640"
                        MinHeight="420"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#0F172A" Opacity="0.28" />
                    </Border.Effect>

                    <Grid>
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Draggable Header Bar (.product-search-header) -->
                                <Border x:Name="ProductSearchHeaderBorder"
                                        Grid.Row="0"
                                        Padding="20,11"
                                        Cursor="SizeAll"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        ToolTip="Drag header to move window • Drag any edge or corner to resize"
                                        MouseLeftButtonDown="ProductSearchHeader_OnMouseLeftButtonDown"
                                        MouseMove="ProductSearchHeader_OnMouseMove"
                                        MouseLeftButtonUp="ProductSearchHeader_OnMouseLeftButtonUp"
                                        LostMouseCapture="ProductSearchHeader_OnLostMouseCapture">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Path Grid.Column="0"
                                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                              Fill="#94A3B8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"
                                              IsHitTestVisible="False" />

                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="ProductModalSearchTextBox"
                                                     Height="34"
                                                     Padding="4,4"
                                                     FontSize="14"
                                                     Foreground="#0F172A"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Cursor="IBeam"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding ProductModalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="ProductModalSearchTextBox_OnPreviewKeyDown" />
                                            <TextBlock Text="Search by product name (prefix match)..." FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ProductModalSearchTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <Button Grid.Column="2" Style="{StaticResource RowIconBtnStyle}" Width="24" Height="24" Margin="6,0,4,0"
                                                Visibility="{Binding HasProductSearchQuery, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding ClearProductSearchQueryCommand}">
                                            <TextBlock Text="✕" FontSize="11" Foreground="#64748B" />
                                        </Button>

                                        <!-- + Quick Add Product Button -->
                                        <Button Grid.Column="3" Style="{StaticResource OutlineBtnStyle}" Padding="9,4" Margin="4,0,8,0"
                                                Command="{Binding OpenQuickAddProductModalCommand}">
                                            <TextBlock Text="+ Add Product" FontSize="11" FontWeight="Bold" Foreground="#2563EB" />
                                        </Button>

                                        <Border Grid.Column="4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Esc" FontFamily="Consolas" FontSize="10" Foreground="#64748B" />
                                        </Border>

                                        <Button Grid.Column="5" Style="{StaticResource DangerBtnStyle}" Padding="10,4"
                                                Command="{Binding CloseProductSearchModalCommand}">
                                            <TextBlock Text="✕ Close" FontSize="11" FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Sticky 2-Row Grouped Table Header -->
                                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                        Visibility="{Binding HasProductSearchResults, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="22" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.8*" />
                                            <ColumnDefinition Width="0.90*" />
                                            <ColumnDefinition Width="0.90*" />
                                            <ColumnDefinition Width="0.95*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.95*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.90*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#E2E8F0" Padding="16,0">
                                            <TextBlock Text="Product" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                                            <TextBlock Text="PACK SIZE" FontSize="9.5" FontWeight="SemiBold" Foreground="#0891B2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
                                            <TextBlock Text="QTY" FontSize="9.5" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2">
                                            <TextBlock Text="RETAIL SALE" FontSize="9.5" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2">
                                            <TextBlock Text="WHOLESALE" FontSize="9.5" FontWeight="SemiBold" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="7">
                                            <TextBlock Text="AVG COST" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="8">
                                            <TextBlock Text="MRG %" FontSize="9.5" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                                            <TextBlock Text="Pack" FontSize="11" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="4">
                                            <TextBlock Text="Unit" FontSize="11" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                                            <TextBlock Text="Pack" FontSize="11" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="6">
                                            <TextBlock Text="Unit" FontSize="11" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Results List -->
                                <Grid Grid.Row="2">
                                    <ListBox x:Name="ProductModalResultsListBox"
                                             ItemsSource="{Binding ProductSearchResults}"
                                             SelectedItem="{Binding HighlightedModalProduct, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="#FFFFFF"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseMove="ProductModalResultsListBox_OnMouseMove"
                                             PreviewMouseLeftButtonUp="ProductModalResultsListBox_OnPreviewMouseLeftButtonUp">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="RowBd" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#FFFFFF" Cursor="Hand">
                                                                <Grid>
                                                                    <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                                                                    <ContentPresenter />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="RowBd" Property="Background" Value="#F8FAFC" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="RowBd" Property="Background" Value="#EEF2FF" />
                                                                    <Setter TargetName="AccentBar" Property="Background" Value="#4F46E5" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,9,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.8*" />
                                                        <ColumnDefinition Width="0.90*" />
                                                        <ColumnDefinition Width="0.90*" />
                                                        <ColumnDefinition Width="0.95*" />
                                                        <ColumnDefinition Width="0.85*" />
                                                        <ColumnDefinition Width="0.95*" />
                                                        <ColumnDefinition Width="0.85*" />
                                                        <ColumnDefinition Width="0.85*" />
                                                        <ColumnDefinition Width="0.90*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="16,0,8,0" VerticalAlignment="Center">
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding BrandName}" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasBrand, Converter={StaticResource BoolToVis}}" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Formulation}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasFormulation, Converter={StaticResource BoolToVis}}" />
                                                        <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SupplierBulletText}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0"
                                                                       Visibility="{Binding HasSupplier, Converter={StaticResource BoolToVis}}" />
                                                            <Border Background="#FEF3C7" CornerRadius="3" Padding="5,1"
                                                                    Visibility="{Binding HasRack, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding RackBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="#CFFAFE" BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="6" Padding="8,3"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PackSize}" FontSize="12" FontWeight="ExtraBold" Foreground="#0E7490" />
                                                    </Border>

                                                    <Border Grid.Column="2" CornerRadius="12" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E0F2FE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                        <Setter Property="Background" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="ExtraBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0369A1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <Border Grid.Column="3" BorderBrush="#F1F5F9" BorderThickness="1,0,0,0">
                                                        <TextBlock Text="{Binding FormattedPackSalePrice}" FontSize="12" FontWeight="ExtraBold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding FormattedUnitSalePrice}" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <Border Grid.Column="5" BorderBrush="#F1F5F9" BorderThickness="1,0,0,0">
                                                        <TextBlock Text="{Binding FormattedWholeSalePackPrice}" FontSize="12" FontWeight="ExtraBold" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="6" Text="{Binding FormattedWholeSaleUnitPrice}" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="7" Text="{Binding FormattedAvgPrice}" FontSize="12" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <Border Grid.Column="8" Background="#D1FAE5" CornerRadius="12" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MarginBadgeText}" FontSize="11.5" FontWeight="ExtraBold" Foreground="#047857" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Visibility="{Binding ShowEmptyProductSearchState, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="No matching products found" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Footer -->
                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="All products" FontSize="12" Foreground="#64748B"
                                                       Visibility="{Binding ShowAllProductsFooterText, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasProductSearchQuery, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ProductSearchResultsCount}" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text=" results for " FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{Binding ProductSearchTrimmedQueryText}" FontSize="12" FontWeight="Medium" Foreground="#64748B" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="↑↓ Navigate • Enter Select (Auto-FEFO Batch) • Drag Header to Move • Drag Edges to Resize"
                                                   FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 8-Way Resize Handles (n, s, e, w, ne, nw, se, sw) -->
                        <Border Tag="n" VerticalAlignment="Top" Height="6" Margin="12,0,12,0" Background="Transparent" Cursor="SizeNS" Panel.ZIndex="30"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="s" VerticalAlignment="Bottom" Height="6" Margin="12,0,12,0" Background="Transparent" Cursor="SizeNS" Panel.ZIndex="30"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="e" HorizontalAlignment="Right" Width="6" Margin="0,12,0,12" Background="Transparent" Cursor="SizeWE" Panel.ZIndex="30"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="w" HorizontalAlignment="Left" Width="6" Margin="0,12,0,12" Background="Transparent" Cursor="SizeWE" Panel.ZIndex="30"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="ne" HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="31"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="nw" HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="31"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="sw" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="31"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture" />
                        <Border Tag="se" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="31"
                                ToolTip="Drag to resize window"
                                MouseLeftButtonDown="ProductSearchResizeHandle_OnMouseLeftButtonDown"
                                MouseMove="ProductSearchResizeHandle_OnMouseMove"
                                MouseLeftButtonUp="ProductSearchResizeHandle_OnMouseLeftButtonUp"
                                LostMouseCapture="ProductSearchResizeHandle_OnLostMouseCapture">
                            <Path Data="M10,14 L14,10 M6,14 L14,6" Stroke="#94A3B8" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" IsHitTestVisible="False" />
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 3: QUICK ADD PRODUCT MODAL                                    -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsQuickAddProductModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000">
            <Border Width="540" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="18,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Quick Add Product" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,10" />
                    <TextBlock Text="PRODUCT NAME *" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="QuickAddProductNameTextBox" Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,8"
                             Text="{Binding QuickAddProductName, UpdateSourceTrigger=PropertyChanged}" />

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="FORMULATION / SALT" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource HeaderInputBoxStyle}" Text="{Binding QuickAddProductFormulation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PACK SIZE *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource HeaderInputBoxStyle}" Text="{Binding QuickAddProductPackSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="PACK PURCHASE RS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource HeaderInputBoxStyle}" Text="{Binding QuickAddProductPackPurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="PACK RETAIL RS *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource HeaderInputBoxStyle}" Text="{Binding QuickAddProductPackSalePrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PACK WHOLESALE RS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource HeaderInputBoxStyle}" Text="{Binding QuickAddProductWholesalePackPrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding CloseQuickAddProductModalCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource PrimaryBtnStyle}"
                                Command="{Binding SaveQuickAddProductCommand}">
                            <TextBlock Text="Save &amp; Select Product" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 4: BATCH SEARCH MODAL (FEFO Batches + Unbatched Option)       -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsBatchSearchModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000"
              MouseLeftButtonDown="BatchSearchOverlay_OnMouseLeftButtonDown">
            <Border Width="640" MaxHeight="520" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding BatchModalProductTitle}" FontSize="13.5" FontWeight="ExtraBold" Foreground="#0F172A" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource OutlineBtnStyle}" Padding="8,2"
                                        Command="{Binding CloseBatchSearchModalCommand}">
                                    <TextBlock Text="Close (Esc)" FontSize="10.5" />
                                </Button>
                            </Grid>
                            <TextBox x:Name="BatchModalSearchTextBox"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding BatchModalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="BatchModalSearchTextBox_OnPreviewKeyDown" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="BatchModalResultsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding FilteredModalBatches}"
                             SelectedItem="{Binding HighlightedModalBatch, Mode=TwoWay}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             PreviewMouseLeftButtonUp="BatchModalResultsListBox_OnPreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.0*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding BatchNumber}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedExpiry}" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding AvailPackUnitBadge}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding UnitSalePrice, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Border Grid.Column="4" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#15803D" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,7">
                        <TextBlock Text="FEFO Sorted (Earliest Expiry First) • ↑↓ Navigate • Enter Select • Esc Close" FontSize="10.5" Foreground="#64748B" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 5: SUBSTITUTE PRODUCTS MODAL (Retail Generic/Salt Lookup)     -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsSubstituteModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000">
            <Border Width="680" MaxHeight="520" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="16,14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Generic / Salt Substitute Products" FontSize="14.5" FontWeight="ExtraBold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding SubstituteModalSourceProductText}" FontSize="11.5" Foreground="#2563EB" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource OutlineBtnStyle}"
                                Command="{Binding CloseSubstituteModalCommand}">
                            <TextBlock Text="Close (Esc)" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SubstituteProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="1.0*" />
                                                <ColumnDefinition Width="1.0*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding BrandName}" FontSize="10.5" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StockBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding UnitSalePrice, StringFormat='Rs. {0:N2}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Style="{StaticResource PrimaryBtnStyle}" Padding="10,4"
                                                    Command="{Binding DataContext.SelectSubstituteProductCommand, ElementName=SaleInvoicesRoot}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Use Substitute" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 6: HELD DRAFTS MODAL (Alt+D)                                  -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDraftsModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000">
            <Border Width="740" MaxHeight="540" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="18,14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Held Sale Invoice Drafts (Ctrl+H / Ctrl+D)" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource DangerBtnStyle}" Margin="0,0,8,0"
                                    Command="{Binding ClearAllDraftsCommandCommand}">
                                <TextBlock Text="Clear All" />
                            </Button>
                            <Button Style="{StaticResource OutlineBtnStyle}"
                                    Command="{Binding CloseDraftsModalCommand}">
                                <TextBlock Text="Close (Esc)" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,4,0"
                                    Command="{Binding SetDraftsModalFilterCommand}" CommandParameter="all">
                                <TextBlock Text="All" />
                            </Button>
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,4,0"
                                    Command="{Binding SetDraftsModalFilterCommand}" CommandParameter="retail">
                                <TextBlock Text="Retail" />
                            </Button>
                            <Button Style="{StaticResource OutlineBtnStyle}"
                                    Command="{Binding SetDraftsModalFilterCommand}" CommandParameter="wholesale">
                                <TextBlock Text="Wholesale" />
                            </Button>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource HeaderInputBoxStyle}"
                                 Text="{Binding DraftsModalSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldDrafts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.0*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DraftNumber}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" />
                                                <TextBlock Text="{Binding FormattedUpdatedAt}" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding ItemsPreview}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='Rs. {0:N0}'}" FontFamily="Consolas" FontSize="12.5" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryBtnStyle}" Padding="10,4" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.RestoreDraftCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Restore" />
                                                </Button>
                                                <Button Style="{StaticResource DangerBtnStyle}" Padding="8,4"
                                                        Command="{Binding DataContext.DeleteDraftItemCommand, ElementName=SaleInvoicesRoot}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="✕" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 7: SUPERVISOR OVERRIDE MODALS (Discount / Credit / Expired)   -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDiscountOverrideModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="460" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Supervisor Discount Override Required" FontSize="14.5" FontWeight="ExtraBold" Foreground="#B45309" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding DiscountViolationDetails}" FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="SUPERVISOR USERNAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,8" Text="{Binding SupervisorUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="SUPERVISOR PASSWORD / PIN" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,8" Text="{Binding SupervisorPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="OVERRIDE REASON" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,12" Text="{Binding SupervisorOverrideReason, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseOverrideModalsCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource PrimaryBtnStyle}" Command="{Binding ConfirmSupervisorOverrideCommand}" CommandParameter="discount">
                            <TextBlock Text="Authorize &amp; Save" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsCreditOverrideModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="460" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Customer Credit Limit Override" FontSize="14.5" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding CreditViolationDetails}" FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="SUPERVISOR USERNAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,8" Text="{Binding SupervisorUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="SUPERVISOR PASSWORD / PIN" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,12" Text="{Binding SupervisorPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseOverrideModalsCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource PrimaryBtnStyle}" Command="{Binding ConfirmSupervisorOverrideCommand}" CommandParameter="credit">
                            <TextBlock Text="Authorize Credit &amp; Save" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsExpiredOverrideModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="460" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Expired Batch Override Required" FontSize="14.5" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ExpiredBatchDetails}" FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="SUPERVISOR USERNAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,8" Text="{Binding SupervisorUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="SUPERVISOR PASSWORD / PIN" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,12" Text="{Binding SupervisorPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseOverrideModalsCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource PrimaryBtnStyle}" Command="{Binding ConfirmSupervisorOverrideCommand}" CommandParameter="expired">
                            <TextBlock Text="Authorize Expired Stock" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 8: PRE-SHIFT CASH DRAWER PROMPT, REVERSE & DELETE MODALS      -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsPreShiftDrawerModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="420" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Open Cash Drawer Shift" FontSize="14.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,6" />
                    <TextBlock Text="No active cash drawer session is open. Enter opening float to start shift or skip to continue." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="OPENING FLOAT AMOUNT (RS)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,12" Text="{Binding OpeningFloatAmountText, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding SkipPreShiftDrawerPromptCommand}">
                            <TextBlock Text="Skip for Now" />
                        </Button>
                        <Button Style="{StaticResource EmeraldBtnStyle}" Command="{Binding ConfirmOpenPreShiftDrawerCommand}">
                            <TextBlock Text="Open Cash Drawer" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsReverseModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="440" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ReversingInvoiceNumber, StringFormat='Reverse / Void Invoice {0}'}" FontSize="14.5" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,0,0,6" />
                    <TextBlock Text="Reversing restores all batch &amp; product stock and reverses customer ledger &amp; account entries." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="REVERSAL REASON *" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,12" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0" Command="{Binding CloseReverseModalCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource DangerBtnStyle}" Command="{Binding ConfirmReverseInvoiceCommand}">
                            <TextBlock Text="Confirm Reversal" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 9: SHOW PAGE SEARCH INVOICE MODAL (SaleInvoiceSearch.jsx)     -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsShowInvoiceSearchModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000"
              MouseLeftButtonDown="ShowInvoiceSearchOverlay_OnMouseLeftButtonDown">
            <Border Width="680" MaxHeight="560" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.25" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="ShowInvoiceSearchTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource HeaderInputBoxStyle}"
                                     Text="{Binding ShowInvoiceSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ShowInvoiceSearchTextBox_OnPreviewKeyDown" />
                            <Button Grid.Column="2" Style="{StaticResource RowIconBtnStyle}" Margin="6,0,4,0"
                                    Visibility="{Binding HasShowInvoiceSearchQuery, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding ClearShowInvoiceSearchQueryCommand}">
                                <TextBlock Text="✕" FontSize="11" Foreground="#64748B" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource OutlineBtnStyle}" Padding="8,3"
                                    Command="{Binding CloseShowInvoiceSearchModalCommand}">
                                <TextBlock Text="Esc" FontFamily="Consolas" FontSize="10.5" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Results List -->
                    <ListBox x:Name="ShowInvoiceSearchResultsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding ShowInvoiceSearchResults}"
                             SelectedItem="{Binding HighlightedShowSearchInvoice, Mode=TwoWay}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="ShowInvoiceSearchResultsListBox_OnPreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#DBEAFE" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PostedNumber}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" />
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                        Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Credit" FontSize="9.5" FontWeight="Bold" Foreground="#B45309" />
                                                </Border>
                                                <Border Background="#F3E8FF" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                        Visibility="{Binding IsWholesale, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="WS" FontSize="9.5" FontWeight="Bold" Foreground="#6D28D9" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="#64748B">
                                                <Run Text="{Binding CustomerName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" • " />
                                                <Run Text="{Binding FormattedDisplayDate, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Total, StringFormat='Rs. {0:N0}'}" FontFamily="Consolas" FontSize="12.5" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding RemainingAmount, StringFormat='Due: Rs. {0:N0}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"
                                                       Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,7">
                        <TextBlock Text="↑↓ Navigate • Enter Open Invoice • Esc Close" FontSize="10.5" Foreground="#64748B" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 10: RECEIVE PAYMENT MODAL (RecordPaymentModal.jsx)            -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsRecordPaymentModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="440" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentDetail.PostedNumber, StringFormat='Receive Payment — {0}'}" FontSize="14.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,4" />
                    <TextBlock FontSize="11.5" Foreground="#64748B" Margin="0,0,0,10">
                        <Run Text="Customer: " /><Run Text="{Binding CurrentDetail.CustomerName, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                        <Run Text=" • Due: Rs. " /><Run Text="{Binding CurrentDetail.RemainThisBill, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="Bold" Foreground="#D97706" />
                    </TextBlock>

                    <TextBlock Text="AMOUNT RECEIVED (RS) *" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,8"
                             Text="{Binding RecordPaymentAmountText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="DEPOSIT ACCOUNT *" Style="{StaticResource FieldLabelStyle}" />
                    <local:SearchableSelect Margin="0,0,0,8"
                                            ItemsSource="{Binding PaymentAccounts}"
                                            SelectedItem="{Binding RecordPaymentAccount, Mode=TwoWay}"
                                            DisplayMemberPath="DisplayLabel"
                                            Placeholder="Select Payment Account" />

                    <TextBlock Text="REFERENCE / NOTE" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource HeaderInputBoxStyle}" Margin="0,0,0,12"
                             Text="{Binding RecordPaymentReference, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                Command="{Binding CloseRecordPaymentModalCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource EmeraldBtnStyle}"
                                Command="{Binding ConfirmRecordPaymentCommand}">
                            <TextBlock Text="Record Payment" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 11: DOCUMENT AUDIT HISTORY MODAL (DocumentHistoryModal.jsx)   -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="580" MaxHeight="520" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="18,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding CurrentDetail.PostedNumber, StringFormat='Audit History — {0}'}" FontSize="14.5" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource OutlineBtnStyle}"
                                Command="{Binding CloseHistoryModalCommand}">
                            <TextBlock Text="Close (Esc)" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CurrentDetail.AuditHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,8">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding ActionBadge}" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" />
                                                <TextBlock Text="{Binding FormattedTimestamp}" FontFamily="Consolas" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding UserName, StringFormat='By: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ChangesSummary}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 12: 3-STEP DELETE SALE INVOICE MODAL (Exact Show.jsx)         -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVis}}" Background="#73000000">
            <Border Width="450" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="20,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Step 1: Confirm Delete -->
                    <StackPanel Visibility="{Binding IsDeleteStep1, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Delete sale invoice?" FontSize="15.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,8" />
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock FontSize="11.5" Foreground="#475569" Margin="0,1">
                                    <Run Text="Posted #: " FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text="{Binding DeletingInvoiceNumber, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                                <TextBlock FontSize="11.5" Foreground="#475569" Margin="0,1">
                                    <Run Text="Total: " FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text="{Binding DeletingInvoiceTotal, StringFormat='Rs. {0:N0}', Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                                <TextBlock FontSize="11.5" Foreground="#475569" Margin="0,1">
                                    <Run Text="Received: " FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text="{Binding DeletingInvoiceReceived, StringFormat='Rs. {0:N0}', Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                                <TextBlock FontSize="11.5" Foreground="#475569" Margin="0,1">
                                    <Run Text="Remaining: " FontWeight="Bold" Foreground="#0F172A" />
                                    <Run Text="{Binding DeletingInvoiceRemaining, StringFormat='Rs. {0:N0}', Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="This action cannot be undone." FontSize="12" Foreground="#64748B" Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                    Command="{Binding CloseDeleteModalCommand}">
                                <TextBlock Text="Cancel" />
                            </Button>
                            <Button Style="{StaticResource DangerBtnStyle}"
                                    Command="{Binding ProceedDeleteStep1Command}">
                                <TextBlock Text="Yes, continue" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 2: Choose Store Credit or Refund (for Credit Invoices with Received Amount) -->
                    <StackPanel Visibility="{Binding IsDeleteStep2, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Store Credit or Refund?" FontSize="15.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="Choose how to handle this invoice:" FontSize="12" Foreground="#64748B" Margin="0,0,0,10" />

                        <Button Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,8"
                                Command="{Binding SetDeleteRefundModeCommand}" CommandParameter="credit">
                            <Border CornerRadius="8" Padding="12,8" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleteModeCredit}" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="● Store Credit (recommended)" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="Create a negative entry in customer's ledger (credit them)." FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,14"
                                Command="{Binding SetDeleteRefundModeCommand}" CommandParameter="refund">
                            <Border CornerRadius="8" Padding="12,8" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleteModeRefund}" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="● Refund" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="Delete all ledger entries (no credit recorded)." FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <Grid>
                            <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Left"
                                    Command="{Binding BackDeleteStepCommand}">
                                <TextBlock Text="← Back" />
                            </Button>
                            <Button Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Right"
                                    Command="{Binding ProceedDeleteStep2Command}">
                                <TextBlock Text="Continue" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Step 3: Password Confirm -->
                    <StackPanel Visibility="{Binding IsDeleteStep3, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Confirm with password" FontSize="15.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="For security, please re-enter your password to delete this sale invoice." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBox x:Name="DeleteInvoicePasswordTextBox"
                                 Style="{StaticResource HeaderInputBoxStyle}"
                                 Margin="0,0,0,14"
                                 Text="{Binding DeletePassword, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="DeleteInvoicePasswordTextBox_OnPreviewKeyDown" />
                        <Grid>
                            <Button Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Left"
                                    Command="{Binding BackDeleteStepCommand}">
                                <TextBlock Text="← Back" />
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource OutlineBtnStyle}" Margin="0,0,8,0"
                                        Command="{Binding CloseDeleteModalCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>
                                <Button Style="{StaticResource DangerBtnStyle}"
                                        Command="{Binding ConfirmDeleteInvoiceCommand}">
                                    <TextBlock Text="Confirm &amp; Delete" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
