                                                    <TextBlock Text="{Binding CurrentDetail.TotalReceive, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
