                                <TextBlock Text="WHOLESALE SUMMARY &amp; ADJUSTMENTS" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="MARGIN %:" FontSize="10.5" FontWeight="ExtraBold" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="5" Padding="7,1">
                                        <TextBlock Text="{Binding CurrentDetail.OverallMarginPct, StringFormat='{}{0:N2}%'}" FontFamily="Consolas" FontSize="11.5" FontWeight="ExtraBold" Foreground="#DC2626" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="8,4">
                                            <TextBlock Text="Disc %" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="8,4">
                                            <TextBlock Text="{Binding CurrentDetail.DiscountPercentage, StringFormat='{}{0:0.##}%'}" FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Right" />
                                        </Border>
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="8,4">
                                            <TextBlock Text="Disc Amt" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,4">
                                            <TextBlock Text="{Binding CurrentDetail.DiscountAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,4">
                                            <TextBlock Text="Tax %" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,4">
                                            <TextBlock Text="{Binding CurrentDetail.TaxPercentage, StringFormat='{}{0:0.##}%'}" FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Right" />
                                        </Border>
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,4">
                                            <TextBlock Text="Tax Amt" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                        </Border>
                                        <Border Grid.Column="3" Padding="8,4">
                                            <TextBlock Text="{Binding CurrentDetail.TaxAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Col 1: Gross Amount & Net Total Banner -->
                        <Border Grid.Column="1" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="GROSS AMOUNT" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDetail.GrossAmount, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" />
                                </Grid>
                                <Border BorderBrush="#C4B5FD" BorderThickness="0,1,0,0" Margin="0,3" />
                                <Grid>
                                    <TextBlock Text="Net Total" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDetail.Total, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="18" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Col 2: Payment & Printer Info Table -->
                        <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="8,5">
                                        <TextBlock Text="Method" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="8,5">
                                        <TextBlock Text="{Binding CurrentDetail.PaymentMethodUpper}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Border>
                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="8,5">
