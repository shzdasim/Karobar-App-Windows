                                        Command="{Binding EditCurrentDetailInvoiceCommand}" ToolTip="Ctrl+E">
                                    <TextBlock Text="Edit" FontSize="11" />
                                </Button>
                            </UniformGrid>
                            <UniformGrid Columns="3">
                                <Button Style="{StaticResource PrimaryBtnStyle}" Height="28" Margin="0,0,3,0"
                                        Command="{Binding CreateNewFromShowModeCommand}" ToolTip="Ctrl+N">
                                    <TextBlock Text="New" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource DangerBtnStyle}" Height="28" Margin="3,0,3,0"
                                        Command="{Binding OpenDeleteModalCommand}" ToolTip="Ctrl+D">
                                    <TextBlock Text="Delete" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource OutlineBtnStyle}" Height="28" Margin="3,0,0,0"
                                        Command="{Binding NavigateBackToListCommand}" ToolTip="Ctrl+B">
                                    <TextBlock Text="Back" FontSize="11" />
