                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- =================================================================== -->
        <!-- MODAL 1: CUSTOMER SEARCH MODAL (CustomerSearch.jsx Design)          -->
        <!-- =================================================================== -->
        <Grid Visibility="{Binding IsCustomerSearchModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#73000000"
              MouseLeftButtonDown="CustomerSearchOverlay_OnMouseLeftButtonDown">
            <Border Width="680" MaxHeight="560" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
