                                    <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,5">
                                        <TextBlock Text="{Binding PrintPaperSizeUpper}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,5">
                                        <TextBlock Text="Received" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,5">
                                        <TextBlock Text="{Binding CurrentDetail.TotalReceive, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Border>
                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="8,5">
                                        <TextBlock Text="Remaining" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,5">
                                        <TextBlock Text="{Binding CurrentDetail.RemainThisBill, StringFormat='{}{0:N0}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="ExtraBold" Foreground="#D97706" HorizontalAlignment="Right" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Col 3: Quick Action Buttons -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
