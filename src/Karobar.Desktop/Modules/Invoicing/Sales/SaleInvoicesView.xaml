                                                <Border Grid.Column="1" Padding="10,6">
                                                    <TextBlock Text="{Binding PrintPaperSizeUpper}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
