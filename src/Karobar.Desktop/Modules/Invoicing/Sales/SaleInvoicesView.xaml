                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Bottom: 4-Column Wholesale Summary Footer (Exact Show.jsx lines 1418-1748) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4.0*" />
                            <ColumnDefinition Width="3.0*" />
                            <ColumnDefinition Width="3.0*" />
                            <ColumnDefinition Width="2.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Wholesale Summary & Adjustments + Margin % Badge -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
