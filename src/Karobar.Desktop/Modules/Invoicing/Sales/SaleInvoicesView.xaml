                                                <TextBlock Grid.Column="3" Text="{Binding BatchDisplay}" FontFamily="Consolas" FontSize="10.5" Foreground="#334155" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedExpiry}" FontFamily="Consolas" FontSize="10.5" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding AvailPackUnitBadge}" FontFamily="Consolas" FontSize="10" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
