                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Style="{StaticResource EmeraldBtnStyle}" Height="30" Margin="0,0,4,0"
                                            Command="{Binding PrintCurrentDetailInvoiceCommand}" ToolTip="Ctrl+P">
                                        <TextBlock Text="Print" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineBtnStyle}" Height="30" Margin="4,0,0,0"
                                            IsEnabled="{Binding CurrentDetail.IsActive}"
                                            Command="{Binding EditCurrentDetailInvoiceCommand}" ToolTip="Ctrl+E">
                                        <TextBlock Text="Edit" FontSize="11" />
                                    </Button>
                                </UniformGrid>
                                <UniformGrid Columns="3">
                                    <Button Style="{StaticResource PrimaryBtnStyle}" Height="30" Margin="0,0,3,0"
