                                                <TextBlock Grid.Column="7" Text="{Binding Quantity}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="8" Text="{Binding ItemDiscountPercentage, StringFormat='{}{0:0.##}'}" FontFamily="Consolas" FontSize="10.5" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="9" Text="{Binding PackBonus, StringFormat='{}{0:0.##}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="10" Text="{Binding DisplayUnitBonus}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="11" Text="{Binding TotalUnitsDisplay}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="12" Text="{Binding PackPrice, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="13" Text="{Binding Price, StringFormat='{}{0:N2}'}" FontFamily="Consolas" FontSize="10.5" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
