                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="22.5*" />
                                    <ColumnDefinition Width="4.0*" />
                                    <ColumnDefinition Width="7.0*" />
                                    <ColumnDefinition Width="6.0*" />
                                    <ColumnDefinition Width="6.5*" />
                                    <ColumnDefinition Width="5.0*" />
                                    <ColumnDefinition Width="5.0*" />
                                    <ColumnDefinition Width="4.5*" />
                                    <ColumnDefinition Width="4.5*" />
                                    <ColumnDefinition Width="4.5*" />
                                    <ColumnDefinition Width="5.0*" />
                                    <ColumnDefinition Width="6.5*" />
                                    <ColumnDefinition Width="6.0*" />
                                    <ColumnDefinition Width="5.0*" />
                                    <ColumnDefinition Width="5.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="1" Text="Product" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="PSize" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="3" Text="Batch" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" Text="Expiry" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="5" Text="Avail(P/U)" Style="{StaticResource ColHeaderTextStyle}" />
                                <TextBlock Grid.Column="6" Text="Pack.Q" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="Unit.Q" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="Disc%" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="9" Text="Pack.B" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="10" Text="Unit.B" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="11" Text="Tot.U" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="12" Text="Pack.P" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="13" Text="Unit.P" Style="{StaticResource ColHeaderTextStyle}" HorizontalAlignment="Right" />
