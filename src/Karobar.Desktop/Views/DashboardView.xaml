<UserControl x:Class="Karobar.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Preset Filter Button Style -->
        <Style x:Key="PresetChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                    <Setter Property="Foreground" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="4,2,10,28">
        <StackPanel>

            <!-- ============================================================ -->
            <!-- 1. HERO BAND (Business Overview)                             -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="20,16"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Icon + Title + Live Badge + Date Range -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46"
                                CornerRadius="13"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                Margin="0,0,14,0">
                            <TextBlock Text="📊"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Business overview"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#0F172A" />
                                <Border Background="#ECFDF5"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="99"
                                        Padding="8,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" />
                                        <TextBlock Text="Live"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#059669" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding DateRangeLabel}"
                                           FontSize="12"
                                           Foreground="#64748B" />
                                <TextBlock Text=" · "
                                           FontSize="12"
                                           Foreground="#94A3B8" />
                                <TextBlock Text="{Binding LastUpdatedLabel}"
                                           FontSize="12"
                                           Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: 3 Headline Stats -->
                    <Border Grid.Column="1"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1,0,1,0"
                            Padding="24,2"
                            Margin="20,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="NET SALES"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#64748B" />
                                <TextBlock Text="{Binding HeroNetSales}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="DAILY AVG"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#64748B" />
                                <TextBlock Text="{Binding HeroDailyAvg}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="RETURN RATE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#64748B" />
                                <TextBlock Text="{Binding HeroReturnRate}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: Refresh Button -->
                    <Button Grid.Column="2"
                            Command="{Binding RefreshDashboardCommand}"
                            Style="{StaticResource PresetChipButtonStyle}"
                            VerticalAlignment="Center"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻ Refresh"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center" />
                            <Border Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="8,0,0,0">
                                <TextBlock Text="Alt+R"
                                           FontSize="10"
                                           Foreground="#64748B" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 2. DATE RANGE & QUICK PRESET FILTER BAR                      -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- From / To Date Inputs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="FROM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Border Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding FromDateText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             Foreground="#0F172A"
                                             Width="86" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TO"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Border Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding ToDateText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             Foreground="#0F172A"
                                             Width="86" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Preset Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Today"
                                Command="{Binding SelectPresetCommand}"
                                CommandParameter="today">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresetToday}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="This Month"
                                Command="{Binding SelectPresetCommand}"
                                CommandParameter="this_month">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresetThisMonth}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="7 Days"
                                Command="{Binding SelectPresetCommand}"
                                CommandParameter="7_days">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreset7Days}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="30 Days"
                                Command="{Binding SelectPresetCommand}"
                                CommandParameter="30_days">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreset30Days}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="This Year"
                                Command="{Binding SelectPresetCommand}"
                                CommandParameter="this_year">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresetThisYear}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 3. KPI MONEY CARDS (Row 1: Sales & Purchases)                -->
            <!-- ============================================================ -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <!-- Card 1: Sales -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="SALES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B" />
                                    <Border Background="#ECFDF5"
                                            CornerRadius="99"
                                            Padding="7,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SalesTrend}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#059669" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding SalesAmount}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Canvas Width="110" Height="36" Margin="0,2,12,0" ClipToBounds="True">
                                    <Path Data="{Binding SalesSparklineArea}" Fill="#223B82F6" />
                                    <Path Data="{Binding SalesSparklineLine}" Stroke="#3B82F6" StrokeThickness="2" />
                                </Canvas>
                                <Border Width="38" Height="38"
                                        CornerRadius="10"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1">
                                    <TextBlock Text="💵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Debit / Credit Split -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,12,0,10">
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="DEBIT (CASH)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SalesDebit}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CREDIT (RECEIVABLE)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SalesCredit}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="{Binding SalesFooter}"
                                   FontSize="11"
                                   Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Purchases -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PURCHASES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B" />
                                    <Border Background="#ECFDF5"
                                            CornerRadius="99"
                                            Padding="7,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PurchasesTrend}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#059669" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding PurchasesAmount}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Canvas Width="110" Height="36" Margin="0,2,12,0" ClipToBounds="True">
                                    <Path Data="{Binding PurchasesSparklineArea}" Fill="#228B5CF6" />
                                    <Path Data="{Binding PurchasesSparklineLine}" Stroke="#8B5CF6" StrokeThickness="2" />
                                </Canvas>
                                <Border Width="38" Height="38"
                                        CornerRadius="10"
                                        Background="#F5F3FF"
                                        BorderBrush="#DDD6FE"
                                        BorderThickness="1">
                                    <TextBlock Text="🛒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Debit / Credit Split -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,12,0,10">
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="DEBIT (PAID)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding PurchasesDebit}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CREDIT (PAYABLE)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding PurchasesCredit}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="{Binding PurchasesFooter}"
                                   FontSize="11"
                                   Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================================ -->
            <!-- 3B. KPI MONEY CARDS (Row 2: Expected Orders, Net Sales, Ret) -->
            <!-- ============================================================ -->
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <!-- Card 3: Expected Orders -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EXPECTED ORDERS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#64748B" />
                                <TextBlock Text="{Binding ExpectedOrdersAmount}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="36" Height="36"
                                    CornerRadius="10"
                                    Background="#F5F3FF"
                                    BorderBrush="#DDD6FE"
                                    BorderThickness="1">
                                <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ExpectedOrdersFooter}"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Net Sales -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="6,0,6,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="NET SALES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B" />
                                    <Border Background="#ECFDF5"
                                            CornerRadius="99"
                                            Padding="7,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding NetSalesTrend}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#059669" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding NetSalesAmount}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Canvas Width="80" Height="32" Margin="0,2,8,0" ClipToBounds="True">
                                    <Path Data="{Binding NetSalesSparklineArea}" Fill="#2206B6D4" />
                                    <Path Data="{Binding NetSalesSparklineLine}" Stroke="#06B6D4" StrokeThickness="2" />
                                </Canvas>
                                <Border Width="36" Height="36"
                                        CornerRadius="10"
                                        Background="#ECFEFF"
                                        BorderBrush="#A5F3FC"
                                        BorderThickness="1">
                                    <TextBlock Text="📈" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding NetSalesFooter}"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 5: Sale Returns -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="SALE RETURNS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B" />
                                    <Border Background="#FFE4E6"
                                            CornerRadius="99"
                                            Padding="7,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SaleReturnsTrend}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#E11D48" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SaleReturnsAmount}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Canvas Width="80" Height="32" Margin="0,2,8,0" ClipToBounds="True">
                                    <Path Data="{Binding SaleReturnsSparklineArea}" Fill="#22F43F5E" />
                                    <Path Data="{Binding SaleReturnsSparklineLine}" Stroke="#F43F5E" StrokeThickness="2" />
                                </Canvas>
                                <Border Width="36" Height="36"
                                        CornerRadius="10"
                                        Background="#FFF1F2"
                                        BorderBrush="#FECDD3"
                                        BorderThickness="1">
                                    <TextBlock Text="↩" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SaleReturnsFooter}"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================================ -->
            <!-- 4. 12 APP MODULE STATS GRID (6x2 Clickable Tiles)            -->
            <!-- ============================================================ -->
            <ItemsControl ItemsSource="{Binding ModuleStats}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}"
                                Cursor="Hand"
                                Margin="4"
                                Background="Transparent"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TileBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,11">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36"
                                                    CornerRadius="10"
                                                    Background="{Binding IconBgHex}"
                                                    BorderBrush="{Binding BorderAccentHex}"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           Foreground="{Binding IconColorHex}"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#475569" />
                                                <TextBlock Text="{Binding Subtext}"
                                                           FontSize="10"
                                                           Foreground="#94A3B8" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="#93C5FD" />
                                            <Setter TargetName="TileBorder" Property="Background" Value="#F8FAFC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================================================ -->
            <!-- 5. REVENUE OVERVIEW (Dual-Series Area Chart)                 -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="20,18"
                    Margin="0,0,0,14">
                <StackPanel>
                    <!-- Header + Legend -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Revenue Overview"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />
                            <TextBlock Text="Daily sales &amp; purchase flow across the selected window"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="99" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,6,0" />
                                    <TextBlock Text="Sales" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F3FF" CornerRadius="99" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,6,0" />
                                    <TextBlock Text="Purchases" FontSize="11" FontWeight="SemiBold" Foreground="#5B21B6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Area Chart Canvas with Y-Axis + Grid Lines -->
                    <Grid Height="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Y-Axis Labels -->
                        <Grid Grid.Column="0" Margin="0,4,8,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding YAxisTopLabel}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="1" Text="{Binding YAxisMidHighLabel}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="2" Text="{Binding YAxisMidLowLabel}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="3" Text="{Binding YAxisBotLabel}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>

                        <!-- Plot Area + X-Axis -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <!-- Grid Lines + Smooth Vector Curves -->
                            <Grid Grid.Row="0">
                                <UniformGrid Rows="4">
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" />
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" />
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" />
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" />
                                </UniformGrid>

                                <Viewbox Stretch="Fill">
                                    <Canvas Width="760" Height="210" ClipToBounds="True">
                                        <!-- Purchases Area & Line -->
                                        <Path Data="{Binding RevenuePurchasesAreaPath}" Fill="#248B5CF6" />
                                        <Path Data="{Binding RevenuePurchasesLinePath}" Stroke="#8B5CF6" StrokeThickness="2.5" />

                                        <!-- Sales Area & Line -->
                                        <Path Data="{Binding RevenueSalesAreaPath}" Fill="#283B82F6" />
                                        <Path Data="{Binding RevenueSalesLinePath}" Stroke="#3B82F6" StrokeThickness="2.8" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <!-- X-Axis Date Labels -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ChartPoints}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateLabel}"
                                                   FontSize="10"
                                                   Foreground="#64748B"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- 6. THREE-COLUMN CHART TRIO                                   -->
            <!-- ============================================================ -->
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <!-- Trio Card 1: Sales vs Purchases Bar Chart -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Sales vs Purchases"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Side-by-side daily comparison"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,2,0,14" />

                        <Border Height="175"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1"
                                Padding="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding ChartPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="{Binding TooltipText}">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Center"
                                                        Height="148">
                                                <Border Width="8"
                                                        Height="{Binding SalesBarHeight}"
                                                        Background="#3B82F6"
                                                        CornerRadius="3,3,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,2,0" />
                                                <Border Width="8"
                                                        Height="{Binding PurchasesBarHeight}"
                                                        Background="#8B5CF6"
                                                        CornerRadius="3,3,0,0"
                                                        VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DateLabel}"
                                                       FontSize="9"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Trio Card 2: Returns Trend -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="6,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Returns Trend"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A" />
                                <TextBlock Text="Sale vs purchase returns"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#06B6D4" Margin="0,0,4,0" />
                                <TextBlock Text="Sale" FontSize="10" Foreground="#64748B" Margin="0,0,8,0" />
                                <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="0,0,4,0" />
                                <TextBlock Text="Purch" FontSize="10" Foreground="#64748B" />
                            </StackPanel>
                        </Grid>

                        <Grid Height="155">
                            <UniformGrid Rows="3">
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" />
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" />
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" />
                            </UniformGrid>
                            <Viewbox Stretch="Fill">
                                <Canvas Width="320" Height="150" ClipToBounds="True">
                                    <Path Data="{Binding ReturnsSaleAreaPath}" Fill="#2406B6D4" />
                                    <Path Data="{Binding ReturnsSaleLinePath}" Stroke="#06B6D4" StrokeThickness="2.5" />
                                    <Path Data="{Binding ReturnsPurchaseLinePath}"
                                          Stroke="#8B5CF6"
                                          StrokeThickness="2"
                                          StrokeDashArray="4 2" />
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ChartPoints}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontSize="9"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Trio Card 3: Top Brands Ranked List -->
                <Border Style="{StaticResource DashboardCardStyle}"
                        Padding="18,16"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Top Brands"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Ranked by sales revenue"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,2,0,12" />

                        <ItemsControl ItemsSource="{Binding TopBrands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="22" Height="22"
                                                CornerRadius="6"
                                                Background="{Binding RankBgHex}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Rank}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding RankFgHex}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AmountFormatted}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A" />
                                            </Grid>
                                            <Border Background="#F1F5F9"
                                                    Height="6"
                                                    CornerRadius="99"
                                                    Margin="0,5,0,0">
                                                <Border Background="{Binding BarColorHex}"
                                                        Width="{Binding BarWidth}"
                                                        Height="6"
                                                        CornerRadius="99"
                                                        HorizontalAlignment="Left" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================================ -->
            <!-- 7. TOP SELLING PRODUCTS (2/3) + PERIOD SNAPSHOT (1/3)        -->
            <!-- ============================================================ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left (2/3): Top Selling Products -->
                <Border Grid.Column="0"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="20,18"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Top Selling Products"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A" />
                                <TextBlock Text="Best-performing items by revenue &amp; quantity"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#EFF6FF"
                                    CornerRadius="99"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Top 6"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#2563EB" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="24" Height="24"
                                                    CornerRadius="7"
                                                    Background="{Binding RankBgHex}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding RankFgHex}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <TextBlock Text="{Binding Meta}"
                                                           FontSize="11"
                                                           Foreground="#64748B" />
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="#F1F5F9"
                                                    Height="7"
                                                    CornerRadius="99"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0">
                                                <Border Background="#3B82F6"
                                                        Width="{Binding BarWidth}"
                                                        Height="7"
                                                        CornerRadius="99"
                                                        HorizontalAlignment="Left" />
                                            </Border>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding AmountFormatted}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right (1/3): Period Snapshot -->
                <Border Grid.Column="1"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="20,18"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Period Snapshot"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Financial summary for active range"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,2,0,14" />

                        <ItemsControl ItemsSource="{Binding PeriodSnapshotLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Fill="{Binding DotColorHex}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       FontSize="12"
                                                       Foreground="#475569"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom 2 Summary Boxes -->
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,5,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1,845"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="INVOICES"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="5,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1,428"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="PRODUCTS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- 8. NEAR EXPIRY PRODUCTS TABLE                                -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="20,18">
                <StackPanel>
                    <!-- Header + Horizon Buttons -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38"
                                    CornerRadius="10"
                                    Background="#FFFBEB"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Near Expiry Products"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A" />
                                <TextBlock Text="Inventory approaching expiration date"
                                           FontSize="11"
                                           Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="1 mo"
                                    Command="{Binding SetExpiryHorizonCommand}"
                                    CommandParameter="30">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpiry30}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="3 mo"
                                    Command="{Binding SetExpiryHorizonCommand}"
                                    CommandParameter="90">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpiry90}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="6 mo"
                                    Command="{Binding SetExpiryHorizonCommand}"
                                    CommandParameter="180">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpiry180}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="1 yr"
                                    Command="{Binding SetExpiryHorizonCommand}"
                                    CommandParameter="365">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpiry365}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="1.5 yr"
                                    Command="{Binding SetExpiryHorizonCommand}"
                                    CommandParameter="540">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpiry540}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Supplier / Brand Filter Bar -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding SupplierFilterOptions}"
                                      SelectedItem="{Binding SelectedSupplierFilter}"
                                      Margin="0,0,10,0"
                                      Padding="8,5"
                                      FontSize="12" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BrandFilterOptions}"
                                      SelectedItem="{Binding SelectedBrandFilter}"
                                      Margin="0,0,10,0"
                                      Padding="8,5"
                                      FontSize="12" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Clear Filters"
                                        Command="{Binding ClearExpiryFiltersCommand}"
                                        Style="{StaticResource PresetChipButtonStyle}" />
                                <Button Content="↻ Refresh"
                                        Command="{Binding RefreshDashboardCommand}"
                                        Style="{StaticResource PresetChipButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Column Header -->
                    <Border Background="#F1F5F9"
                            CornerRadius="8,8,0,0"
                            Padding="14,10"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1,1,1,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PRODUCT" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="1" Text="SUPPLIER" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="2" Text="BRAND" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="3" Text="BATCH #" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="4" Text="EXPIRY" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="5" Text="DAYS LEFT" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="6" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <Border BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8">
                        <ItemsControl ItemsSource="{Binding FilteredNearExpiryProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10"
                                            Background="#FFFFFF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <TextBlock Text="{Binding ProductCode}"
                                                           FontSize="10"
                                                           Foreground="#94A3B8" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SupplierName}"
                                                       FontSize="12"
                                                       Foreground="#334155"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding BrandName}"
                                                       FontSize="12"
                                                       Foreground="#334155"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding BatchNumber}"
                                                       FontSize="12"
                                                       FontFamily="Consolas"
                                                       Foreground="#475569"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding ExpiryDate}"
                                                       FontSize="12"
                                                       Foreground="#334155"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="5"
                                                    Background="{Binding DaysBadgeBg}"
                                                    CornerRadius="99"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DaysLeftText}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding DaysBadgeFg}" />
                                            </Border>

                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding QuantityFormatted}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
